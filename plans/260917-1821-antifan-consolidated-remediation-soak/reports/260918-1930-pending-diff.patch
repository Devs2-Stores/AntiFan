+    (doc.getElementById('tabNavMcpDispatch') as HTMLElement).click();
+    await flush();
+    assert.equal(el.style.display, 'block', 'shown with the counts it qualifies');
+    (doc.getElementById('tabNavMcp') as HTMLElement).click();
