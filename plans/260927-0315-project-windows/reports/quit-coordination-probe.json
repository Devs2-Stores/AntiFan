{
  "probe": "quit-coordination",
  "passed": 22,
  "failed": 0,
  "checks": [
    {
      "name": "the coordinator is idle at boot: one browser shell, no reservation, phase open",
      "ok": true
    },
    {
      "name": "a real queued run exists in the shipping run service",
      "ok": true
    },
    {
      "name": "two browser shells exist: the hub with its tabs, the manager beside it",
      "ok": true
    },
    {
      "name": "a closed window leaves no chrome content reachable and reports no survivor",
      "ok": true
    },
    {
      "name": "a close attempt reserves its member pages before it awaits anything",
      "ok": true
    },
    {
      "name": "closing one window disposes only it, releases its reservation, and starts no quit",
      "ok": true
    },
    {
      "name": "a page that vetoes its unload retains the shell, with an honest partial report",
      "ok": true
    },
    {
      "name": "a tab arriving during the close survives and the shell is retained",
      "ok": true
    },
    {
      "name": "a Quit while a run is queued is refused, coalesced, and tears nothing down",
      "ok": true
    },
    {
      "name": "shared services are still usable after the refusal",
      "ok": true
    },
    {
      "name": "the terminal run state reopens the gate instead of locking it out",
      "ok": true
    },
    {
      "name": "a binding attempted during unload is refused; a page cannot be bound and then destroyed",
      "ok": true
    },
    {
      "name": "a late veto in a project shell while the Manager is open keeps services alive, releases admission and never commits",
      "ok": true
    },
    {
      "name": "the application is still usable after the late veto: a window opens and runs a page",
      "ok": true
    },
    {
      "name": "the vetoed quit closed the page-less manager and retained the vetoing shell",
      "ok": true
    },
    {
      "name": "unload settle (a): a page with no unload handler is destroyed by the close and reports no veto",
      "ok": true
    },
    {
      "name": "unload settle (b): a vetoing page reports will-prevent-unload, survives the close, and dies once disarmed",
      "ok": true
    },
    {
      "name": "unload settle (c): an already-destroyed content reports no event, so its outcome is read from state",
      "ok": true
    },
    {
      "name": "unload settle (d): a user-driven close with user activation reaches the app as the page veto",
      "ok": true
    },
    {
      "name": "the last browser shell closing runs the same application gate and exits orderly",
      "ok": true
    },
    {
      "name": "the ordered teardown ran once and nothing forced the exit",
      "ok": true
    },
    {
      "name": "every row of the probe executed and reported pass",
      "ok": true
    }
