<section class="product-template py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <nav class="text-sm text-neutral-500 mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2">
      <li><a href="/" class="hover:text-black">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/collections/all" class="hover:text-black">Products</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-neutral-900 font-medium truncate" aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
    <!-- Product Gallery -->
    <div class="product-gallery space-y-4">
      <div class="product-gallery__main aspect-square bg-neutral-100 rounded-xl overflow-hidden shadow-sm">
        <img id="ProductFeaturedImage" src="{{ product.featured_image | img_url: '1000x1000' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover object-center transition-all duration-300">
      </div>
      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbnails grid grid-cols-4 gap-3">
          {% for image in product.images %}
            <button type="button" class="product-thumbnail aspect-square rounded-lg overflow-hidden border-2 {% if forloop.first %}border-black{% else %}border-transparent hover:border-neutral-300{% endif %}" onclick="document.getElementById('ProductFeaturedImage').src = '{{ image | img_url: '1000x1000' }}'">
              <img src="{{ image | img_url: '200x200' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info & Form -->
    <div class="product-info flex flex-col">
      {% if product.vendor %}
        <p class="text-sm font-medium tracking-wider text-neutral-500 uppercase mb-2">{{ product.vendor }}</p>
      {% endif %}
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900 mb-4">{{ product.title }}</h1>
      <div class="product-price flex items-baseline space-x-3 mb-6">
        <span id="ProductPrice" class="text-2xl sm:text-3xl font-bold text-neutral-900">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span id="ComparePrice" class="text-lg text-neutral-500 line-through">{{ product.compare_at_price | money }}</span>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">Save {{ product.compare_at_price | minus: product.price | money }}</span>
        {% endif %}
      </div>

      <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form space-y-6" data-product-form>
        {% if product.has_only_default_variant == false %}
          <div class="product-variants space-y-4">
            {% for option in product.options_with_values %}
              <div>
                <label class="block text-sm font-medium text-neutral-700 mb-2">{{ option.name }}: <span class="font-semibold text-black" id="SelectedOption-{{ forloop.index }}">{{ option.selected_value }}</span></label>
                <div class="flex flex-wrap gap-2">
                  {% for value in option.values %}
                    <button type="button" class="variant-pill px-4 py-2 text-sm font-medium rounded-md border {% if option.selected_value == value %}border-black bg-black text-white{% else %}border-neutral-200 bg-white text-neutral-900 hover:border-neutral-400{% endif %}" data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductVariantId">

        <div class="product-actions flex flex-col sm:flex-row gap-4 pt-4">
          <div class="quantity-wrapper flex items-center border border-neutral-300 rounded-lg max-w-[120px]">
            <button type="button" class="p-3 text-neutral-600 hover:text-black" onclick="var q = document.getElementById('Quantity'); if(q.value > 1) q.value--;">-</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" class="w-full text-center border-none focus:ring-0 text-sm font-semibold">
            <button type="button" class="p-3 text-neutral-600 hover:text-black" onclick="var q = document.getElementById('Quantity'); q.value++;">+</button>
          </div>

          <button type="submit" name="add" class="flex-1 bg-black text-white px-8 py-4 rounded-lg font-semibold text-sm hover:bg-neutral-800 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        </div>
      </form>

      <div class="product-description prose prose-sm text-neutral-600 mt-8 border-t pt-8">
        {{ product.description }}
      </div>
    </div>
  </div>
</section>
