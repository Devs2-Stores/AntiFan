<div id="SearchModal" class="search-modal fixed inset-0 z-50 pointer-events-none transition-opacity duration-200 opacity-0 invisible" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <!-- Backdrop -->
  <div class="search-modal__backdrop fixed inset-0 bg-black/60 backdrop-blur-sm pointer-events-auto" data-search-close></div>

  <!-- Modal Container -->
  <div class="search-modal__content fixed top-0 inset-x-0 max-w-3xl mx-auto mt-12 sm:mt-20 p-4 pointer-events-auto">
    <div class="bg-white rounded-2xl shadow-2xl border border-neutral-200 overflow-hidden">
      <!-- Search Form -->
      <form action="/search" method="get" role="search" class="relative flex items-center border-b border-neutral-200 px-4 sm:px-6">
        <span class="text-neutral-400">
          {% render 'icon', name: 'search', class: 'w-6 h-6' %}
        </span>
        <input 
          type="search" 
          name="q" 
          id="SearchModalInput"
          placeholder="Search for crossbars, roof boxes, bike racks..." 
          class="w-full py-5 px-4 text-base sm:text-lg text-neutral-900 placeholder-neutral-400 border-0 focus:ring-0 focus:outline-none"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="button" class="p-2 text-neutral-400 hover:text-neutral-700 rounded-lg hover:bg-neutral-100 transition-colors" data-search-close aria-label="Close search">
          {% render 'icon', name: 'close', class: 'w-5 h-5' %}
        </button>
      </form>

      <!-- Search Suggestions & Live Results -->
      <div class="search-modal__results p-6 max-h-[60vh] overflow-y-auto" data-search-results>
        <div class="popular-searches">
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">Popular Searches</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/search?q=Crossbars" class="px-3 py-1.5 text-xs font-medium bg-neutral-100 text-neutral-700 rounded-full hover:bg-neutral-200 transition-colors">Crossbars</a>
            <a href="/search?q=Cargo+Box" class="px-3 py-1.5 text-xs font-medium bg-neutral-100 text-neutral-700 rounded-full hover:bg-neutral-200 transition-colors">Cargo Box</a>
            <a href="/search?q=Bike+Rack" class="px-3 py-1.5 text-xs font-medium bg-neutral-100 text-neutral-700 rounded-full hover:bg-neutral-200 transition-colors">Bike Rack</a>
            <a href="/search?q=Airfoil" class="px-3 py-1.5 text-xs font-medium bg-neutral-100 text-neutral-700 rounded-full hover:bg-neutral-200 transition-colors">Airfoil</a>
            <a href="/search?q=Titan" class="px-3 py-1.5 text-xs font-medium bg-neutral-100 text-neutral-700 rounded-full hover:bg-neutral-200 transition-colors">Titan</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
