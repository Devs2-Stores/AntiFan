{% if section.settings.show_announcement %}
  <div class="announcement-bar bg-neutral-900 text-white text-xs font-medium py-2.5 px-4 relative overflow-hidden transition-colors" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <button type="button" class="p-1 text-white/60 hover:text-white transition-colors" aria-label="Previous announcement" data-announcement-prev>
        {% render 'icon', name: 'chevron-left', class: 'w-4 h-4' %}
      </button>

      <div class="announcement-bar__content text-center flex-1 mx-4 truncate" data-announcement-content>
        <span class="inline-block tracking-wide">
          {{ section.settings.text | default: 'NEW! Introducing Our All-New Roof-Mounted Bicycle Rack' }}
        </span>
      </div>

      <button type="button" class="p-1 text-white/60 hover:text-white transition-colors" aria-label="Next announcement" data-announcement-next>
        {% render 'icon', name: 'chevron-right', class: 'w-4 h-4' %}
      </button>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "NEW! Introducing Our All-New Roof-Mounted Bicycle Rack"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
