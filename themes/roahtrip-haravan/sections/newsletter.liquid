<section class="newsletter-section py-16 sm:py-20 bg-neutral-100 border-t border-b border-neutral-200" data-newsletter>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
        {{ section.settings.title | default: 'Join The Roahtrip Community' }}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="mt-3 text-sm sm:text-base text-neutral-600">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" class="mt-8 sm:flex justify-center max-w-md mx-auto">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">

        <label for="NewsletterEmail" class="sr-only">Email address</label>
        <input 
          type="email" 
          name="contact[email]" 
          id="NewsletterEmail" 
          class="w-full px-5 py-3.5 placeholder-neutral-400 text-neutral-900 text-sm rounded-lg sm:rounded-r-none border border-neutral-300 focus:outline-none focus:ring-1 focus:ring-black focus:border-black" 
          placeholder="Enter your email" 
          required
        >
        <button 
          type="submit" 
          class="mt-3 sm:mt-0 w-full sm:w-auto flex-shrink-0 px-6 py-3.5 border border-transparent text-sm font-semibold rounded-lg sm:rounded-l-none text-white bg-black hover:bg-neutral-800 transition-colors cursor-pointer"
        >
          Subscribe
        </button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join The Roahtrip Community"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Subscribe to receive updates, access to exclusive deals, and more."
    }
  ]
}
{% endschema %}
