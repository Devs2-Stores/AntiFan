{%- comment -%}
Swatch as navigation, not client state: every swatch links to
`/products/{handle}?variant={id}`, and `product.selected_or_first_available_variant`
(used by templates/product.liquid) then renders that variant's price, image and
availability. No JavaScript and no stale price, because the server owns the selection.

The target variant for a value is chosen in three passes so picking one option cannot
silently reset another: (1) an available variant that also matches the variant being
rendered on every other option dimension, (2) any available variant with this value,
(3) any variant with this value. Only pass 3 can produce a sold-out link, and it is
labelled (Hết hàng) in the title attribute.
{%- endcomment -%}
{%- assign active_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
{%- assign found_option = false -%}
{%- assign is_color = false -%}
{%- assign option_index = 0 -%}

{%- for opt in product.options -%}
  {%- if opt == swatch -%}
    {%- assign found_option = true -%}
    {%- assign option_index = forloop.index0 -%}
    {%- assign downcased_opt = swatch | downcase -%}
    {%- if downcased_opt contains 'màu' or downcased_opt contains 'color' or downcased_opt contains 'colour' -%}
      {%- assign is_color = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if found_option -%}
  <div class="swatch-group" role="group" aria-label="{{ swatch | escape }}">
    <div class="swatch-title">{{ swatch | escape }}:</div>
    <div class="swatch-options">
      {%- assign seen = '|' -%}
      {%- for variant in product.variants -%}
        {%- assign value = variant.options[option_index] -%}
        {%- assign key = '|' | append: value | append: '|' -%}
        {%- unless seen contains key -%}
          {%- assign seen = seen | append: value | append: '|' -%}
          {%- assign target_id = '' -%}
          {%- assign target_available = false -%}

          {%- for pass in (1..3) -%}
            {%- for candidate in product.variants -%}
              {%- if target_id == '' and candidate.options[option_index] == value -%}
                {%- assign candidate_ok = false -%}
                {%- if pass == 1 -%}
                  {%- assign others_match = true -%}
                  {%- for opt in product.options -%}
                    {%- unless forloop.index0 == option_index -%}
                      {%- if candidate.options[forloop.index0] != active_variant.options[forloop.index0] -%}
                        {%- assign others_match = false -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  {%- if candidate.available and others_match -%}
                    {%- assign candidate_ok = true -%}
                  {%- endif -%}
                {%- elsif pass == 2 -%}
                  {%- if candidate.available -%}
                    {%- assign candidate_ok = true -%}
                  {%- endif -%}
                {%- else -%}
                  {%- assign candidate_ok = true -%}
                {%- endif -%}

                {%- if candidate_ok -%}
                  {%- assign target_id = candidate.id -%}
                  {%- assign target_available = candidate.available -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- assign is_active = false -%}
          {%- if active_variant.options[option_index] == value -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <a
            class="swatch-label{% if is_color %} color-swatch{% endif %}{% if is_active %} is-active{% endif %}{% unless target_available %} is-unavailable{% endunless %}"
            href="{{ product.url }}?variant={{ target_id }}"
            title="{{ value | escape }}{% unless target_available %} (Hết hàng){% endunless %}"
            {% if is_active %}aria-current="true"{% endif %}
          >{{ value | escape }}</a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
