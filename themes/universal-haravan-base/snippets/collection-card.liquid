<article class="product-card collection-card">
  <div class="product-card-image-wrap">
    <a href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
      {%- if collection.image -%}
        <img
          src="{{ collection.image | img_url: 'large' }}"
          alt="{{ collection.title | escape }}"
          class="product-card-image"
          loading="lazy"
          width="360"
          height="360"
        />
      {%- elsif collection.products.first and collection.products.first.images.size > 0 -%}
        <img
          src="{{ collection.products.first.images.first | img_url: 'large' }}"
          alt="{{ collection.title | escape }}"
          class="product-card-image"
          loading="lazy"
          width="360"
          height="360"
        />
      {%- else -%}
        <img
          src="{{ 'no-image.png' | asset_url }}"
          alt="{{ collection.title | escape }}"
          class="product-card-image"
          loading="lazy"
          width="360"
          height="360"
        />
      {%- endif -%}
    </a>
  </div>

  <div class="product-card-content" style="text-align: center;">
    <h3 class="product-card-title">
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
    </h3>
    <p style="margin: 0; color: var(--color-text-muted); font-size: 0.875rem;">
      {{ collection.all_products_count }} sản phẩm
    </p>
  </div>
</article>
