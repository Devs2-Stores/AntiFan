{%- if paginate.pages > 1 -%}
  <nav class="pagination-nav" role="navigation" aria-label="Pagination">
    <ul class="pagination-list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="pagination-link" aria-label="Trang trước">
            &laquo;
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li>
            <a href="{{ part.url }}" class="pagination-link" aria-label="Trang {{ part.title }}">
              {{ part.title }}
            </a>
          </li>
        {%- else -%}
          <li>
            {%- comment -%}
              `paginate.parts[].title` is not guaranteed to arrive as an integer, so coerce it
              before comparing (corpus idiom `| times: 1`); an ellipsis part coerces to 0 and
              therefore never claims to be the current page.
            {%- endcomment -%}
            {%- assign part_page = part.title | times: 1 -%}
            <span
              class="pagination-link{% if part_page == paginate.current_page %} is-current{% endif %}"
              {% if part_page == paginate.current_page %}aria-current="page"{% endif %}
            >
              {{ part.title }}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="pagination-link" aria-label="Trang tiếp theo">
            &raquo;
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
