<div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 450px; margin: 0 auto;">
    <header style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 2rem; font-weight: 700; color: var(--color-secondary); margin: 0 0 0.5rem;">
        Đặt lại mật khẩu
      </h1>
      <p style="color: var(--color-text-muted); margin: 0;">Nhập mật khẩu mới cho tài khoản của bạn</p>
    </header>

    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
        <div class="form-errors alert alert-danger" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-group">
        <label for="ResetPassword" class="form-label">Mật khẩu mới <span aria-hidden="true">*</span></label>
        <input
          type="password"
          id="ResetPassword"
          name="customer[password]"
          class="form-control"
          placeholder="••••••••"
          required
        />
      </div>

      <div class="form-group">
        <label for="ResetPasswordConfirmation" class="form-label">Xác nhận mật khẩu mới <span aria-hidden="true">*</span></label>
        <input
          type="password"
          id="ResetPasswordConfirmation"
          name="customer[password_confirmation]"
          class="form-control"
          placeholder="••••••••"
          required
        />
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.875rem; margin-top: 1.5rem;">
        Cập nhật mật khẩu
      </button>
    {% endform %}
  </div>
</div>
