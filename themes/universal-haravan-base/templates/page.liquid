<div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <article style="max-width: 800px; margin: 0 auto;">
    <header style="margin-bottom: 2rem; text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 700; color: var(--color-secondary); margin: 0;">
        {{ page.title | escape }}
      </h1>
    </header>

    <div class="page-content" style="line-height: 1.8; color: var(--color-text);">
      {{ page.content }}
    </div>
  </article>
</div>
