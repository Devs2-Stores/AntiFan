{%- if settings.home_hero_enable -%}
  <section class="hero-section" aria-label="Khuyến mãi nổi bật">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">{{ settings.home_hero_title | escape }}</h1>
        <p class="hero-subtitle">{{ settings.home_hero_subtitle | escape }}</p>
        {%- if settings.home_hero_btn_text != blank -%}
          <a href="{{ settings.home_hero_btn_url | default: '/collections/all' }}" class="btn btn-primary">
            {{ settings.home_hero_btn_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- assign feat_handle = settings.home_featured_collection | default: 'frontpage' -%}
{%- assign feat_collection = collections[feat_handle] -%}
{%- if feat_collection == nil or feat_collection.products.size == 0 -%}
  {%- assign feat_collection = collections['all'] -%}
{%- endif -%}

<section class="featured-products-section" style="padding: 3.5rem 0;" aria-labelledby="FeaturedProductsTitle">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
      <div>
        <h2 id="FeaturedProductsTitle" style="font-size: 1.875rem; margin: 0 0 0.5rem; color: var(--color-secondary);">
          {%- if feat_collection and feat_collection.title != blank -%}
            {{ feat_collection.title | escape }}
          {%- else -%}
            Sản phẩm nổi bật
          {%- endif -%}
        </h2>
        <p style="color: var(--color-text-muted); margin: 0;">Khám phá các sản phẩm được yêu thích nhất</p>
      </div>
      {%- if feat_collection.url != blank -%}
        <a href="{{ feat_collection.url }}" class="btn btn-outline" style="font-size: 0.875rem;">Xem tất cả &rarr;</a>
      {%- endif -%}
    </div>

    {%- if feat_collection and feat_collection.products.size > 0 -%}
      <div class="carousel-wrapper" data-carousel>
        <button type="button" class="carousel-nav-btn carousel-nav-prev" data-carousel-prev aria-label="Sản phẩm trước">&larr;</button>
        <div class="carousel-container" data-carousel-container>
          {%- assign feat_limit = settings.home_featured_limit | default: 8 | plus: 0 -%}
          {%- for product in feat_collection.products limit: feat_limit -%}
            <div class="carousel-slide">
              {% include 'product-loop' %}
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="carousel-nav-btn carousel-nav-next" data-carousel-next aria-label="Sản phẩm tiếp theo">&rarr;</button>
      </div>
    {%- else -%}
      <div class="collection-empty-state">
        <h3 class="empty-state-title">Danh mục đang cập nhật sản phẩm</h3>
        <p class="empty-state-description">Hiện tại chưa có sản phẩm nào trong danh mục này.</p>
        <a href="/collections/all" class="btn btn-primary">Xem tất cả sản phẩm</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if settings.home_blog_enable -%}
  {%- assign blog_handle = settings.home_blog_handle | default: 'news' -%}
  {%- assign home_blog = blogs[blog_handle] -%}
  <section class="home-blog-section" style="padding: 3.5rem 0; background-color: var(--color-bg-subtle);" aria-labelledby="HomeBlogTitle">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h2 id="HomeBlogTitle" style="font-size: 1.875rem; margin: 0 0 0.5rem; color: var(--color-secondary);">
          {%- if home_blog and home_blog.title != blank -%}
            {{ home_blog.title | escape }}
          {%- else -%}
            Tin tức & Sự kiện
          {%- endif -%}
        </h2>
        <p style="color: var(--color-text-muted); margin: 0;">Cập nhật xu hướng và kiến thức tiêu dùng</p>
      </div>

      {%- if home_blog and home_blog.articles_count > 0 -%}
        <div class="grid grid-cols-3">
          {%- assign blog_limit = settings.home_blog_limit | default: 3 | plus: 0 -%}
          {%- for article in home_blog.articles limit: blog_limit -%}
            <article class="product-card" style="padding: 0; overflow: hidden;">
              {%- if article.image -%}
                <div style="aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-border);">
                  <a href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                    <img
                      src="{{ article | img_url: 'large' }}"
                      alt="{{ article.title | escape }}"
                      style="width: 100%; height: 100%; object-fit: cover;"
                      loading="lazy"
                      width="400"
                      height="225"
                    />
                  </a>
                </div>
              {%- endif -%}
              <div style="padding: 1.25rem;">
                <div style="font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 0.5rem;">
                  {{ article.published_at | date: '%d/%m/%Y' }}
                </div>
                <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem; line-height: 1.4;">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                <p style="color: var(--color-text-muted); font-size: 0.875rem; line-height: 1.6; margin: 0 0 1rem;">
                  {{ article.content | strip_html | truncatewords: 20 | escape }}
                </p>
                <a href="{{ article.url }}" style="color: var(--color-primary); font-weight: 600; font-size: 0.875rem;">
                  Đọc tiếp &rarr;
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="collection-empty-state">
          <p class="empty-state-description">Chưa có bài viết nào được đăng tải.</p>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
