<link rel="preload" href="{{ 'post-hoplong.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'post-hoplong.css' | asset_url }}">

<main>
    <div class="blog w-100">
        <div class="breadcrumb w-100">
            <div class="container desktop container-fuild">
                <ul itemscope="" itemtype="https://schema.org/BreadcrumbList" class="flex-center-left breadcrumb-list">
                    <li itemprop="itemListElement" class="breadcrumb-list__item flex-inline-center" itemscope="" itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="/" style="display: inline;">
                            <span itemprop="name">Trang chủ</span>
                        </a>
                        <meta itemprop="position" content="1">
                        <span class="icon">/</span>
                    </li>
                    <li itemprop="itemListElement" class="breadcrumb-list__item flex-inline-center" itemscope="" itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{ blog.url }}" style="display: inline;">
                            <span itemprop="name">{{ blog.title }}</span>
                        </a>
                        <meta itemprop="position" content="2">
                    </li>
                </ul>
            </div>
        </div>

        <div class="container container-fuild">
            <div class="blog-content flex-left-between w-100">
                <div class="blog-content__left">
                    {% paginate blog.articles by 16 %}
                    {% if blog.articles.size > 0 %}
                    {% assign featured_article = blog.articles.first %}
                    <div class="top w-100">
                        <article class="top-item w-100">
                            <div class="top-item__thumbnail">
                                <a href="{{ featured_article.url }}" aria-label="{{ featured_article.title }}">
                                    <div>
                                        <img loading="lazy" src="{{ featured_article.image.src | img_url: '1024x1024' }}" alt="{{ featured_article.title }}" width="871" height="400">
                                    </div>
                                </a>
                                <p class="category"><a href="{{ blog.url }}" aria-label="{{ blog.title }}">{{ blog.title }}</a></p>
                            </div>
                            <div class="top-item__content">
                                <h3 class="name"><a href="{{ featured_article.url }}" aria-label="{{ featured_article.title }}">{{ featured_article.title }}</a></h3>
                                <p class="meta flex-inline-center-left">
                                    <span class="meta-date">{{ featured_article.published_at | date: '%d/%m/%Y' }}</span>
                                    <span class="meta-auth">
                                        <span class="meta-auth__name" aria-label="{{ featured_article.author }}">{{ featured_article.author }}</span>
                                    </span>
                                </p>
                                <p class="description">{{ featured_article.content | strip_html | truncatewords: 35 }}</p>
                            </div>
                        </article>
                    </div>

                    <h1 class="category-name">{{ blog.title }}</h1>

                    <div class="w-100">
                        <div class="list flex-left" id="blog-list">
                            {% for article in blog.articles offset: 1 %}
                            <article class="article-item">
                                <div class="article-item__thumbnail">
                                    <a href="{{ article.url }}" aria-label="{{ article.title }}">
                                        <div>
                                            <img loading="lazy" src="{{ article.image.src | img_url: 'medium' }}" alt="{{ article.title }}" width="248" height="143">
                                        </div>
                                    </a>
                                </div>
                                <div class="article-item__content">
                                    <p class="category"><a href="{{ blog.url }}" aria-label="{{ blog.title }}">{{ blog.title }}</a></p>
                                    <h3 class="name"><a href="{{ article.url }}" aria-label="{{ article.title }}">{{ article.title | truncate: 58 }}</a></h3>
                                    <p class="meta flex-inline-center-left">
                                        <span class="meta-date">{{ article.published_at | date: '%d/%m/%Y' }}</span>
                                        <span class="meta-auth">
                                            <span class="meta-auth__name" aria-label="{{ article.author }}">{{ article.author }}</span>
                                        </span>
                                    </p>
                                </div>
                            </article>
                            {% endfor %}
                        </div>

                        <div class="w-100 pagination-wrap">
                            <div class="pagination-numbers flex-center-between w-100">
                                <div class="pagination-numbers__left flex-center-left">
                                    {% if paginate.previous %}
                                    <a class="paginate-prev flex-center" href="{{ paginate.previous.url }}" aria-label="Trang trước">
                                        <svg width="19" height="13" viewBox="0 0 19 13" fill="#006DF0" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M17.0469 6.27041L1.05859 6.27041M1.05859 6.27041L5.86416 1.46484M1.05859 6.27041L5.86416 11.076" stroke="#1F4388" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </a>
                                    {% else %}
                                    <p class="paginate-prev flex-center" data-href="">
                                        <svg width="19" height="13" viewBox="0 0 19 13" fill="#006DF0" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M17.0469 6.27041L1.05859 6.27041M1.05859 6.27041L5.86416 1.46484M1.05859 6.27041L5.86416 11.076" stroke="#1F4388" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </p>
                                    {% endif %}
                                    {% if paginate.next %}
                                    <a class="paginate-next flex-center" href="{{ paginate.next.url }}" aria-label="Xem thêm">
                                        <span>Xem thêm</span>
                                        <svg width="19" height="13" viewBox="0 0 19 13" fill="#FFF" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M1.60352 6.27036L17.5918 6.27036M17.5918 6.27036L12.7862 11.0759M17.5918 6.27036L12.7862 1.46479" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </a>
                                    {% endif %}
                                    <div class="loading-box"><div class="loading-box__image"><div class="icon"></div></div></div>
                                </div>
                                <div class="pagination-numbers__right flex-center-right">
                                    <span class="text">Trang</span>
                                    <p class="paginate-item">{{ paginate.current_page }}</p>
                                    <span class="text">của {{ paginate.pages }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endpaginate %}
                </div>

                <div class="blog-content__sidebar">
                    <div class="widget widget-category">
                        <div class="widget-body">
                            <div class="widget-body__title">
                                <p>Danh mục</p>
                            </div>
                            <div class="widget-body__content">
                                <ul class="category-lists">
                                    {% for item in blogs %}
                                    {% assign item_blog = item[1] | default: item %}
                                    <li class="category-lists__item {% if item_blog.handle == blog.handle %}active{% endif %}">
                                        <p class="w-100 flex-center-between ">
                                            <span class="name"><a href="{{ item_blog.url }}" aria-label="{{ item_blog.title }}">{{ item_blog.title }}</a></span>
                                        </p>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="widget widget-top">
                        <div class="widget-body">
                            <div class="widget-body__title">
                                <p>Bài viết nổi bật</p>
                            </div>
                            <div class="widget-body__content">
                                <div class="top-lists">
                                    {% for article in blog.articles limit: 3 offset: 1 %}
                                    <div class="top-lists__item flex-left">
                                        <div class="thumbnail">
                                            <a href="{{ article.url }}" aria-label="{{ article.title }}">
                                                <div>
                                                    <img loading="lazy" src="{{ article.image.src | img_url: '98x98' }}" alt="{{ article.title }}" width="98" height="98">
                                                </div>
                                            </a>
                                        </div>
                                        <div class="content">
                                            <h3 class="content-name"><a href="{{ article.url }}" aria-label="{{ article.title }}">{{ article.title | truncate: 58 }}</a></h3>
                                            <p class="meta flex-inline-center-left">
                                                <span class="meta-date">{{ article.published_at | date: '%d/%m/%Y' }}</span>
                                                <span class="meta-auth">
                                                    <span class="meta-auth__name" aria-label="{{ article.author }}">{{ article.author }}</span>
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
