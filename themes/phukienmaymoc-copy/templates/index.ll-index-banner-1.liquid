{% layout none %}
<link href="{{ 'll-index-banner-1.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'll-index-banner-1.js' | asset_url }}"></script>
<section class="loomline-index-banner-1">
  <div class="container">
  <div class="banner-heading">
      <div class="heading-title">
        {% if settings.loomline_index_banner_1_title != empty %}
          <h2 class="title2 hrv-cf-loomline_index_banner_1_title" setting-id="loomline_index_banner_1_title" setting-type="textarea">{{ settings.loomline_index_banner_1_title | newline_to_br}}</h2>
        {% endif %}
      </div>
      <div class="heading-nav">
        <div class="swiper-nav swiper-prev button">
          <svg width="30px" height="30px" viewBox="-78.5 0 512 512" xmlns="http://www.w3.org/2000/svg">
            <title>left</title><path d="M257 64L291 98 128 262 291 426 257 460 61 262 257 64Z" /></svg>
        </div>
        <div class="swiper-nav swiper-next button">
          <svg width="30px" height="30px" viewBox="-77 0 512 512" xmlns="http://www.w3.org/2000/svg">
            <title>right</title><path d="M98 460L64 426 227 262 64 98 98 64 294 262 98 460Z" /></svg>
        </div>
      </div>
    </div>
  </div>
  <div class="banner-list">
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for i in (1..5) %}
          {% capture show %}show_loomline_index_banner_1_{{i}}{%endcapture%}
          {% capture bg %}loomline_index_banner_1_{{i}}_bg_color{%endcapture%}
          {% capture color %}loomline_index_banner_1_{{i}}_color{%endcapture%}
          {% capture img %}loomline_index_banner_1_{{i}}_img.jpg{%endcapture%}
          {% capture show_video %}show_loomline_index_banner_1_{{i}}_video{%endcapture%}
          {% capture video %}loomline_index_banner_1_{{i}}_video_link{%endcapture%}
          {% capture title1 %}loomline_index_banner_1_{{i}}_title_1{%endcapture%}
          {% capture title2 %}loomline_index_banner_1_{{i}}_title_2{%endcapture%}
          {% capture desc %}loomline_index_banner_1_{{i}}_desc{%endcapture%}
          {% capture btn %}loomline_index_banner_1_{{i}}_btn{%endcapture%}
          {% capture link %}loomline_index_banner_1_{{i}}_link{%endcapture%}
          {% if settings[show] %}
            <div class="swiper-slide">
              <div class="banner-item" style="--bg: {{settings[bg]}};--color: {{settings[color]}}">
                <a href="{{settings[link]}}">
                  <div class="content-box">
                  <div class="box-detail">
                    {%if settings[title1] != empty%}<div class="title1 hrv-cf-{{ title1 }}" setting-id="{{ title1 }}" setting-type="text">{{settings[title1]}}</div>{%endif%}
                    {%if settings[title2] != empty%}<h3 class="title2 hrv-cf-{{ title2 }}" setting-id="{{ title2 }}" setting-type="textarea">{{settings[title2]}}</h3>{%endif%}
                    {%if settings[desc] != empty%}<div class="desc hrv-cf-{{ desc }}" setting-id="{{ desc }}" setting-type="textarea">{{settings[desc]}}</div>{%endif%}
                    {%if settings[btn] != empty%}
                      <div class="btn-more"><span class="button hrv-cf-{{ btn }}" setting-id="{{ btn }}" setting-type="text">{{settings[btn]}}</span></div>
                    {%endif%}
                  </div>
                </div>
                <div class="img-box {% if settings[show_video] %}has-video{%endif%}">
                  {% if settings[show_video] %}
                    <div class="video-box">
                    <video
                      autoplay
                      loop
                      muted
                      playsinline
                      webkit-playsinline
                      preload="none"
                      poster="{{ img | asset_url}}" setting-id="{{ video }}" class="hrv-cf-{{ video }}">
                      <source src="{{settings[video]}}" type="video/mp4">
                    </video>
                    </div>
                    {% else %}
                    <div class="img">
                    <img
                      src="{{ img | asset_url}}"
                      alt="{{ settings[title2] | strip_html | escape }}"
                      class="swiper-lazy"
                      loading="eager"
                      decoding="sync" />
                    </div>
                  {% endif %}
                </div>
                </a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    </div>
</section>