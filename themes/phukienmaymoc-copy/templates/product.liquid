<link rel="preload" href="{{ 'product-single-hoplong.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'product-single-hoplong.css' | asset_url }}">

<style>
.breadcrumb {
    height: 64px !important;
    padding-top: 20px !important;
    padding-bottom: 20px !important;
    box-sizing: border-box !important;
}
.breadcrumb-list {
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
}
.breadcrumb-list__item {
    display: inline-flex !important;
    align-items: center !important;
}
.breadcrumb-list__item a {
    color: #555 !important;
    font-size: 14px !important;
    text-decoration: none !important;
}
.breadcrumb-list__item .icon {
    margin: 0 8px !important;
    color: #999 !important;
}
.products-single__wraper {
    display: flex !important;
    justify-content: space-between !important;
    gap: 30px !important;
}
.products-single__wraper .content {
    flex: 1 !important;
}
.products-single__wraper .sidebar {
    width: 300px !important;
    flex-shrink: 0 !important;
}
.content-top {
    display: flex !important;
    gap: 30px !important;
}
.content-top .image-gallery {
    width: 420px !important;
}
.content-top .image-gallery img {
    width: 100% !important;
    border: 1px solid #eee !important;
    border-radius: 4px !important;
}
.content-top .product-info {
    flex: 1 !important;
}
.product-info h1 {
    font-size: 22px !important;
    font-weight: 700 !important;
    margin-bottom: 12px !important;
}
.product-info .sku-vendor {
    color: #777 !important;
    font-size: 13px !important;
    margin-bottom: 15px !important;
}
.product-info .price {
    font-size: 24px !important;
    color: #d70018 !important;
    font-weight: 700 !important;
    margin-bottom: 20px !important;
}
.btn-add-cart {
    background: #0961ca !important;
    color: #fff !important;
    border: none !important;
    padding: 12px 30px !important;
    border-radius: 4px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
}
</style>

<main>
    <div class="products-single w-100">
        <div class="breadcrumb w-100">
            <div class="container desktop container-fuild"> 
                <ul itemscope="" itemtype="https://schema.org/BreadcrumbList" class="flex-center-left breadcrumb-list">
                    <li itemprop="itemListElement" class="breadcrumb-list__item flex-inline-center" itemscope="" itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="/" style="display: inline;">
                            <span itemprop="name">Trang chủ</span>
                        </a>
                        <meta itemprop="position" content="1">
                        <span class="icon">/</span> 
                    </li>
                    <li itemprop="itemListElement" class="breadcrumb-list__item flex-inline-center" itemscope="" itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{ product.url }}" style="display: inline;">
                            <span itemprop="name">{{ product.title }}</span>
                        </a>
                        <meta itemprop="position" content="2">
                    </li>
                </ul>
            </div>
        </div>

        <div class="container container-fuild">
            <div class="products-single__wraper flex-left-between w-100">
                <div class="content">
                    <div class="content-top flex-left-between">
                        <div class="image-gallery">
                            <img src="{{ product.featured_image.src | img_url: 'grande' }}" alt="{{ product.title }}">
                        </div>
                        <div class="product-info">
                            <h1>{{ product.title }}</h1>
                            <div class="sku-vendor">
                                <span>Mã sản phẩm: <strong>{{ product.variants.first.sku | default: 'Đang cập nhật' }}</strong></span> | 
                                <span>Thương hiệu: <strong>{{ product.vendor }}</strong></span>
                            </div>
                            <div class="price">
                                <span>{{ product.price | money }}</span>
                            </div>
                            <div class="actions">
                                <form action="/cart/add" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                                    <button type="submit" class="btn-add-cart">Thêm vào giỏ hàng</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="content-description" style="margin-top: 30px;">
                        <div class="content-tab">
                            <h2 style="font-size: 18px; font-weight: bold; border-bottom: 2px solid #0961ca; padding-bottom: 8px; margin-bottom: 15px;">Mô tả sản phẩm</h2>
                            <div class="description-body">
                                {{ product.description }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sidebar">
                    <div class="sidebar-policy" style="background: #f8f9fa; padding: 20px; border-radius: 4px; border: 1px solid #eee;">
                        <h3 style="font-size: 16px; font-weight: bold; margin-bottom: 15px;">Chính sách mua hàng</h3>
                        <ul style="list-style: none; padding: 0; margin: 0; line-height: 28px; font-size: 14px;">
                            <li>✓ Cam kết hàng chính hãng 100%</li>
                            <li>✓ Bảo hành theo tiêu chuẩn nhà sản xuất</li>
                            <li>✓ Giao hàng toàn quốc nhanh chóng</li>
                            <li>✓ Hỗ trợ kỹ thuật 24/7</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
