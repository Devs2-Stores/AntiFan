<style>
.tabbed-content .tab-panel:not(.active) { display: none !important; }
.tab-jobs .nav-tabs > li.active > a { border-bottom: 2px solid #3092ce !important; color: #3092ce !important; font-weight: 700 !important; }
.job.job-ta .new-jobs { background-color: #e53935; color: #fff; font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; }
html, * { scrollbar-width: none !important; }
*::-webkit-scrollbar { display: none !important; }
</style>
{% include 'breadcrumb' %}
<div class="page-tuyen-dung w-100" style="padding: 40px 0;">
    <div class="container container-fuild">
        <h1 style="font-size: 28px; font-weight: bold; margin-bottom: 20px;">{{ page.title | default: 'Tuyển dụng Hợp Long' }}</h1>
        <div class="page-content" style="line-height: 1.8; font-size: 15px; color: #333;">
            {{ page.content }}
        </div>
    </div>
</div>
