<link rel="preload" href="{{ 'll-product-loop.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-product-loop.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'll-product-loop.js' | asset_url }}"></script>
  <link rel="preload stylesheet" href="{{ 'page-wishlist.scss.css' | asset_url }}" as="stylesheet">
<div class="layout-pageWishlist loomline-pageWishlist">	
  {%- include 'breadcrumb' -%}
  <div class="loomline-list-product-wishlist">
    <div class="container">
      <div class="js-list-wishlist row">
        
      </div>
    </div>
  </div>
</div>
<style>
  .loomline-list-product-wishlist {
    padding: 60px 0;
  }
  @media (max-width: 992px) {
    .loomline-list-product-wishlist {
      padding: 40px 0;
    }
  }
</style>
<script defer>
  $(function(){
    var arrWishlist; 
    if (localStorage.getItem('list_wishlist') == null) {
      $('.js-list-wishlist').append(`<div class="col-lg-12 col-md-12 col-12"><div class="text-center">Chưa có sản phẩm được yêu thích. </div></div>`)
    } else {
      $('.js-list-wishlist').html("");
      arrWishlist = localStorage.getItem('list_wishlist').split(',')
    }
    for(var i = 0; i < arrWishlist.length; i++){
      $.ajax({
        url: '/products/' + arrWishlist[i] + '?view=wishlist',
        success: function(data){
          $('.js-list-wishlist').append(data);
          Loomline.Wishlist.init();
        }
      })
    }
  })
</script>