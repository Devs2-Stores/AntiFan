<link rel="preload" href="{{ 'product-hoplong.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'product-hoplong.css' | asset_url }}">

<div class="brand-single w-100">
  <div class="breadcrumb w-100">
    <div class="container desktop container-fuild">
      <ul itemscope itemtype="https://schema.org/BreadcrumbList" class="flex-center-left breadcrumb-list">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-list__item flex-inline-center">
          <a itemprop="item" href="{{ shop.url }}" style="display: inline;">
            <span itemprop="name">Trang chủ</span>
          </a>
          <meta itemprop="position" content="1">
          <span class="icon">/</span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-list__item flex-inline-center">
          <a itemprop="item" href="{{ shop.url }}/pages/brands" style="display: inline;">
            <span itemprop="name">Danh mục thương hiệu</span>
          </a>
          <meta itemprop="position" content="2">
          <span class="icon">/</span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-list__item flex-inline-center">
          <a itemprop="item" href="{{ shop.url }}{{ collection.url }}" style="display: inline;">
            <span itemprop="name">{{ collection.title }}</span>
          </a>
          <meta itemprop="position" content="3">
        </li>
      </ul>
    </div>
  </div>

  <div class="container container-fuild">
    {% if collection.image %}
    <div class="brand-single__banner">
      <img src="{{ collection.image.src | collection_img_url: 'master' }}" alt="{% if collection.image.alt != blank %}{{ collection.image.alt | escape }}{% else %}{{ collection.title | escape }}{% endif %}" title="{{ collection.title | escape }}" width="1440" height="432" loading="eager" fetchpriority="high">
    </div>
    {% endif %}

    <div class="brand-single__detail-group">
      <h1 class="brand-single__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
      <div class="brand-single__detail">{{ collection.description }}</div>
      {% endif %}
    </div>

    {% if collection.products.size > 0 %}
    <div class="brand-content">
      <h2 class="brand-content__title">Sản phẩm nổi bật</h2>
      <div class="brand-content__list">
        {% for product in collection.products limit: 3 %}
        <div class="brand-content__item">
          <div class="brand-content__info">
            <h3 class="brand-content__detail-title">{{ product.title }}</h3>
            {% if product.description != blank %}
            <div class="brand-content__detail">{{ product.description | strip_html | truncatewords: 45 }}</div>
            {% endif %}
            <a class="brand-content__link btn btn-primary" href="{{ product.url }}" aria-label="Xem thêm" aria-title="Xem thêm">Xem thêm</a>
          </div>
          <div class="brand-content__thumnail">
            <div class="">
              {% if product.featured_image %}
              <img loading="eager" src="{{ product.featured_image.src | product_img_url: 'large' }}" alt="{{ product.title | escape }}" title="{{ collection.title | escape }}" width="465" height="344">
              {% endif %}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% capture related_list %}
      {% assign shown = 0 %}
      {% for c in collections %}
        {% if shown < 5 and c.handle != collection.handle %}
          {% assign shown = shown | plus: 1 %}
          {% assign related_image = '' %}
          {% if c.image %}
            {% assign related_image = c.image.src | collection_img_url: 'large' %}
          {% elsif c.products.first.featured_image %}
            {% assign related_image = c.products.first.featured_image | product_img_url: 'large' %}
          {% endif %}
          <div class="category-related__item" data-image="{{ related_image }}">
            {% if related_image != '' %}
            <div class="category-related__thumnail">
              <img loading="eager" src="{{ related_image }}" alt="{{ c.title | escape }}" title="{{ c.title | escape }}" width="332" height="332">
            </div>
            {% endif %}
            <h3 class="category-related__name">{{ c.title }}</h3>
            <div class="category-related__detail">{% if c.description != blank %}{{ c.description | strip_html | truncate: 200 }}{% else %}{{ c.products_count }} sản phẩm{% endif %}</div>
            <a href="{{ c.url }}" class="category-related__link" aria-label="Xem tất cả sản phẩm" aria-title="Xem tất cả sản phẩm">Xem tất cả sản phẩm</a>
          </div>
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% if related_list contains 'category-related__item' %}
    <div class="category-related">
      <div class="category-related__list">{{ related_list }}</div>
    </div>
    {% endif %}
  </div>
</div>
