{% layout none %}
<section class="loomline-index-marquee" id="loomline-index-marquee">
  <div class="marquee">
    <div class="marquee__inner">
      {% for j in (1..3) %}
        {% for i in (1..6) %}
          {% capture show %}loomline_index_marquee_show_{{i}}{%endcapture%}
          {% capture title %}loomline_index_marquee_title_{{i}}{%endcapture%}
          {% capture link %}loomline_index_marquee_link_{{i}}{%endcapture%}
          {% capture img %}loomline_index_marquee_img_{{i}}.jpg{%endcapture%}
          {% if settings[show] %}
            <div class="marquee__inner--item">
              <a href="{{settings[link]}}" class="img">
                <img src="{{ img | asset_url}}" alt="{{settings[title]}}" />
              </a>
              <div class="title">
                <a href="{{settings[link]}}" setting-id="{{ title }}" setting-type="text" class="hrv-cf-{{ title }}">{{ settings[title] }}</a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>