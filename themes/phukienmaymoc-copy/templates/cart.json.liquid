{%- layout none -%}
[{%- for item in cart.items -%}
{
"image": "{%- if item.image > 0 -%}{%- if item.variant.image == empty -%}{{ item.image | img_url : 'medium'}}{%- else-%}{{ item.variant.image | img_url:'medium'}}{%- endif- %}{%- else -%}{{'no_image.jpg' | asset_url}}{%- endif -%}",
"url": "{{item.url}}",
"id": "{{ item.id}}",
"title": "{{ item.title | escape }}",
"price": "{{ item.price }}",
"price_default": "{{ item.price}}",
"compare_at_price": "{{ item.variant.compare_at_price }}",
"line_price": "{{ item.line_price }}",
"line_price_compare": "{{ item.variant.compare_at_price | times: item.quantity }}",
"variant_title": "{{ item.variant.title | escape}}",
"sku": "{%- if item.variant.sku != empty -%}{{ item.variant.sku | escape}}{%-else-%}undefined{%- endif -%}",
"quantity": "{{item.quantity}}",
"properties": "{{item.properties}}",
"line": "{{forloop.index}}"
},{%- endfor -%}{"total_price":"{{cart.total_price | money}}"},{"total_size":"{{cart.item_count}}"}]