{% layout none %}
<link rel="preload" href="{{ 'll-index-about.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-index-about.scss.css' | asset_url }}">
<section class="loomline-index-about">
  <div class="container">
    <div class="row align-items-center about-group">
      <div class="col-lg-6 col-12">
        <div class="about-content text-center">
          <div class="heading-title">
            {% if settings.loomline_index_about_title_1 != empty %}
              <div class="title1 hrv-cf-loomline_index_about_title_1" setting-id="loomline_index_about_title_1" setting-type="text">{{ settings.loomline_index_about_title_1 }}</div>
            {% endif %}
            {% if settings.loomline_index_about_title_2 != empty %}
              <h2 class="title2 hrv-cf-loomline_index_about_title_2" setting-id="loomline_index_about_title_2" setting-type="textarea">{{ settings.loomline_index_about_title_2 | newline_to_br }}</h2>
            {% endif %}
            {% if settings.loomline_index_about_desc != empty %}
              <div class="desc hrv-cf-loomline_index_about_desc" setting-id="loomline_index_about_desc" setting-type="textarea">{{ settings.loomline_index_about_desc }}</div>
            {% endif %}
          </div>
          {%if settings.loomline_index_about_btn != empty%}
            <div class="btn-more"><a href="{{settings.loomline_index_about_link}}" class="button hrv-cf-loomline_index_about_btn" setting-id="loomline_index_about_btn" setting-type="text"><span>{{settings.loomline_index_about_btn}}</span></a></div>
          {%endif%}
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="about-banner {% if settings.show_loomline_index_about_video %}has-video{%endif%}">
          {% if settings.show_loomline_index_about_video %}
            <div class="video-box">
              <video
                autoplay
                loop
                muted
                playsinline
                webkit-playsinline
                preload="none"
                poster="{{ 'loomline_index_about_video_img.jpg' | asset_url}}" setting-id="loomline_index_about_video_link" class="hrv-cf-loomline_index_about_video_link">
                <source src="{{settings.loomline_index_about_video_link}}" type="video/mp4">
              </video>
            </div>
          {% else %}
            <div class="img-box">
              <img
                src="{{ settings.loomline_index_about_img }}"
                alt="{{ settings.loomline_index_about_title_2 | strip_html | escape }}"
                loading="eager"
                decoding="sync" / setting-id="loomline_index_about_img" setting-type="image" class="hrv-cf-loomline_index_about_img">
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>