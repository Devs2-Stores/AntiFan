{% unless has_heading %}
  <link rel="preload" href="{{ 'll-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'll-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'll-index-banner-2.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-index-banner-2.scss.css' | asset_url }}">

<section class="loomline-index-banner-2">
  <div class="container">
    <div class="heading-title text-center">
      {% if settings.loomline_index_banner_2_title != empty %}
        <h2 class="title2 hrv-cf-loomline_index_banner_2_title" setting-id="loomline_index_banner_2_title" setting-type="textarea">{{ settings.loomline_index_banner_2_title | newline_to_br }}</h2>
      {% endif %}
    </div>
    {%if settings.loomline_index_banner_2_btn != empty%}
      <div class="btn-more btn-heading text-center"><a href="{{settings.loomline_index_banner_2_link}}" class="btn-link hrv-cf-loomline_index_banner_2_btn" setting-id="loomline_index_banner_2_btn" setting-type="text">{{settings.loomline_index_banner_2_btn}}</a></div>
    {%endif%}

    <div class="row list-banner">
      {%for i in (1..3)%}
        {%capture show%}show_loomline_index_banner_2_{{i}}{%endcapture%}
        {%capture img%}loomline_index_banner_2_{{i}}_img{%endcapture%}
        {%capture title%}loomline_index_banner_2_{{i}}_title{%endcapture%}
        {%capture btn%}loomline_index_banner_2_{{i}}_btn{%endcapture%}
        {%capture link%}loomline_index_banner_2_{{i}}_link{%endcapture%}
        {%capture show_video%}show_loomline_index_banner_2_{{i}}_video{%endcapture%}
        {%capture link_video%}loomline_index_banner_2_{{i}}_video_link{%endcapture%}
        {%if settings[show]%}
      <div class="col-lg-4 col-12">
        <div class="banner-item">
          <div class="banner-box {% if settings[show_video] %}has-video{%endif%}">
          {% if settings[show_video] %}
            <div class="video-box">
              <video
                autoplay
                loop
                muted
                playsinline
                webkit-playsinline
                preload="none"
                poster="{{ img | asset_url}}" setting-id="{{ link_video }}" class="hrv-cf-{{ link_video }}">
                <source src="{{settings[link_video]}}" type="video/mp4">
              </video>
            </div>
          {% else %}
            <div class="img-box">
              <img src="{{ settings[img]}}" alt="{{ settings[title] | strip_html | escape }}" loading="eager" decoding="sync" />
            </div>
          {% endif %}
        </div>
          <div class="banner-content text-center">
            {%if settings[title] != empty%}<h3 class="title hrv-cf-{{ title }}" setting-id="{{ title }}" setting-type="text">{{settings[title]}}</h3>{%endif%}
            {% if settings[btn] != empty %}
            <div class="btn-more">
              <a href="{{settings[link]}}" class="button hrv-cf-{{ btn }}" setting-id="{{ btn }}" setting-type="text"><span>{{ settings[btn] }}</span></a>
            </div>
          {% endif %}
          </div>
        </div>
      </div>
          {%endif%}
        {%endfor%}
    </div>
  </div>
</section>
