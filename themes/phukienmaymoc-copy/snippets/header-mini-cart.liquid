{%- unless template contains 'cart'-%}
{%- assign checkPriTotal = false -%}
{%- assign valuePriTotal =  cart.total_price | divided_by : 100 -%}
{%- assign valuePriMin = 0-%}
{%- assign freeShipMin =  settings.cart_freeship_min -%}
{%- assign percent = valuePriTotal | times: 100 | divided_by: freeShipMin -%}
{%- if settings.use_cart_total_min and settings.cart_total_min != '' -%}
{%- assign valuePriMin =  settings.cart_total_min | lstrip | rstrip | times: 1 -%}
{%- if valuePriMin > valuePriTotal -%} 
{%- assign checkPriTotal = true -%}
{%- endif -%}
{%- endif -%}

{% if valuePriTotal == 0 %} {%- assign checkPriTotal = true -%} {% endif %}
<div class="loomline-sitenav-wrapper loomline-sitenav-right loomline-sitenav-cart {%if valuePriTotal == 0 %}loomline-cart-empty{%endif%}">
	<div class="loomline-sitenav-inner">
		<div class="loomline-sitenav-header">
			<p class="loomline-sitenav-header__title">Giỏ hàng</p>
			<a name="button-close" class="loomline-sitenav-header__btn loomline-btn-sitenav-close">
				<svg viewBox="0 0 19 19" role="presentation"><path d="M9.1923882 8.39339828l7.7781745-7.7781746 1.4142136 1.41421357-7.7781746 7.77817459 7.7781746 7.77817456L16.9705627 19l-7.7781745-7.7781746L1.41421356 19 0 17.5857864l7.7781746-7.77817456L0 2.02943725 1.41421356.61522369 9.1923882 8.39339828z" fill-rule="evenodd"></path></svg>
			</a>
			{%if settings.use_cart_freeship_min and freeShipMin > 0%}
			<div class="loomline-cart-shipping {%if valuePriTotal >= freeShipMin %}loomline-cart-shipping-free{%endif%}">
				{%- if valuePriTotal >= freeShipMin -%}
				<div class="loomline-cart-shipping__title">Bạn đã được <span class="loomline-free-ship">miễn phí vận chuyển</span></div>
				<div class="loomline-cart-shipping__bar {%if cart.item_count == 0%}d-none{%endif%}">
					<span class="loomline-shipping-bar" style="width:100%">
						<span class="icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-truck"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
						</span>
					</span>
				</div>
				{%- else -%}
				<div class="loomline-cart-shipping__title">Bạn cần mua thêm <span class="loomline-price">{{ freeShipMin | minus: valuePriTotal | times: 100 | money}}</span> để được <span class="loomline-free-ship">miễn phí vận chuyển</span></div>
				<div class="loomline-cart-shipping__bar {%if cart.item_count == 0%}d-none{%endif%}">
					<span class="loomline-shipping-bar" style="width:{{percent}}%">
						<span class="icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-truck"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
						</span>
					</span>
				</div>
				{%- endif -%}
			</div>
			{%endif%}
		</div>
		<div class="loomline-sitenav-content">
			<div class="loomline-cart-view">
				<div class="loomline-cart-view-scroll">
					<div id="loomline-clone-item-cart" class="loomline-table-clone-cart">
						<div class="loomline-mini-cart__item d-none">
							<div class="loomline-mini-cart__left"><a class="loomline-mnc-link" href="#" title=""><img src="" alt="" /></a></div>
							<div class="loomline-mini-cart__right">
								<p class="loomline-mini-cart__title">	
									<a class="loomline-mnc-title loomline-mnc-link" href="#" title=""></a>
									<span class="loomline-mnc-variant">	</span>	
								</p>
								<div class="loomline-mini-cart__quantity">
									<button class="loomline-qty-btn loomline-mnc-minus">
										<svg enable-background="new 0 0 10 10" viewBox="0 0 10 10" x="0" y="0"><polygon points="4.5 4.5 3.5 4.5 0 4.5 0 5.5 3.5 5.5 4.5 5.5 10 5.5 10 4.5"></polygon></svg>
									</button>
									<input class="loomline-qty-value" type="text" readonly="" name="loomline-mnc-quantity" value="{{item.quantity}}">
									<button class="loomline-qty-btn loomline-mnc-plus">
										<svg enable-background="new 0 0 10 10" viewBox="0 0 10 10" x="0" y="0"><polygon points="10 4.5 5.5 4.5 5.5 0 4.5 0 4.5 4.5 0 4.5 0 5.5 4.5 5.5 4.5 10 5.5 10 5.5 5.5 10 5.5"></polygon></svg>
									</button>
								</div>
								<div class="loomline-mini-cart__price">
									<span class="loomline-mnc-price">{{ item.price | money }}</span> 
									<del class="loomline-mnc-ori-price"></del>
								</div>
								<div class="loomline-mini-cart__remove"></div>	
							</div>
						</div>   
					</div>
					<div id="loomline-cart-view">
						{%- if cart.item_count > 0 -%}
						{%- assign xHasyPrice = ''-%} 
						{%- for item in cart.items -%}
						{%-assign promtoionref = item.promotionref | append: ''-%}
						{%-if item.price == 0 and item.price_original > 0 and item.promotionref != 'null'-%}
						{%-if item.promotionby[0].variant_ids.size == 0-%}
						{%- assign xHasyPrice = xHasyPrice | append: ',' | append: item.promotionby[0].product_id-%}
						{%-else-%}
						{%-comment-%}<!-- Xử lý case theo biến thể -->{%-endcomment-%}
						{%-endif-%}
						{%-endif-%}
						{%-endfor-%}
						{%- assign xHasyPrice = xHasyPrice | remove_first: ',' | split: ','-%}
            {% assign price_mini = 0%}
            {% assign price_mini_compare = 0%}
            {% assign total_price_mini = 0%}
            {% assign total_price_mini_compare = 0%}
            {% assign total_sale_compare = 0%}
						{%- for item in cart.items -%}
						{%-assign promtoionref = item.promotionref | append: ''-%}
						{%-assign signSpecial = ''-%}
						{%-if xHasyPrice != ''-%}
						{%-assign itemPrdId = item.product_id | append: ''-%}
						{%-assign itemVrtId = item.variant_id | append: ''-%}
						{%-if xHasyPrice contains itemPrdId or xHasyPrice contains itemVrtId-%}
						{%-assign signSpecial = ' xSpecial'-%}
						{%-endif-%}
						{%-endif-%}
            {% assign price_mini = item.price | times: item.quantity %}
            {% assign price_mini_compare = item.variant.compare_at_price | times: item.quantity %}
            {%-if item.product.compare_at_price > item.price-%}
              {% assign total_price_mini = total_price_mini | plus: price_mini%}
              {% assign total_price_mini_compare = total_price_mini_compare | plus: price_mini_compare%}
            {%-endif-%}
              
						<div class="loomline-mini-cart__item {{signSpecial}}" data-handle="{{item.handle}}" data-vid="{{item.variant_id}}" data-pid="{{item.product_id}}">
							<div class="loomline-mini-cart__left">
								<a class="loomline-mnc-link" href="{{ item.product.url }}">
									<img src="{% if item.variant.image == empty %} {{ item | img_url: 'small' }} {% else%} {{ item.variant.image | product_img_url : 'small'}}  {% endif %}" alt="{{ item.title }}" />
									{%- if settings.promotion_hrvapp_use and item.properties.BuyXGetY != nil -%}
									<span class="loomline-mnc-gift"><img src="{{settings.combo_icon}}" alt="icon quà tặng"></span>
									{%- endif -%}
								</a>
							</div>
							<div class="loomline-mini-cart__right">
								<p class="loomline-mini-cart__title">	
									<a class="loomline-mnc-title loomline-mnc-link" href="{{ item.product.url }}" title="{{ item.title }}">{{ item.title }}</a>
									<span class="loomline-mnc-variant">
										{% unless item.variant.title contains 'Default Title' %}
										{{ item.variant.title }}
										{% endunless %}		
									</span>	
								</p>
								<div class="loomline-mini-cart__quantity">
									{%-assign show_btn_qty = true-%}

									{%-if settings.promotion_hrvapp_use -%}
									{%-if item.price == 0 or item.properties.BuyXGetY != nil or item.properties.Combo != nil -%}
									{%-assign show_btn_qty = false-%}
									{%-endif-%}
									{%-endif-%}

									{%-if show_btn_qty-%}
									<button class="loomline-qty-btn loomline-mnc-minus">
										<svg enable-background="new 0 0 10 10" viewBox="0 0 10 10" x="0" y="0"><polygon points="4.5 4.5 3.5 4.5 0 4.5 0 5.5 3.5 5.5 4.5 5.5 10 5.5 10 4.5"></polygon></svg>
									</button>
									{%-endif-%}
									<!--<span class="loomline-mnc-value">{{ item.quantity }}</span>-->	
									<input class="loomline-qty-value {%unless show_btn_qty %} loomline-qty-value-app {% endunless %} " type="text" readonly="" name="loomline-mnc-quantity" value="{{item.quantity}}" data-vid="{{item.variant_id}}">
									{%-if show_btn_qty-%}
									<button class="loomline-qty-btn loomline-mnc-plus">
										<svg enable-background="new 0 0 10 10" viewBox="0 0 10 10" x="0" y="0"><polygon points="10 4.5 5.5 4.5 5.5 0 4.5 0 4.5 4.5 0 4.5 0 5.5 4.5 5.5 4.5 10 5.5 10 5.5 5.5 10 5.5"></polygon></svg>
									</button>
									{%-endif-%}
								</div>
								<div class="loomline-mini-cart__price">
									<span class="loomline-mnc-price">{{ item.price | money }}</span> 
									<del class="loomline-mnc-ori-price">{%-if item.product.compare_at_price > item.price-%}{{item.variant.compare_at_price | money}}{%-endif-%}</del>
								</div>
								{%-unless settings.promotion_hrvapp_use and item.price == 0 -%}
								<div class="loomline-mini-cart__remove">
									<a href='javascript:void(0);' onclick='Loomline.Cart.Loomline_deleteCart({{forloop.index}}, {{item.product.variants.first.id}})'>
										<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 1000 1000" enable-background="new 0 0 1000 1000" xml:space="preserve"> <g><path d="M500,442.7L79.3,22.6C63.4,6.7,37.7,6.7,21.9,22.5C6.1,38.3,6.1,64,22,79.9L442.6,500L22,920.1C6,936,6.1,961.6,21.9,977.5c15.8,15.8,41.6,15.8,57.4-0.1L500,557.3l420.7,420.1c16,15.9,41.6,15.9,57.4,0.1c15.8-15.8,15.8-41.5-0.1-57.4L557.4,500L978,79.9c16-15.9,15.9-41.5,0.1-57.4c-15.8-15.8-41.6-15.8-57.4,0.1L500,442.7L500,442.7z"/></g> </svg>
									</a>
								</div>
								{%-endunless-%}
							</div>
						</div>
						{% endfor %}
						{% else %}
						<div class="loomline-mini-cart__empty">
							<div class="loomline-svgico-mini-cart">
                {%comment%}
								<img class="lazyload hrv-cf-cart_banner_image" data-src="{{ settings.cart_banner_image }}" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Giỏ hàng của bạn đang trống"/ setting-id="cart_banner_image" setting-type="image">
                {%endcomment%}
								<p>Chưa có sản phẩm trong giỏ hàng...</p>
                {%comment%}
								<div class="loomline-action-link-empty">
									<a href="{%if settings.loomline_mini_cart_linkreturn != blank%}{{settings.loomline_mini_cart_linkreturn}}{%else%}/collections/all{%endif%}" class="loomline-linkreturn">{%-if settings.loomline_mini_cart_name != blank -%}{{settings.loomline_mini_cart_name}}{%-else-%}Trở về trang sản phẩm{%-endif-%}</a>
									<a name="loomline-link-copuon" class="loomline-linkcoupon">Khuyến mãi dành cho bạn</a>
								</div>
  {%endcomment%}
                <div class="loomline-mini-cart-list">
                  {%for i in (1..4)%}
                    {%capture show%}show_loomline_mini_cart_item_{{i}}{%endcapture%}
                    {%capture img%}loomline_mini_cart_item_{{i}}_img{%endcapture%}
                    {%capture title%}loomline_mini_cart_item_{{i}}_title{%endcapture%}
                    {%capture link%}loomline_mini_cart_item_{{i}}_link{%endcapture%}
                    {%if settings[show]%}
                      <div class="item">
                        <a href="{{settings[link]}}">
                          <div class="img">
                            <img
                      src="{{ settings[img] }}"
                      alt="{{ settings[title] | strip_html | escape }}"
                      loading="eager"
                      decoding="sync" setting-id="{{ img }}" setting-type="image" />
                          </div>
                          <div class="title hrv-cf-{{ title }}" setting-id="{{ title }}" setting-type="text">{{settings[title]}}</div>
                          <div class="button"><span><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 15L15 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path d="M6.875 5H15V13.125" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg></span></div>
                        </a>
                      </div>
                    {%endif%}
                  {%endfor%}
                </div>
							</div>					
						</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
		<div class="loomline-sitenav-footer">
      <div class="loomline-cart-view-note">
        <div class="mini-note" id="mini-note">
          <span class="icon"><svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
  <path d="M7.24141 16.8751H3.75C3.58424 16.8751 3.42527 16.8093 3.30806 16.692C3.19085 16.5748 3.125 16.4159 3.125 16.2501V12.7587C3.12508 12.5932 3.19082 12.4344 3.30781 12.3173L12.9422 2.68291C13.0594 2.56579 13.2183 2.5 13.384 2.5C13.5497 2.5 13.7086 2.56579 13.8258 2.68291L17.3172 6.17198C17.4343 6.28917 17.5001 6.44808 17.5001 6.61377C17.5001 6.77946 17.4343 6.93837 17.3172 7.05557L7.68281 16.6923C7.56569 16.8093 7.40695 16.875 7.24141 16.8751Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M10.625 5L15 9.375" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg></span>
          <span class="title">Ghi chú</span>
        </div>
        <div class="mini-copuon loomline-action-link">
          <a name="link-copuon" class="loomline-linkcoupon">
            <span class="icon"><svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 15" fill="none">
  <path d="M2.31547 8.06547C2.23358 7.98349 2.18755 7.87236 2.1875 7.75648V2.6875H7.25648C7.37236 2.68755 7.48349 2.73358 7.56547 2.81547L12.997 8.24703C13.079 8.32907 13.1251 8.44031 13.1251 8.55629C13.1251 8.67227 13.079 8.78351 12.997 8.86555L8.36719 13.497C8.28515 13.579 8.17391 13.6251 8.05793 13.6251C7.94195 13.6251 7.83071 13.579 7.74867 13.497L2.31547 8.06547Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M4.59375 5.75C4.95619 5.75 5.25 5.45619 5.25 5.09375C5.25 4.73131 4.95619 4.4375 4.59375 4.4375C4.23131 4.4375 3.9375 4.73131 3.9375 5.09375C3.9375 5.45619 4.23131 5.75 4.59375 5.75Z" fill="currentColor"></path>
</svg></span>
            <span class="title hrv-cf-loomline_header_coupon_title" setting-id="loomline_header_coupon_title" setting-type="text">{%- if settings.loomline_header_coupon_title != blank -%}{{settings.loomline_header_coupon_title}}{%- else -%}Khuyến mãi dành cho bạn{%- endif -%}</span>
          </a>
          
						
        </div>
      </div>
			<div class="loomline-cart-view-total">
				<div class="loomline-total-price">
					<div class="loomline-mnc-total text-left">TỔNG TIỀN:</div>
					<div class="loomline-mnc-total text-right" id="loomline-total-view-cart">{{cart.total_price | money}}</div>
				</div>
        {% assign total_sale_compare = total_price_mini_compare | minus: total_price_mini %}
        <div  class="loomline-total-price-compare {% unless total_sale_compare > 0%}d-none{%endunless%}">
          <div class="text-left">Bạn đã tiết kiệm:</div>
					<div class="text-right" id="loomline-total-view-cart-compare">{{total_sale_compare | money}}</div>
        </div>
        
				<div class="loomline-total-actions">
					<div class="loomline-summary-alert alert alert-danger " {% if checkPriTotal %}style="display:block"{% endif %}>
						Giỏ hàng của bạn hiện chưa đạt mức tối thiểu để thanh toán.
					</div>
					<div class="loomline-action-btn">
            <a href="/cart" class="loomline-linktocart button">Xem giỏ hàng</a>
            <a href="/checkout" class="loomline-linktocheckout button {% if checkPriTotal %}disabled{% endif %}">Thanh toán</a>
          </div>
				</div>
			</div>
		</div>
    <div class="popup-mini-note">
      <button type="button" id="mini-note-close"><svg viewBox="0 0 19 19" role="presentation"><path d="M9.1923882 8.39339828l7.7781745-7.7781746 1.4142136 1.41421357-7.7781746 7.77817459 7.7781746 7.77817456L16.9705627 19l-7.7781745-7.7781746L1.41421356 19 0 17.5857864l7.7781746-7.77817456L0 2.02943725 1.41421356.61522369 9.1923882 8.39339828z" fill-rule="evenodd"></path></svg></button>
      <div class="checkout-buttons clearfix">
        <label for="note" class="note-label">Ghi chú đơn hàng</label>
        <textarea class="form-control" id="note-val" name="note" rows="5"></textarea>
      </div>
      <button type="button" id="mini-note-apply" class="button btn-disabled" disabled>Lưu</button>
    </div>
    <div class="loomline-note-overlay"></div>
	</div>
	<div class="loomline-sidebar-overlay"></div>
</div>
{%- endunless -%}




  
