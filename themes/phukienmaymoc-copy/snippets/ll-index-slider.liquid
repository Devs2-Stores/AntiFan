{%unless has_heading%}
<link rel="preload" href="{{ 'll-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{%endunless%}
<link rel="preload" href="{{ 'll-index-slider.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-index-slider.scss.css' | asset_url }}">
<link href="{{ 'll-index-slider.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'll-index-slider.js' | asset_url }}"></script>


<section class="loomline-index-slider" id="loomline-index-slider">
  <div class="index-slider">
    <div class="swiper">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="slider-item">
            <div class="slide--image">
              <picture>
                <source media="(max-width: 767px)" srcset="{{ settings.loomline_index_slider_1_img }}" />
                <source media="(min-width: 768px)" srcset="{{ settings.loomline_index_slider_1_img }}" />
                <img src="{{ settings.loomline_index_slider_1_img }}" alt="{{ settings.loomline_index_slider_1_alt | strip_html | escape }}" class="swiper-lazy hrv-cf-loomline_index_slider_1_img" loading="eager" decoding="sync" setting-id="loomline_index_slider_1_img" setting-type="image" />
              </picture>
            </div>
            {%if settings.loomline_index_slider_1_title_1 != empty or settings.loomline_index_slider_1_title_2 != empty or settings.loomline_index_slider_1_btn != empty %}
            <div class="slide--content content-{{settings.loomline_index_slider_1_position}}">
              <div class="content-box">
                {%if settings.loomline_index_slider_1_title_1 != empty%}<div class="title1"><span class="text-ani hrv-cf-loomline_index_slider_1_title_1" setting-id="loomline_index_slider_1_title_1" setting-type="text">{{settings.loomline_index_slider_1_title_1}}</span></div>{%endif%}
                {%if settings.loomline_index_slider_1_title_2 != empty%}<h2 class="title2"><span class="text-ani hrv-cf-loomline_index_slider_1_title_2" setting-id="loomline_index_slider_1_title_2" setting-type="textarea">{{settings.loomline_index_slider_1_title_2}}</span></h2>{%endif%}
                {%if settings.loomline_index_slider_1_btn != empty%}
                <div class="btn-more">
                  <a href="{{settings.loomline_index_slider_1_link}}" class="button hrv-cf-loomline_index_slider_1_btn" setting-id="loomline_index_slider_1_btn" setting-type="text"><span>{{settings.loomline_index_slider_1_btn}}</span></a>
                </div>
                {%endif%}
              </div>
            </div>
            {%endif%}
          </div>
        </div>
        {%- for i in (2..4) -%}
          {% capture show_slide %}loomline_index_slider_{{i}}_show{% endcapture %}
          {% capture image %}loomline_index_slider_{{i}}_img{% endcapture %}
          {% capture title1 %}loomline_index_slider_{{i}}_title_1{% endcapture %}
          {% capture title2 %}loomline_index_slider_{{i}}_title_2{% endcapture %}
          {% capture btn %}loomline_index_slider_{{i}}_btn{% endcapture %}
          {% capture link %}loomline_index_slider_{{i}}_link{% endcapture %}
          {% capture position %}loomline_index_slider_{{i}}_position{% endcapture %}
          {%- if settings[show_slide] -%}
            <div class="swiper-slide">
              <div class="slider-item">
                <div class="slide--image">
                  <picture>
                    <source media="(max-width: 767px)" srcset="{{ settings[image] }}" />
                    <source media="(min-width: 768px)" srcset="{{ settings[image] }}" />
                    <img src="{{ settings[image] }}" alt="{{ settings[alt] | strip_html | escape }}" class="swiper-lazy" loading="eager" decoding="sync" setting-id="loomline_index_slider_{{i}}_img" setting-type="image" />
                  </picture>
                </div>
                {% if settings[title1] != empty or settings[title2] != empty or settings[btn] != empty %}
                <div class="slide--content content-{{settings[position]}}">
                  <div class="content-box">
                    {%if settings[title1] != empty%}<div class="title1"><span class="text-ani hrv-cf-{{ title1 }}" setting-id="{{ title1 }}" setting-type="text">{{settings[title1]}}</span></div>{%endif%}
                    {%if settings[title2] != empty%}<h2 class="title2"><span class="text-ani hrv-cf-{{ title2 }}" setting-id="{{ title2 }}" setting-type="textarea">{{settings[title2]}}</span></h2>{%endif%}
                    {%if settings[btn] != empty%}
                    <div class="btn-more">
                      <a href="{{settings[link]}}" class="button hrv-cf-{{ btn }}" setting-id="{{ btn }}" setting-type="text"><span>{{settings[btn]}}</span></a>
                    </div>
                    {%endif%}
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="swiper-pagination"></div>
      {%comment%}
      <div class="swiper-nav swiper-next">
        <svg width="30px" height="30px" viewBox="-77 0 512 512" xmlns="http://www.w3.org/2000/svg" ><title>right</title><path d="M98 460L64 426 227 262 64 98 98 64 294 262 98 460Z" /></svg>
      </div>
      <div class="swiper-nav swiper-prev">
        <svg width="30px" height="30px" viewBox="-78.5 0 512 512" xmlns="http://www.w3.org/2000/svg" ><title>left</title><path d="M257 64L291 98 128 262 291 426 257 460 61 262 257 64Z" /></svg>
      </div>
{%endcomment%}
    </div>
  </div>
</section>

<div class="section-home-pus-promotion pus-promotion-grids">
  <div class="container">
    <div class="hrv-pus-promotion" data-hrvpus-layout="flashsale"></div>
  </div>
</div>
<div class="section-home-hrvpmo hrvpmo-grids">
  <div class="container">
    <div class="hrv-pmo-coupon" data-hrvpmo-layout="grids"></div>
    <div class="hrv-pmo-discount" data-hrvpmo-layout="grids"></div>
  </div>
</div>

