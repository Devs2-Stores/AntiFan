{% comment %}
  ==============================================================================
  SEO CONFIG — Điền thông tin shop 1 lần, dùng cho toàn bộ bộ Injector
  Version: 4.0.0
  ==============================================================================

  HƯỚNG DẪN:
  1. Mở file này và điền thông tin thật của shop vào phần SETTINGS bên dưới.
  2. Không cần sửa bất kỳ file nào khác.

  ==============================================================================
{% endcomment %}

{% comment %} =================================================================
  SECTION A: Social Media & SameAs
  ================================================================= {% endcomment %}

{% assign seo_facebook_url   = '' %}   {%- comment %} VD: 'https://www.facebook.com/tenpage' {% endcomment %}
{% assign seo_youtube_url    = '' %}   {%- comment %} VD: 'https://www.youtube.com/@tenchannel' {% endcomment %}
{% assign seo_linkedin_url   = '' %}
{% assign seo_tiktok_url     = '' %}
{% assign seo_zalo_url       = '' %}
{% assign seo_shopee_url     = '' %}
{% assign seo_lazada_url     = '' %}

{% comment %} =================================================================
  SECTION B: Thông tin tác giả & mạng xã hội
  ================================================================= {% endcomment %}

{% assign seo_default_author = 'Phụ Kiện Máy Móc' %}
{% assign seo_twitter_handle = '' %}   {%- comment %} VD: '@myshop' {% endcomment %}

{% comment %} =================================================================
  SECTION C: Loại doanh nghiệp
  Chọn: 'online'    — chỉ bán online, không có địa điểm (mặc định)
         'local'     — có cửa hàng vật lý, muốn xuất hiện Local Search
  ================================================================= {% endcomment %}

{% assign seo_business_type = 'online' %}

{% comment %} =================================================================
  SECTION D: Thông tin địa điểm (CHỈ điền nếu seo_business_type = 'local')
  ================================================================= {% endcomment %}

{% assign seo_street_address  = '' %}   {%- comment %} VD: '123 Đường Lê Lợi, Phường 1' {% endcomment %}
{% assign seo_city            = '' %}   {%- comment %} VD: 'TP. Hồ Chí Minh' {% endcomment %}
{% assign seo_country         = 'VN' %}
{% assign seo_phone           = '' %}   {%- comment %} VD: '+84-28-1234-5678' {% endcomment %}
{% assign seo_geo_lat         = '' %}   {%- comment %} VD: '10.7769' (lấy từ Google Maps) {% endcomment %}
{% assign seo_geo_lng         = '' %}   {%- comment %} VD: '106.7009' {% endcomment %}
{% assign seo_opening_hours   = 'Mo-Su 09:00-21:00' %}   {%- comment %} Định dạng ISO 8601 {% endcomment %}
{% assign seo_price_range     = '₫₫' %}   {%- comment %} '₫' | '₫₫' | '₫₫₫' {% endcomment %}

{% comment %} =================================================================
  SECTION E: Thông tin tổ chức bổ sung
  ================================================================= {% endcomment %}

{% assign seo_founding_year = '2020' %}   {%- comment %} VD: '2018' {% endcomment %}
{% assign seo_contact_email = 'support@phukienmaymoc.com' %}   {%- comment %} VD: 'support@myshop.com' {% endcomment %}

{% comment %} =================================================================
  SECTION F2: Font Preload (để giảm LCP, điền URL font woff2 chính)
  Lấy URL từ: F12 → Network → filter 'font' → copy URL file .woff2
  ================================================================= {% endcomment %}

{% assign seo_font_preload_url = '' %}   {%- comment %} VD: 'https://fonts.gstatic.com/s/inter/v13/...woff2' {% endcomment %}

{% comment %} =================================================================
  SECTION F: OG Image fallback (dùng khi trang không có ảnh riêng)
  Tải 1 ảnh mặc định lên Assets, điền tên file vào đây
  ================================================================= {% endcomment %}

{% assign seo_og_fallback_image_file = 'seo-og-default.jpg' %}

{% comment %} =================================================================
  COMPUTED — Không cần sửa phần dưới, tự tính
  ================================================================= {% endcomment %}

{% comment %} Logo URL {% endcomment %}
{% if shop.logo %}
  {% assign seo_logo_url = shop.logo | img_url: '600x' | prepend: 'https:' %}
{% else %}
  {% comment %} Fix v4: asset_url trả về protocol-relative (//cdn...), phải prepend 'https:' {% endcomment %}
  {% assign seo_logo_url = 'logo.png' | asset_url | prepend: 'https:' %}
{% endif %}

{% comment %} Fallback OG image URL {% endcomment %}
{% comment %} Fix v4: asset_url trả về protocol-relative, phải prepend https: giống logo {% endcomment %}
{% assign seo_og_fallback_image = seo_og_fallback_image_file | asset_url | prepend: 'https:' %}

{% comment %} SameAs array — chỉ lấy URL không rỗng {% endcomment %}
{% assign seo_sameas_array = '' %}
{% if seo_facebook_url != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_facebook_url | append: '|||' %}{% endif %}
{% if seo_youtube_url  != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_youtube_url  | append: '|||' %}{% endif %}
{% if seo_linkedin_url != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_linkedin_url | append: '|||' %}{% endif %}
{% if seo_tiktok_url   != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_tiktok_url   | append: '|||' %}{% endif %}
{% if seo_zalo_url     != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_zalo_url     | append: '|||' %}{% endif %}
{% if seo_shopee_url   != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_shopee_url   | append: '|||' %}{% endif %}
{% if seo_lazada_url   != '' %}{% assign seo_sameas_array = seo_sameas_array | append: seo_lazada_url   | append: '|||' %}{% endif %}
{% assign seo_sameas_list = seo_sameas_array | split: '|||' | compact %}
