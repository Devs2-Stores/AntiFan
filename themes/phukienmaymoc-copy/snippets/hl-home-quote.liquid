<section class="home-form">
<style>
.home-form .center p {
  margin: 0 0 25px 0 !important;
}
.home-form .right p {
  margin: 0 !important;
}
.home-form .right .form-block__header p {
  margin-bottom: 10px !important;
}
.home-form .center span {
  line-height: normal !important;
  height: 27px !important;
}
.home-form .detail {
  display: none !important;
}
.home-form .detail.active {
  display: block !important;
}
@media (max-width: 991px) {
  section.home-form {
    height: auto !important;
    padding: 20px 0 !important;
  }
  .home-form .container {
    flex-direction: column !important;
  }
  .home-form .left {
    display: none !important;
  }
  .home-form .center,
  .home-form .right {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 0 15px 0 !important;
  }
  .home-form .right form {
    width: 100% !important;
    max-width: 100% !important;
  }
}
</style>
    <div class="container container-fuild">
        <div class="left">
            <div class="thumbnail-item"
        >
    <img
                    loading="eager"
                src="{{ "dsc04523-1.png" | asset_url }}"
        alt="dsc04523-1"
                            width="426"
                            height="481"
                onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';"
    >
</div>
        </div>
        <div class="center">
            <span>Nhà phân phối chính hãng</span>
            <p>Hợp Long là nhà cung cấp thiết bị, giải pháp tự động hóa và tích hợp robot công nghiệp hàng đầu tại Việt Nam. Chúng tôi có hơn 200.000 sản phẩm được chỉ định là nhà phân phối của các thương hiệu Schneider Electric, Siemens, Omron, Veichi, NiSTRO, Leipole, Universal Robots tại Việt Nam.</p>
            <a href="/pages/gioi-thieu" title="Tìm hiểu thêm" target="_blank" aria-label="Tìm hiểu thêm">
                Tìm hiểu thêm
            </a>
        </div>
        <div class="right">
            <div class="form-block">
            {% form 'contact' %}
    <div class="form-block__header">
        <p>
            Yêu cầu báo giá
        </p>
        <span>
            Chúng tôi sẽ liên hệ và gửi báo giá theo thông tin mà bạn cung cấp
        </span>
    </div>
    {% if form.posted_successfully? %}
    <div class="alert alert-success" style="color: #28a745; margin-bottom: 15px;">
        Cám ơn bạn đã gửi yêu cầu! Chúng tôi sẽ liên hệ và gửi báo giá theo thông tin mà bạn cung cấp.
    </div>
    {% endif %}
    {% if form.errors %}
    <p class="subtext error">Thông tin bạn nhập chưa đầy đủ</p>
    {% endif %}
    <div class="form-block__content">
        <div class="form-row">
            <input type="text" name="contact[phone]" placeholder="Số điện thoại" required>
                    </div>
        <div class="form-row">
            <input type="email" name="contact[email]" placeholder="Email" required>
                    </div>
        <div class="form-row row-product" data-quote-rows>
