{% unless has_heading %}
  <link rel="preload" href="{{ 'll-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'll-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}
<link rel="preload" href="{{ 'll-index-col-slide2.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-index-col-slide2.scss.css' | asset_url }}">
<link href="{{ 'll-index-col-slide2.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'll-index-col-slide2.js' | asset_url }}"></script>
{% capture title %}loomline_index_col_slide2_{{ind}}_title{%endcapture%}
{% capture limit %}loomline_index_col_slide2_{{ind}}_limit{%endcapture%}
{% capture handle %}loomline_index_col_slide2_{{ind}}_handle{%endcapture%}
{%assign handle_col = settings[handle]%}
<section class="loomline-index-col-slide2" id="slide2_{{ind}}">
  <div class="container">
     <div class="col-heading">
       <div class="heading-title">
        {%if settings[title]%}<h2 class="title2 hrv-cf-{{ title }}" setting-id="{{ title }}" setting-type="text">{{settings[title]}}</h2>{%endif%}
       </div>
        <div class="heading-nav">
          <div class="swiper-nav swiper-prev button">
            <svg width="30px" height="30px" viewBox="-78.5 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <title>left</title><path d="M257 64L291 98 128 262 291 426 257 460 61 262 257 64Z" /></svg>
          </div>
          <div class="swiper-nav swiper-next button">
            <svg width="30px" height="30px" viewBox="-77 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <title>right</title><path d="M98 460L64 426 227 262 64 98 98 64 294 262 98 460Z" /></svg>
          </div>
        </div>
      </div>
      <div class="list-pro swiper">
        <div class="swiper-wrapper">
          {% if collections[handle_col].products.size == 0 %}
            {%for i in (1..4)%}
            <div class="swiper-slide">
               <div class="pro-item">
                {% include 'no-ll-product-loop' %}
              </div>
            </div>
            {%endfor%}
          {%else%}
          {%for product in collections[handle_col].products limit: settings[limit] %}
            <div class="swiper-slide">
               <div class="pro-item">
                {% include 'll-product-loop' %}
              </div>
            </div>
          {%endfor%}
          {%endif%}
        </div>
      </div>
  </div>
</section>