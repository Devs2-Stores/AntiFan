<style>
@media (min-width: 992px) {
  section.banner-category .banner-category__content {
    display: flex;
    flex-wrap: wrap;
  }
}
@media (max-width: 991px) {
  section.banner-category .banner-category__content {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    gap: 10px !important;
    padding: 8px 12px !important;
  }
  section.banner-category .banner-category__item {
    flex: 0 0 345px !important;
    width: 345px !important;
    min-width: 345px !important;
    box-sizing: border-box !important;
  }
  section.banner-category .banner-category__item img {
    width: 100% !important;
    height: auto !important;
    border-radius: 8px !important;
  }
}
</style>
<section class="banner-category">
  <div class="container container-fuild">
    <div class="banner-category__content w-100">
      {%- assign ban1 = collections['phu-tro'] -%}
      {%- if ban1 -%}
      {%- assign ban1_img = ban1.products.first.featured_image -%}
      <div class="banner-category__item">
        <a href="{{ ban1.url }}" title="{{ ban1.title | escape }}" aria-label="{{ ban1.title | escape }}">
          <div class="thumbnail-item">
            <img loading="eager" src="{% if ban1_img %}{{ ban1_img.src | product_img_url: 'medium' }}{% else %}{{ 'default_image.png.webp' | asset_url }}{% endif %}" alt="{{ ban1.title | escape }}" width="466" height="196" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
          </div>
        </a>
      </div>
      {%- endif -%}
      {%- assign ban2 = collections['phu-kien-laser-co2'] -%}
      {%- if ban2 -%}
      {%- assign ban2_img = ban2.products.first.featured_image -%}
      <div class="banner-category__item">
        <a href="{{ ban2.url }}" title="{{ ban2.title | escape }}" aria-label="{{ ban2.title | escape }}">
          <div class="thumbnail-item">
            <img loading="eager" src="{% if ban2_img %}{{ ban2_img.src | product_img_url: 'medium' }}{% else %}{{ 'default_image.png.webp' | asset_url }}{% endif %}" alt="{{ ban2.title | escape }}" width="466" height="196" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
          </div>
        </a>
      </div>
      {%- endif -%}
      {%- assign ban3 = collections['may-lam-lanh-nuoc'] -%}
      {%- if ban3 -%}
      {%- assign ban3_img = ban3.products.first.featured_image -%}
      <div class="banner-category__item">
        <a href="{{ ban3.url }}" title="{{ ban3.title | escape }}" aria-label="{{ ban3.title | escape }}">
          <div class="thumbnail-item">
            <img loading="eager" src="{% if ban3_img %}{{ ban3_img.src | product_img_url: 'medium' }}{% else %}{{ 'default_image.png.webp' | asset_url }}{% endif %}" alt="{{ ban3.title | escape }}" width="466" height="196" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
          </div>
        </a>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>