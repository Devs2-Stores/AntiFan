{%- assign checkFilter = false -%}
{%- if settings.collection_filter_show -%} 
{%- assign checkFilter = true -%} 
{%- endif -%}
<div class="wrapper_layered_filter">
	<div class="layered_filter_parent">
		<div class="layered_filter_container">
			<div class="layered_filter_title">
				<div class="title_filter hrv-cf-collection_filter_title" setting-id="collection_filter_title" setting-type="text">
					{{settings.collection_filter_title}}
				</div>
				<button class="close_filter">
					<svg viewBox="0 0 19 19" role="presentation"><path d="M9.1923882 8.39339828l7.7781745-7.7781746 1.4142136 1.41421357-7.7781746 7.77817459 7.7781746 7.77817456L16.9705627 19l-7.7781745-7.7781746L1.41421356 19 0 17.5857864l7.7781746-7.77817456L0 2.02943725 1.41421356.61522369 9.1923882 8.39339828z" fill-rule="evenodd"></path></svg>
				</button>
			</div>
			<div class="layered_filter_group layered_filter_mobileContent" id="layered_filter_mobile">
				<!-- ./filter sortby -->
				{% if settings.collection_sortby %}
				<div class="filter_group filter_sortby" aria-expanded="false">
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="collection_sortby_title" setting-type="text">{{settings.collection_sortby_title}}</span>
						</div>
						<div class="filter_group-content">
							<ul class="checkbox-sortby sort-by-content">									
								<li><span data-value="price-ascending" data-filter="(price:product=asc)">Giá: Tăng dần</span></li>
								<li><span data-value="price-descending" data-filter="(price:product=desc)">Giá: Giảm dần</span></li>
								<li><span data-value="title-ascending" data-filter="(title:product=asc)">Tên: A-Z</span></li>
								<li><span data-value="title-descending" data-filter="(title:product=desc)">Tên: Z-A</span></li>
								<li><span data-value="created-ascending" data-filter="(updated_at:product=asc)">Cũ nhất</span></li>
								<li class="active"><span data-value="created-descending" data-filter="(updated_at:product=desc)">Mới nhất</span></li>
								<li><span data-value="best-selling" data-filter="(sold_quantity:product=desc)">Bán chạy nhất</span></li>
								<li><span data-value="quantity-descending" data-filter="(quantity:product=desc)">Tồn kho giảm dần</span></li>
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				{% if settings.show_list_col %}
				<div class="filter_group" aria-expanded="false" >
					<div class="group-menu filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="title_list_col" setting-type="text" class="hrv-cf-title_list_col">{{settings.title_list_col}}</span>
						</div>
						<div class="filter_group-content layered-category" id="filter-col">
							<div class="layered-content">
								<ul class="tree-menu">
									{% for link in linklists[settings.collection_sidebar].links limit: 10 %}
									{% if linklists[link.handle] != empty %}
									<li class="tree-menu-lv1{% if link.active %} active {% endif %} has-child {% if forloop.first %} menu-uncollap {% else %} menu-collap {% endif %}">
										<a class="{% if link.active %} active {% endif %}" href="javascript:void(0)" title="{{ link.title }}" target="_self">
											<span class="">{{ link.title }}</span>
											<span class="icon-control"><i class="fa fa-minus"></i></span>
										</a>
										<ul class="tree-menu-sub">
											{% for l in linklists[link.handle].links %}
											<li>
												<span></span>
												<a href="{{ l.url }}"{% if l.active %} class="current"{% endif %} title="{{l.title}}">{{ l.title }}</a>
											</li>
											{% endfor %}
										</ul>
									</li>
									{% else %}
									<li class="{% if link.active %}active{% endif %}">
										<span></span>
										<a class="{% if link.active %} current{% endif %}" href="{{ link.url }}" title="{{ link.title }}" target="_self">
											{{link.title}}
										</a>
									</li>
									{% endif %}
									{% endfor %}
								</ul>
							</div>
						</div>
					</div>
				</div>
				{% endif %}
				{% if checkFilter %}
				<!-- ./filter brand -->
				{% if settings.use_vendor_filter %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="vendor_title" setting-type="text" class="hrv-cf-vendor_title">{{settings.vendor_title}}</span>
						</div>
						<div class="filter_group-content filter-brand" id="filter-brand">
							<ul class="checkbox-list">
								{% for vendor in collection.all_vendors limit: settings.vendor_limit %}	
								<li>
									<input type="checkbox" id="data-brand-p{{forloop.index}}" value="{{vendor}}" name="brand-filter" data-vendor="(vendor:product contains {{vendor | replace: '-', ''}})"/>
									<label for="data-brand-p{{forloop.index}}">{{vendor}}</label>   
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
        <!-- ./filter type -->
				{% if settings.use_type_filter %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="type_title" setting-type="text" class="hrv-cf-type_title">{{settings.type_title}}</span>
						</div>
						<div class="filter_group-content filter-type">
							<ul class="checkbox-list">
								{% for type in collection.all_types limit: settings.type_limit %}	
								<li>
									<input type="checkbox" id="data-type-p{{forloop.index}}" value="{{type}}" name="type-filter" data-type="(product_type:product={{type | replace: '-', ''}})"/>
									<label for="data-type-p{{forloop.index}}">{{type}}</label>   
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				<!-- ./filter size -->
				{% if settings.use_tag_custom_2 %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="tag_title_custom_2" setting-type="text" class="hrv-cf-tag_title_custom_2">{{settings.tag_title_custom_2}}</span>
						</div>
						<div class="filter_group-content filter-size" id="filter-size">
							{% assign tags = settings.enter_tag_2 | split:"," %}
							<ul class="checkbox-list">
								{% for tag in tags %}
								<li>
									<input type="checkbox" id="data-size-p{{forloop.index}}" value="{{tag}}" name="size-filter" data-size="(variant:product={{tag}})"/>
									<label for="data-size-p{{forloop.index}}">{{tag}}</label>   
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif%}
				<!-- ./filter price -->
				{% if settings.use_price_filter %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="title_tag_3" setting-type="text" class="hrv-cf-title_tag_3">{{settings.title_tag_3}}</span>
						</div>
						<div class="filter_group-content filter-price" id="filter-price">
							<ul class="checkbox-list">
								<li>
									<input type="checkbox" id="p1" name="cc" data-price="(price_variant:product<={{ settings.1_price_to }})" />
									<label for="p1">
										<span>Dưới</span> {{ settings.1_price_to | money | replace: ',','.' }}
									</label>   
								</li>
								<li>
									<input type="checkbox" id="p2" name="cc" data-price="((price_variant:product>{{ settings.2_price_from }})&amp;&amp;(price_variant:product<={{ settings.2_price_to }}))"/>
									<label for="p2">
										{{ settings.2_price_from | money | replace: ',','.' }} - {{ settings.2_price_to | money | replace: ',','.' }}
									</label>   
								</li>
								<li>
									<input type="checkbox" id="p3" name="cc" data-price="((price_variant:product>{{ settings.3_price_from }})&amp;&amp;(price_variant:product<={{ settings.3_price_to }}))"/>
									<label for="p3">
										{{ settings.3_price_from | money | replace: ',','.' }} - {{ settings.3_price_to | money | replace: ',','.' }}
									</label>   
								</li>
								<li>
									<input type="checkbox" id="p4" name="cc" data-price="((price_variant:product>{{ settings.4_price_from }})&amp;&amp;(price_variant:product<={{ settings.4_price_to }}))"/>
									<label for="p4">
										{{ settings.4_price_from | money | replace: ',','.' }} - {{ settings.4_price_to | money | replace: ',','.' }}
									</label>   
								</li>
								<li>
									<input type="checkbox" id="p5" name="cc" data-price="(price_variant:product>={{ settings.5_price_from }})"/>
									<label for="p5">
										<span>Trên</span> {{ settings.5_price_from | money | replace: ',','.' }}
									</label>   
								</li>
							</ul>
						</div>
					</div>
				</div>
				{% endif %}	
				<!-- ./filter color -->
				{% if settings.use_color_filter %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="color_title" setting-type="text" class="hrv-cf-color_title">{{settings.color_title}}</span>
						</div>
						<div class="filter_group-content filter-color">
							<ul class="checkbox-list clearfix hrv-cf-{{ color_name }}" setting-id="{{ color_name }}" setting-type="text">
								{% for i in (1..30) %}
								{% capture use_color %}use_color_filter_{{i}}{% endcapture %}
								{% capture color_name %}color_name_new_{{i}}{% endcapture %}
								{% capture color_code %}color_code_new_{{i}}{% endcapture %}
								{% capture value %}{{settings[color_name]}}{% endcapture %}
								{% if settings[use_color]%}
								<li>
									<input type="checkbox" id="data-color-p{{forloop.index}}" value="{{value}}" name="color-filter" data-color="(variant:product contains {{value}})"/>
									<label for="data-color-p{{forloop.index}}" style="background-color: {{settings[color_code]}}" setting-id="{{ color_name }}" setting-type="text" class="hrv-cf-{{ color_name }}">{{settings[color_name]}}</label>  
								</li>
								{% endif %}
								{% endfor %}	
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				<!-- ./filter Author -->
				{% if settings.use_tag_custom_3 %}
				<div class="filter_group" aria-expanded="false" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span setting-id="tag_title_custom_3" setting-type="text" class="hrv-cf-tag_title_custom_3">{{settings.tag_title_custom_3}}</span>
						</div>
						<div class="filter_group-content filter-author" id="filter-author">
							{% assign tags = settings.enter_tag_3 | split:"," %}
							<ul class="checkbox-list">
								{% for tag in tags %}
								<li>
									<input type="checkbox" id="data-author-p{{forloop.index}}" value="{{tag}}" name="author-filter" data-author="(tag:product={{tag}})"/>
									<label for="data-author-p{{forloop.index}}">{{tag}}</label>   
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif%}
				
				{%-comment-%}<div class="filter_group d-none d-lg-block" aria-expanded="false" >
				<div class="filter_group_block">
					<button class="btn-collection btn_clear_filter">
						Xóa bộ chọn
					</button>
				</div>
				</div> {%-endcomment-%}
				{% endif %}

			</div>
			<div class="layered_filter_bottom">
				<button id="clear-btn-filter" class="btn-filter btn-filter-clear">Hủy</button>
				<button id="apply-btn-filter" class="btn-filter btn-filter-apply">Áp dụng</button>
			</div>
		</div>
	</div>
</div>