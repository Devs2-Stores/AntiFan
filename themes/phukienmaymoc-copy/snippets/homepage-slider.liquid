<div class="section-index-slider" id="homepage-slider">
	<div class="container-fluid index-slider">
		<div class="slider-owl owl-carousel ">
				<div class="slider-item">
					<div class="slide--image">
            <picture>
              <source media="(max-width: 767px)" srcset="{{ 'slide_1_img_mb.jpg' | asset_url}}" />
              <source media="(min-width: 768px)" srcset="{{ 'slide_1_img.jpg' | asset_url}}" />
              <img src="{{ 'slide_1_img.jpg' | asset_url }}" alt="{{ settings.slide_1_title | strip_html | escape }}"/>
            </picture>
					</div>
          <div class="slide--content">
            <div class="content">
            {%if settings.slide_1_title != ''%}<h2 class="title font-title">{{settings.slide_1_title | newline_to_br}}</h2>{%endif%}
            {%if settings.slide_1_desc != ''%}<div class="desc">{{settings.slide_1_desc | newline_to_br}}</div>{%endif%}
            {%if settings.slide_1_btn != ''%}
            <div class="btn-more">
              <a href="{{ settings.slide_1_link }}" class="button">{{settings.slide_1_btn}}</a>
            </div>
            {%endif%}
            </div>
          </div>
				</div>
				{%- for i in (2..4) -%}
				{% capture show_slide %}slide_{{i}}_show{% endcapture %}
				{% capture image %}slide_{{i}}_img.jpg{% endcapture %}
				{% capture image_mb %}slide_{{i}}_img_mb.jpg{% endcapture %}
				{% capture title %}slide_{{i}}_title{% endcapture %}
        {% capture desc %}slide_{{i}}_desc{% endcapture %}
				{% capture link %}slide_{{i}}_link{% endcapture %}
				{%- if settings[show_slide] -%}
				<div class="slider-item">
					<div class="slide--image">
            <picture>
              <source media="(max-width: 767px)" srcset="{{ image_mb | asset_url}}" />
              <source media="(min-width: 768px)" srcset="{{ image | asset_url}}" />
              <img src="{{ image | asset_url }}" alt="{{ settings[title] | strip_html | escape }}"/>
            </picture>
					</div>
          <div class="slide--content">
            <div class="content">
            {%if settings[title] != ''%}<h2 class="title font-title">{{settings[title] | newline_to_br}}</h2>{%endif%}
            {%if settings[desc] != ''%}<div class="desc">{{settings[desc] | newline_to_br}}</div>{%endif%}
            {%if settings[btn] != ''%}
            <div class="btn-more">
              <a href="{{ settings[link] }}" class="button">{{settings[btn]}}</a>
            </div>
            {%endif%}
            </div>
          </div>
				</div>
				{%- endif -%}
				{%- endfor -%}
			</div> 
	</div>
</div>
