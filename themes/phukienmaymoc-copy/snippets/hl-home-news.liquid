<section class="news">
<style>
@media (min-width: 992px) {
  section.news {
    line-height: normal !important;
  }
  section.news .news-header {
    height: 37px !important;
    margin-bottom: 20px !important;
  }
  section.news .news-header p {
    margin: 0 !important;
  }
  section.news .article-item p {
    margin: 15px 0 0 0 !important;
  }
  section.news .article-item {
    height: 328px !important;
  }
  section.news .article-item__content h3 {
    margin: 0 !important;
  }
}
</style>
            <div class="container container-fuild">
            <div class="news-block w-100">
                <div class="news-header w-100 flex-center-between">
                    <div class="left">
                        <p>Tin tức &amp; Sự kiện</p>
                    </div>
                    <div class="right">
                        <a class="right-view-all" href="/blogs/news" aria-label="Xem thêm" title="Xem thêm">
                            Xem tất cả
                        </a>
                    </div>
                </div>
                <div class="news-content w-100">
                    <div class="news-content__block">
                        <div class="s-wrap" id="slide-1" data-autoplay="0" data-nav="1" data-dot="0">
                            <div class="s-content">
                                {%- assign home_blog = blogs['news'] | default: blogs.first -%}
                                {%- if home_blog and home_blog.articles.size > 0 -%}
                                  {%- for article in home_blog.articles limit: 4 -%}
                                    <div class="item article-item">
                                        <div class="article-item__thumbnail">
                                            <a title="{{ article.title }}" aria-label="{{ article.title }}" href="{{ article.url }}">
                                                <div class="thumbnail-item">
                                                    <img loading="eager" src="{% if article.image %}{{ article.image.src }}{% else %}{{ 'logo.png' | asset_url }}{% endif %}" alt="{{ article.title | escape }}" width="333" height="190" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
                                                </div>
                                            </a>
                                        </div>
                                        <div class="article-item__content">
                                            <div class="category">
                                                <a title="{{ home_blog.title }}" aria-label="{{ home_blog.title }}" href="{{ home_blog.url }}">
                                                    {{ home_blog.title }}
                                                </a>
                                            </div>
                                            <h3 class="name">
                                                <a title="{{ article.title }}" aria-label="{{ article.title }}" href="{{ article.url }}">{{ article.title }}</a>
                                            </h3>
                                            <p>{{ article.content | strip_html | truncatewords: 35 }}</p>
                                        </div>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}
                                                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </section>