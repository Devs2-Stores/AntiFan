<section class="accessory">
<style>
@media (min-width: 992px) {
  section.accessory {
    line-height: normal !important;
  }
  section.accessory p {
    margin: 0 !important;
  }
  .accessory-block {
    padding: 20px 0 !important;
  }
  .accessory-header {
    height: 37px !important;
    margin-bottom: 20px !important;
    padding: 0 20px !important;
  }
  .accessory-content {
    height: 254px !important;
  }
  .accessory-content__item {
    height: 107px !important;
    box-sizing: border-box !important;
  }
}
</style>
            <div class="container container-fuild">
            <div class="accessory-block w-100">
                <div class="accessory-header w-100 flex-center-between">
                    <div class="left">
                        <p>Phụ kiện chính hãng</p>
                    </div>
                    <div class="right">
                        <ul>
                            <li class="active" data-accessory-tab="0">
                                <a href="javascript:;" aria-label="Phụ kiện tủ điện">Phụ kiện tủ điện</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="accessory-content">
                    <div class="accessory-content__block" data-accessory-panel="0">
                        <div class="accessory-content__list flex">
                            {%- assign acc1 = collections['phu-tro'] -%}
                            {%- if acc1 -%}
                            <div class="accessory-content__item">
                                <div class="thumbnail">
                                    <img loading="eager" src="{{ acc1.products.first.featured_image.src | product_img_url: 'medium' }}" alt="{{ acc1.title | escape }}" width="86" height="92" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
                                </div>
                                <div class="content">
                                    <h3>
                                        <a href="{{ acc1.url }}" title="{{ acc1.title | escape }}" aria-label="{{ acc1.title | escape }}">{{ acc1.title }}</a>
                                    </h3>
                                    {%- if acc1.description != blank -%}
                                    <p>{{ acc1.description | strip_html | truncatewords: 35 }}</p>
                                    {%- endif -%}
                                </div>
                            </div>
                            {%- endif -%}
