{%unless has_heading%}
<link rel="preload" href="{{ 'll-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{%endunless%}
<link rel="preload" href="{{ 'll-index-col-tab-2.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'll-index-col-tab-2.scss.css' | asset_url }}">
{%comment%}
<link href="{{ 'll-index-col-tab-2.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'll-index-col-tab-2.js' | asset_url }}"></script>
{%endcomment%}


<section class="loomline-index-col-tab-2">
  <div class="container">
    <div class="collection-tab">
			{%assign title_html = ''%}
			{%assign detail_html = ''%}
			{%for i in (1..3)%}
			{%capture show%}show_loomline_index_collection_tab2_{{i}}{%endcapture%}
			{%capture title%}loomline_index_collection_tab2_{{i}}_title{%endcapture%}
			{%capture handle%}loomline_index_collection_tab2_{{i}}_handle{%endcapture%}
			{%if settings[show]%}
			{%capture title_item%}<li class="title" data-id="col-tab2-{{i}}" data-handle="{{settings[handle]}}"><span setting-id="{{ title }}" setting-type="text" class="hrv-cf-{{ title }}">{{settings[title]}}</span></li>{%endcapture%}
			{%capture detail_item%}
        <div class="detail" id="col-tab2-{{i}}">
        <div class="row list-pro">
        {% for i in (1..4) %}
          <div class="pro-loading loading-mask">
            <div class="loading-mask__image">
              <div class="mask-line lazy-img"></div>
            </div>
            <div class="loading-mask__detail">
              <div class="mask-line"></div>
              <div class="mask-line"></div>
              <div class="mask-line"></div>
            </div>
          </div>
        {% endfor %}
          </div>
      </div>
      {%endcapture%}

			{%assign title_html = title_html | append: title_item %}
			{%assign detail_html = detail_html | append: detail_item %}
			{%endif%}
			{%endfor%}

			<div class="tab-title">
				<ul class="list-title">
					{{title_html}}
				</ul>
        {% if settings.loomline_index_collection_tab2_btn != '' %}
        <div class="btn-more">
        	<a href="{{settings.loomline_index_collection_tab2_link}}" class="btn-link hrv-cf-loomline_index_collection_tab2_btn" setting-id="loomline_index_collection_tab2_btn" setting-type="text">{{settings.loomline_index_collection_tab2_btn}}</a>
        </div>
        {%endif%}
			</div>
			<div class="tab-detail">
				{{detail_html}}
			</div>
		</div>
  </div>
</section>


