<link rel="preload" href="{{ 'modal-pricezero.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'modal-pricezero.scss.css' | asset_url }}">
<div id="modal-pricezero-contact" class="modal fade modal-pricezero-contact loomline-modal-contactform" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" setting-id="prod_pricezero_title" setting-type="text">{{settings.prod_pricezero_title}}<span class="title-pro"></span></h4>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512.001 512.001"><g><path d="M294.111,256.001L504.109,46.003c10.523-10.524,10.523-27.586,0-38.109c-10.524-10.524-27.587-10.524-38.11,0L256,217.892    L46.002,7.894c-10.524-10.524-27.586-10.524-38.109,0s-10.524,27.586,0,38.109l209.998,209.998L7.893,465.999    c-10.524,10.524-10.524,27.586,0,38.109c10.524,10.524,27.586,10.523,38.109,0L256,294.11l209.997,209.998    c10.524,10.524,27.587,10.523,38.11,0c10.523-10.524,10.523-27.586,0-38.109L294.111,256.001z"></path></g>	</svg>
					</span>
				</button>
			</div>
			<div class="modal-body loomline-body-popupform"> 
				{%- capture formContactSharing -%}
				{%- form 'contact' -%}
				<div class="row">
					{%- if form.errors -%}
					<div class="d-none alert-error alert-error-popupform">
						{%- for field in form.errors -%}
						{{ field }} {{ form.errors.messages[field] }}
						{%- endfor -%} 
					</div>
					{%- endif -%}
					<div class="col-12">
						<div class="input-group mb-3">
							<input required type="text" class="form-control" id="yourname" name="contact[name]" data-valid="yourname" placeholder="Tên của bạn" aria-label="Tên của bạn">
  						<div class="yourname-validation modal-error"></div>
            </div>
					</div>
					<div class="col-12">
						<div class="input-group mb-3">
							<input required type="email" class="form-control" id="youremail" name="contact[email]" data-valid="youremail" placeholder="Email của bạn" aria-label="Email của bạn">
  						<div class="youremail-validation modal-error"></div>
            </div>
					</div>
					<div class="col-12">
						<div class="input-group mb-3">
							<input required maxlength="18" type="text" id="yourphone"  name="contact[phone]" data-valid="yourphone" class="form-control" placeholder="Số điện thoại của bạn" aria-label="Số điện thoại của bạn">
  						<div class="yourphone-validation modal-error"></div>
            </div>
					</div>
					<div class="col-12">
						<div class="input-group mb-3">
							<textarea required placeholder="Nội dung" class="form-control" id="yourinfor" name="contact[body]" data-valid="yourinfor" rows="3" aria-label="Nội dung"></textarea>
  						<div class="yourinfor-validation modal-error"></div>
            </div>
            <input type="hidden" id="yourpro" value="" />
					</div>
					<div class="col-12">
						<div class="sitebox-recaptcha mb-3">
							This site is protected by reCAPTCHA and the Google
							<a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
							and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
						</div>
					</div>
					<div class="col-12 loomline-btn">
						<button class="loomline-btnSubmit-modal btn-disabled" id="btn-pricezero" disabled>Gửi cho chúng tôi</button>
					</div>
				</div>
				{%- endform -%}
				{%- endcapture -%}
				{{ formContactSharing | replace: 'script', 'noscript' | replace:'noscript src=', 'noscript data-src=' }}
			</div>
		</div>
	</div>
</div>

<script>
  function checkEmpty(obj) {
			var name = $(obj).attr("data-valid");

			$("."+name+"-validation").html("");
			$(obj).css("border-bottom","");

			if($(obj).val() == "" || $(obj).val() == 'null' || $(obj).val() == null  || $(obj).val() == 'undefined'  || $(obj).val() == undefined) {
				$(obj).css("border-bottom","#FF0000 1px solid");
				$("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}
			return true;
		}
		function checkEmail(obj) {
			var result_ph = true;

			var name = $(obj).attr("data-valid");
			$("."+name+"-validation").html("");
			$(obj).css("border-bottom","");

			result_ph = checkEmpty(obj);

			if(!result_ph) {
				$(obj).css("border-bottom","#FF0000 1px solid");
				$("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}

			var email_regex = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
			result_ph = email_regex.test($(obj).val());

			if(!result_ph) {
				$(obj).css("border-bottom","#FF0000 1px solid");
				$("."+name+"-validation").html("Địa chỉ Email không hợp lệ");
				return false;
			}

			return result_ph;
		}
		function checkPhone(obj) {
			var result = true;

			var name = $(obj).attr("data-valid");
			$("."+name+"-validation").html("");
			$(obj).css("border-bottom","");

			result = checkEmpty(obj);

			if(!result) {
				$(obj).css("border-bottom","#FF0000 1px solid");
				$("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}

			var phone_regex = /(^0[2-9]\d{8}$)|(^01\d{9}$)/;
			result = phone_regex.test($(obj).val());

			if(!result) {
				$(obj).css("border-bottom","#FF0000 1px solid");
				$("."+name+"-validation").html("Số điện thoại không hợp lệ");
				return false;
			}

			return result;
		}
    var valid = false;
		function validate(){
			var name = $('#modal-pricezero-contact #yourname').val();
			var phone = $('#modal-pricezero-contact #yourphone').val();
			var email = $('#modal-pricezero-contact #youremail').val();
      var body = $('#modal-pricezero-contact #yourinfor').val();
			
			//debugger;
			if(name != '' && name != null && body != '' && body != null && checkPhone($("#modal-pricezero-contact #yourphone")) && checkEmail($("#modal-pricezero-contact #youremail"))){
				valid = true;
				//valid = valid && checkPhone($("#modal-pricezero-contact #yourphone"));
			}
			else{
				valid = false;
			}
			if(valid == true){
				$("#btn-pricezero").removeClass('btn-disabled').attr("disabled",false);
			}
			else{
				$("#btn-pricezero").addClass('btn-disabled').attr("disabled",true);
			}
		}
    
		$('#modal-pricezero-contact #yourname').on('change keyup blur',function(){
			checkEmpty($('#modal-pricezero-contact #yourname'));
      validate();
		})
    $('#modal-pricezero-contact #yourinfor').on('change keyup blur',function(){
			checkEmpty($('#modal-pricezero-contact #yourinfor'));
      validate();
		})
		$('#modal-pricezero-contact #yourphone').on('change keyup blur',function(){
			checkPhone($(this));
      validate();
		})
		$('#modal-pricezero-contact #youremail').on('change keyup blur',function(){
			checkEmail($(this));
      validate();
		})
  $('body').on('click','.loomline-btn-prozero-form',function(){
    var urls = $(this).attr('data-url');
    $.ajax({
      url: urls + '?view=modal-pricezero',					
      type: 'GET',
      async: false,
      success:function(data){
        $('#modal-pricezero-contact .title-pro').html(': ' + data);
        $('#yourpro').val(data);
        $('#modal-pricezero-contact').modal('show');
      }
    });
  });
  $('#modal-pricezero-contact form.contact-form #btn-pricezero').click(function(e){
    e.preventDefault();
				const self = $(this).parents('form');
        let namee = self.find("#yourname").val(),
        phonee = self.find("#yourphone").val(),
        emaill = self.find("#youremail").val(),
        message = self.find("#yourinfor").val();
        message += "\nSản phẩm: " + self.find("#yourpro").val();
       grecaptcha.ready(function() {
         grecaptcha.execute('6LchSLkqAAAAABVHBpeFgg8N-WgkYsr5fO6GUF_s', {action: 'submit'}).then(function(token) {
           self.find('input[name="g-recaptcha-response"]').val(token);
            $.ajax({
             type: 'POST',
             url:'/contact',
             data: "form_type=contact&__RequestVerificationToken="+self.find('input[name="__RequestVerificationToken"]').val()+"&utf8=✓&contact[name]="+namee+"&contact[phone]="+phonee+"&contact[email]="+emaill+"&contact[body]="+message+"&g-recaptcha-response="+self.find('input[name="g-recaptcha-response"]').val(),
             success:function(data){
               self.trigger("reset");
                 $('#modal-pricezero-contact').modal('hide');
               swal({
										icon: "success",
										className: "loomline-form-success",
										title: "Thành công!",
										text: "Chúng tôi sẽ liên hệ trong thời gian sớm nhất.",
										button: false,
										timer: 5000,
									}).then((result) => {
										//location.reload(); 
									});
             }
           })
         })
       })
			});
</script>

