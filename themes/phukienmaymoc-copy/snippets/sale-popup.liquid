<link rel="preload" href="{{ 'sale-popup.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'sale-popup.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'sale-popup.js' | asset_url }}"></script>
<div id="fake-order-popup">
  <div class="popup-content">
    <img id="popup-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="">
    <div class="popup-text">
      <p><strong id="popup-name"></strong> vừa mua</p>
      <p id="popup-product"></p>
      <span id="popup-time"></span>
    </div>
  </div>
</div>
<script>
  var haravanProducts = [
    {% for product in collections[settings.sale_popup_collection_picker].products limit: 20 %}
      {
        name: "{{ product.title }}",
        img: "{{ product.featured_image | img_url: 'small' }}",
        url: "{{ product.url }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>