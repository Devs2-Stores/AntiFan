{% comment %}
  ==============================================================================
  SERVER-SIDE FAQ + HOWTO SCHEMA PARSER — v4.0.0
  Fix v4: Bao IIFE trong DOMContentLoaded — trước đó querySelectorAll chạy khi DOM chưa ready
  ==============================================================================

  CÚ PHÁP cho tác giả nội dung:

  FAQ Block:
  <div class="seo-faq">
    <div class="seo-faq-item">
      <div class="seo-faq-question">Câu hỏi?</div>
      <div class="seo-faq-answer">Câu trả lời đầy đủ.</div>
    </div>
  </div>

  HowTo Block:
  <div class="seo-howto"
       data-name="Tiêu đề hướng dẫn"
       data-description="Mô tả ngắn"
       data-total-time="PT30M">
    <div class="seo-howto-step">
      <div class="seo-howto-step-name">Bước 1: Tên bước</div>
      <div class="seo-howto-step-text">Mô tả chi tiết bước này.</div>
    </div>
    <div class="seo-howto-step">
      <div class="seo-howto-step-name">Bước 2: Tên bước</div>
      <div class="seo-howto-step-text">Mô tả chi tiết bước này.</div>
    </div>
  </div>

  ISO 8601 Duration: PT30M = 30 phút, PT2H = 2 giờ, P1D = 1 ngày
  ==============================================================================
{% endcomment %}

{% if template contains 'article' %}
  {% assign seo_content_check = article.content %}
{% elsif template contains 'page' %}
  {% assign seo_content_check = page.content %}
{% else %}
  {% assign seo_content_check = '' %}
{% endif %}

{% comment %} --- FAQ Schema --- {% endcomment %}
{% if seo_content_check contains 'seo-faq-item' %}
<script type="application/ld+json" id="seo-faqpage-schema">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": []
}
</script>
<script>
(function() {
  function initFAQ() {
    var faqItems = [];
    document.querySelectorAll('.seo-faq-item').forEach(function(item) {
      var q = item.querySelector('.seo-faq-question');
      var a = item.querySelector('.seo-faq-answer');
      if (q && a && q.textContent.trim().length > 3 && a.textContent.trim().length > 5) {
        faqItems.push({
          "@type": "Question",
          "name": q.textContent.trim(),
          "acceptedAnswer": { "@type": "Answer", "text": a.textContent.trim() }
        });
      }
    });
    if (faqItems.length > 0) {
      var el = document.getElementById('seo-faqpage-schema');
      if (el) {
        var schema = JSON.parse(el.textContent);
        schema.mainEntity = faqItems;
        el.textContent = JSON.stringify(schema);
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQ);
  } else {
    initFAQ();
  }
})();
</script>
{% endif %}

{% comment %} --- HowTo Schema --- {% endcomment %}
{% if seo_content_check contains 'seo-howto-step' %}
<script type="application/ld+json" id="seo-howto-schema">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "",
  "step": []
}
</script>
<script>
(function() {
  function initHowTo() {
    var howtoEl = document.querySelector('.seo-howto');
    if (!howtoEl) return;
    var steps = [];
    var position = 1;
    howtoEl.querySelectorAll('.seo-howto-step').forEach(function(step) {
      var nameEl = step.querySelector('.seo-howto-step-name');
      var textEl = step.querySelector('.seo-howto-step-text');
      if (nameEl && textEl) {
        steps.push({
          "@type": "HowToStep",
          "position": position++,
          "name": nameEl.textContent.trim(),
          "text": textEl.textContent.trim()
        });
      }
    });
    if (steps.length > 0) {
      var schemaEl = document.getElementById('seo-howto-schema');
      if (schemaEl) {
        var schema = JSON.parse(schemaEl.textContent);
        var h1 = document.querySelector('h1');
        schema.name        = howtoEl.dataset.name        || (h1 ? h1.textContent.trim() : '');
        schema.description = howtoEl.dataset.description || '';
        schema.totalTime   = howtoEl.dataset.totalTime   || '';
        schema.step        = steps;
        if (!schema.totalTime)   delete schema.totalTime;
        if (!schema.description) delete schema.description;
        schemaEl.textContent = JSON.stringify(schema);
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHowTo);
  } else {
    initHowTo();
  }
})();
</script>
{% endif %}
