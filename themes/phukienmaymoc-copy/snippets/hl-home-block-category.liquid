<style>
@media (max-width: 991px) {
  .block-category {
    margin-bottom: 24px !important;
  }
  .block-category__item {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
  }
  .block-category__left {
    display: none !important;
  }
  .block-category__top-mobile {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 10px 0 !important;
    margin-bottom: 10px !important;
    border-bottom: 2px solid #3590ce !important;
    width: 100% !important;
  }
  .block-category__top-mobile h2 {
    font-size: 17px !important;
    font-weight: 700 !important;
    color: #22343e !important;
    margin: 0 !important;
    text-transform: uppercase !important;
  }
  .block-category__top-mobile a {
    font-size: 13px !important;
    color: #3590ce !important;
    text-decoration: none !important;
    font-weight: 500 !important;
  }
  .block-category .product-list {
    width: 100% !important;
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }
  .block-category .product-list > div {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    background: #fff !important;
    border-radius: 8px !important;
    border: 1px solid #e2e8f0 !important;
    padding: 8px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }
  .block-category .product-list .thumbnail img {
    width: 100% !important;
    height: 120px !important;
    object-fit: contain !important;
  }
  .block-category .product-list .content h3 {
    font-size: 13px !important;
    line-height: 17px !important;
    height: 34px !important;
    overflow: hidden !important;
    margin: 6px 0 !important;
  }
  .block-category .product-list .content h3 a {
    color: #22343e !important;
    text-decoration: none !important;
  }
  .block-category .product-list .content-description {
    display: none !important;
  }
  .block-category .product-list .price {
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #e51818 !important;
    margin-top: 4px !important;
  }
}
@media (min-width: 992px) {
  .block-category__top-mobile {
    display: none !important;
  }
}
</style>
<section class="block-category">
                    {%- assign blk = collections['contactor'] -%}
                    <div class="container container-fuild">
                        <div class="block-category__top-mobile">
                            <h2>{{ blk.title }}</h2>
                            <a href="{{ blk.url }}" title="{{ blk.title }}">Xem tất cả &gt;</a>
                        </div>
                        <div class="block-category__item flex w-100">
                            <div class="block-category__left">

                                <div class="thumbnail-item text-center">
    <img loading="eager" src="{{ blk.products.first.featured_image.src | product_img_url: 'medium' }}" alt="{{ blk.title | escape }}" width="173" height="232" onerror="this.onerror=null; this.src='{{ 'default_image.png.webp' | asset_url }}';">
</div>
                                <div class="left-content">
                                    <h2>{{ blk.title }}</h2>
                                    <a href="{{ blk.url }}" title="{{ blk.title }}" aria-label="Xem thêm">
                                        Xem thêm
                                    </a>
                                </div>
                            </div>
                            <div class="product-list flex">
                                {%- if blk and blk.products.size > 0 -%}
                                  {%- for product in blk.products limit: 5 -%}
                                    <div class="product-list__item">
                                      <div class="thumbnail">
                                        <a href="{{ product.url }}" title="{{ product.title }}" aria-label="{{ product.title }}">
                                          <div class="thumbnail-item">
                                            <img loading="lazy" src="{{ product.featured_image.src | img_url: 'medium' }}" alt="{{ product.title | escape }}" title="{{ product.title }}" width="172" height="155" onerror="this.onerror=null; this.src='{{ 'no_image.jpg' | asset_url }}';">
                                          </div>
                                        </a>
                                      </div>
                                      <div class="content">
                                        <h3 class="text-bold">
                                          <a href="{{ product.url }}" title="{{ product.title }}" aria-label="{{ product.title }}">{{ product.title }}</a>
                                        </h3>
                                        <div class="price flex-left-between">
                                          <div class="left">
                                            {% if product.variants.first.price == 0 %}
                                              <a href="{{ settings.prod_pricezero_link }}" class="f-initial hrv-cf-prod_pricezero_title" setting-id="prod_pricezero_title" setting-type="text"><span>{{ settings.prod_pricezero_title }}</span></a>
                                            {% else %}
                                              <p>{{ product.variants.first.price | money }}</p>
                                            {% endif %}
                                          </div>
                                          <div class="right">
                                            {% if product.variants.first.compare_at_price > product.variants.first.price and product.variants.first.price > 0 %}
                                              <span class="percent">-{{ product.variants.first.compare_at_price | minus: product.variants.first.price | times: 100 | divided_by: product.variants.first.compare_at_price | round: 0 }}%</span>
                                            {% endif %}
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  {%- endfor -%}
                                {%- else -%}
                                  <div class="collection-alert-no"><p>Chưa có sản phẩm nào trong danh mục này</p></div>
                                {%- endif -%}
                            </div>
                        </div>
                    </div>
                </section>
