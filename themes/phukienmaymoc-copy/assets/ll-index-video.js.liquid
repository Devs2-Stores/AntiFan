Loomline.IndexVideoTab = {
		init: function() {
			var that = this;
      that.Loomline_IndexVideoTab();
      that.Loomline_IndexVideoTabMb();
      that.Loomline_IndexVideoClick();
		},
  Loomline_IndexVideoTab: function(){
		$('.loomline-index-video .video-item').each(function(){
      const $this = $(this);
      let handle =  $this.attr('data-handle');
      if(handle != '' && handle != undefined){
        $.ajax({
          url: '/products/'+ handle + '?view=pro-video',					
          type: 'GET',
          async: false,
          success:function(data){
           $this.find('.item-pro').html(data);
          }
        });
      }
    });
	},
  Loomline_IndexVideoTabMb: function(){
    $('.loomline-index-video .nav-tabs a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
        var currentTab = $(e.target); 
        var value = currentTab.find('.title').text();
    
        $('.loomline-index-video .tab-mb .title-mb').text(value);
    });
  },
  Loomline_IndexVideoClick: function(){
    $('.heading-mb').click(function(){
      $(this).parents('.tab-mb').toggleClass('opened');
    })
		$(document).on('click', function (event) {
			var class_name = event.target.className;
			if(class_name == 'title-mb' || class_name == 'heading-mb'){}
			else{
        $('.tab-mb').removeClass('opened');
				/*if (!$(event.target).closest('.nav-tabs').length) {
					$('.tab-mb').removeClass('opened');
				}*/
			}
		})
	},
};
(function() {
  Loomline.IndexVideoTab.init();
})();





