	}
}
.hrlyt-coupons{
	&-list{}
	&-item{
		margin-bottom:30px;
		.coupons__inner{
			position: relative;display: -ms-flexbox;display: flex;height: 100%;padding:0px;
			background-color: #fef1f3;border: 0.5px solid #fecfd5;  	border-radius: 8px;
		}
