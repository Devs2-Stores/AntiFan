.customers-details__membership{margin-bottom:0px;padding: 25px 20px;}
.customers-details__membership.lowlight{background: #f6f6f6;border: 1px solid #f5f5f5;border-top:0;border-radius:0 0 4px 4px;}
.customers-details__membership .membership-link{font-weight: 500;margin:20px 0 0px;}
