.sidebox-account{
	&--member{margin-bottom:30px;}
	.member-avartar span {
		display: block; width: 95px;height: 95px;line-height:90px;overflow: hidden;
		border-radius: 50%;margin: auto; text-align: center; 
		color: #ffffff;font-size:46px;font-weight:700;text-transform: uppercase;
		border: 4px solid #FFFFFF;
		box-shadow: 0px 8px 28px -6px rgba(24, 39, 75, 0.12), 0px 18px 88px -4px rgba(24, 39, 75, 0.14);
	}
