				content:"";
				position: absolute; width: 20px; height:10px;  right: -10px;
				background: #ffffff;border: 0.5px solid #fecfd5;
			}
			&:before{top: -1px; border-top: 0;border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;}
			&:after{bottom: -1px; border-bottom: 0;border-top-left-radius: 20px; border-top-right-radius: 20px;}
			img{border-radius:6px;}
			svg{width:100%;}
		}
