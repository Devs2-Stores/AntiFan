/* Setting màu cover màu sắc */
{%- for i in (1..6) -%}
{%- capture member_name -%}membercard_{{i}}_name{%- endcapture -%}
{%- capture member_color -%}membercard_{{i}}_color{%- endcapture -%}
{%- capture member_use -%}membercard_{{i}}_use{%- endcapture -%}
{%- capture member_cover -%}membercard_{{i}}_cover.jpg{%- endcapture -%}
{%- assign set_member_name = settings[member_name] | downcase  -%}
{%- if settings[member_name] != blank -%}
{% if settings[member_color] != empty %}
.membership-card[data-rank="{{ set_member_name }}"] {background-color:{{ settings[member_color] }};}
{% endif %}
{%- if settings[member_use] -%}
.membership-card[data-rank="{{ set_member_name }}"] {
	background-image:url("{{ settings[member_cover] }}");
	background-repeat: no-repeat;background-position: center;background-size: cover;
}
{%- endif -%}
{%- endif -%}
{%- endfor -%}

@media(max-width: 767px){
	.customers-details__membership{padding: 20px 0px;}
	.customers-details__membership.lowlight{padding:0 0 10px;background: transparent;border: 0;}
	.customers-details__membership.lowlight .membership-left{padding:18px 15px;background: #f6f6f6;border: 1px solid #f5f5f5;}
}