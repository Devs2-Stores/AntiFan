					svg{width:10px;height:100%;}
				}
			}
			.mdl-coupon--text + .mdl-coupon--text{border-top: 1px solid #ebebeb;}
			.mdl-coupon--ctas{
				padding:15px 0 10px;
				.cta-modal{
					display: block;
					width: 100%;
					border: 0;
					padding: 10px 15px;
					background: #ef4343;
					border-radius: 5px;
					color: #ffffff;
					text-transform: uppercase;
				}

			}
