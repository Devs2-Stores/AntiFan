:root {
  --time: {{ settings.loomline_about_us_marquee_time }}s;
}
$colorMarquee: {{ settings.loomline_about_us_marquee_color }};
$colorFaqs: {{ settings.loomline_about_us_faqs_color }};
$bgFaqs: {{ settings.loomline_about_us_faqs_bg_color }};
@keyframes about-us-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
.loomline-layout-about {
  /* 2.2 - Breadcrumb */
  .breadcrumb-shop {
    padding: 0;
    border-bottom: 1px solid #dfe2e6;
    border-top: 1px solid #dfe2e6;
  }
  .breadcrumb-paralax {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 0;
    margin-bottom: 40px;
    background-color: #fafafa;
  }
  .breadcrumb-list {
    & {
      overflow: hidden;
    }
    .breadcrumb-arrows {
      padding: 10px 0;
      background: transparent;
      border-radius: 0;
      margin: 0;
      list-style: none;
    }
    .breadcrumb-arrows > li {
      display: inline-block;
    }
    .breadcrumb-arrows > li + li:before {
      padding: 0 3px;
      margin-left: 5px;
      color: #ccc;
      font-family: 'FontAwesome';
      content: "/\00a0";
    }
    @media(max-width: 767px) {
      .breadcrumb-arrows {
        padding: 7px 0;
        font-size: 12px;
        display: block;
        white-space: nowrap;
        overflow: scroll;
      }
      .breadcrumb-arrows > li + li:before {
        padding: 0 2px;
      }
      .breadcrumb-arrows::-webkit-scrollbar {
        display: none;
      }
      .breadcrumb-arrows {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    }
  }
}

.loomline-about-us-about-1 {
  padding: 80px 0 0;
  .heading-title {
    max-width: 610px;
    margin: 0 auto 50px;
    .title2 {
      font-size: 48px;
    }
    .desc {
      font-size: 20px;
    }
  }

  @media(max-width: 767px) {
    padding: 40px 0;
    .heading-title {
      margin-bottom: 30px;
      padding: 0 15px;
      .title2 {
        font-size: 30px;
      }
      .desc {
        font-size: 16px;
      }
    }
  }
}
.loomline-about-us-about-2 {
  padding: 80px 0;
  .about-content {
    max-width: 950px;
    margin: 0 auto;
    .heading-title {
      margin: 0;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
  }
}
.loomline-about-us-about-3,
.loomline-about-us-about-4 {
  .heading-title {
    margin: 0;
  }
  .about-banner {
    img {
      border-radius: 20px;
    }
  }
  @media(min-width: 1200px) {
    .about-content {
      padding: 0 50px;
    }
  }
  @media(max-width: 991px) {
    .row {
      gap: 30px;
    }
  }
  @media(max-width: 767px) {
    .about-banner {
      img {
        border-radius: 10px;
      }
    }
  }
}
.loomline-about-us-about-4 {
  padding-bottom: 80px;
  @media(max-width: 767px) {
    padding-bottom: 40px;
  }
}
.loomline-about-us-marquee {
  padding: 80px 0;
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    color: $colorMarquee;
    &__inner {
      display: inline-flex;
      gap: 60px;
      animation: about-us-marquee var(--time) linear infinite;
      &--item {
        display: inline-block;
        font-size: 60px;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 1.5;
        .icon {
          margin-left: 40px;
          svg {
            fill: currentcolor;
          }
        }
      };

       &:hover {
        animation-play-state: paused;
      }
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .marquee__inner {
      gap: 30px;
      &--item {
        font-size: 35px;
        .icon {
          margin-left: 20px;
          svg {
            width: 20px;
            height: 20px;
          }
        }
      }
    }
  }
}

.loomline-about-us-faqs {
  background: $bgFaqs;
  color: $colorFaqs;
  .container-fluid {
    padding: 0;
  }
  .faqs-banner {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    img {
      transition: all 0.5s;
      border-radius: 20px;
    }
     &:hover {
      img {
        transform: scale(1.08);
      }
    }
  }
  .list-faqs {
    .faq-item {
      transition: all 0.3s;
       &:not(:last-child) {
        margin-bottom: 15px;
      }
      .header-faqs {
        font-size: 20px;
        font-weight: 600;
        padding: 20px 20px 20px 0;
        position: relative;
        cursor: pointer;
        border-bottom: 1px solid color-mix(in srgb, {{ settings.loomline_about_us_faqs_color }} 10%, transparent);
         &:before {
          content: '';
          position: absolute;
          top: calc(50% - 10px);
          right: 0;
          width: 20px;
          height: 20px;
          background: $colorFaqs;
          -webkit-mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cpath id='primary' d='M5, 12H19M12, 5V19' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/path%3E%3C/svg%3E") center / contain;
          mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cpath id='primary' d='M5, 12H19M12, 5V19' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/path%3E%3C/svg%3E") center / contain;
          mask-repeat: no-repeat;
          transition: all 0.3s;
        }
      }
      .content-faqs {
        display: none;
        .desc {
          padding-top: 15px;
        }
      }
      &.opened {
        .header-faqs {
          border-color: $colorFaqs;
           &:before {
            -webkit-mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cline id='primary' x1='19' y1='12' x2='5' y2='12' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/line%3E%3C/svg%3E") center / contain;
            mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cline id='primary' x1='19' y1='12' x2='5' y2='12' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/line%3E%3C/svg%3E") center / contain;
          }
        }

      }
    }
  }
  @media(min-width: 1200px) {
    .faqs-content {
      padding: 0 100px;
    }
  }
  @media(max-width: 991px) {
    .row {
      margin: 0;
      gap: 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .faqs-banner {
      border-radius: 10px;
      img {
        border-radius: 10px;
      }
    }
  }
}