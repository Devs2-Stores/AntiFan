  }
  h1 {
    font-size: 58px;
    margin-bottom: 25px;
  }
 .banner-content{
    padding: 90px 0;
    &.has-bg{
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.2);
