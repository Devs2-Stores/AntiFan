.hidden{display: none !important;}
/* 2.2 - Breadcrumb */  
.breadcrumb-shop{
	border-bottom: 1px solid #dfe2e6;
	border-top: 1px solid #dfe2e6;
  strong{
    font-weight: 400;
  }
}
.breadcrumb-paralax{
	position: relative;overflow: hidden;text-align: center;padding:0px 0;margin-bottom: 40px;
	background-color:#fafafa;
}
.breadcrumb-list{
	&{overflow: hidden;}
	.breadcrumb-arrows {padding:10px 0;background: transparent;border-radius: 0;margin: 0;list-style: none;}
	.breadcrumb-arrows>li{ display: inline-block;}
	.breadcrumb-arrows>li+li:before {	padding: 0 3px;margin-left:5px;color:#ccc;font-family: 'FontAwesome';content: "/\00a0";}
	@media(max-width:767px){
		.breadcrumb-arrows { padding:7px 0;font-size:13px;display: block;white-space: nowrap;overflow: scroll;}
		.breadcrumb-arrows>li+li:before {	padding: 0 2px;}
		.breadcrumb-arrows::-webkit-scrollbar {display: none;}
		.breadcrumb-arrows{-ms-overflow-style: none;scrollbar-width: none;}
	}
}
.layout-pageProduct .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    color: #fff;
    background-color: #202223;
    border: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
      }
       &:hover:before,
       &.has-hover:before,
       &:focus:before {
        opacity: 1;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 12px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

#btn-scroll{
	scroll-margin-block-start: 150px;
	@media(max-width: 767px){
		scroll-margin-block-start: 70px;
	}
}
.section-breadcrumb {
  position: relative;
   {% if settings.loomline_product_bg_color != empty %}
   background: {{settings.loomline_product_bg_color}};
   {% endif %}
  {% if settings.loomline_product_color != empty %}
  color: {{settings.loomline_product_color}};
  {% endif %}
