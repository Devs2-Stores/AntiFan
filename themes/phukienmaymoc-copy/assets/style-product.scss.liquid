		}
	}
	.qty-btn {
		float: left;
		background: none;
		/*border: 1px solid #f3f4f4;*/
    border: none;
		cursor: pointer;
		font-weight: 600;
		font-size: 16px;
		outline: none;
		height: 40px;
		line-height: 40px;
		width: 40px;
		text-align: center;
		border-radius: 0;
		outline: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		-o-appearance: none;
		appearance: none;
		svg {
			display: block;
			width: 12px;
			height: 100%;
			margin: 0 auto;
			fill: currentcolor;
			transition: all 0.2s ease-in-out;
		}
		&:hover svg {
			fill: #000;
		}
	}
	@media(min-width: 992px) {
		.container {
			max-width: 1350px;
		}
		.sticky-atc__btn .btn-buy-sticky {
			min-width: 220px;
		}
		.check-action-tt {
			padding: 0 15px;
      color: red;
      font-weight: 500;
      margin: 0;
      font-size: 14px;
		}
	}
	@media(max-width: 991px) {
		min-height: 50px; /* *transform: translateY(0);* */
		.sticky-atc {
			flex-direction: column;
		}
		.sticky-atc__img {
			.prod-img,
			.prod-info .prod-info__reviews {
				display: none;
			}
			.prod-info {
				margin-left: 0;
			}
			.prod-info__price {
				margin-top: 5px;
			}

		}
		.sticky-atc__action {
			padding: 7px 0;
			width: 100%;
		}
		.sticky-atc__vrt {
			form {
				width: 100%;
			}
		}
		.sticky-atc__btn {
			border-left: 0;
			width: 100%;
      gap: 15px;
		}
		.sticky-atc__btn .btn-quantity {
			margin: 0;
		}
		.sticky-atc__btn .btn-atc {
			flex: 1 1 auto;
			margin: 0;
		}
		.swatch {
			margin: 10px 0 0;
			&:first-child:before {
				display: none;
			}
		}
		.select-swatch {
			padding: 0;
			justify-content: space-between;
		}
		.swatch select.select-swap {
			margin: 0;
		}
		.select-swatch .header {
			display: none;
		}
	}
}
@media (max-width: 991px) {
	body.scroll-body-up .sidebar-action-bottom {
		transform: translateY(100%);
	}
}

