$colorText: {{ settings.shop_text_color }};
.loomline-index-col-slide1 {
  padding: 80px 0;
  .slide-policy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 0 40px;
    .policy-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
      border-radius: 50px;
      padding: 10px 15px;
      font-size: 14px;
      .icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
        border-radius: 50px;
        svg {
          fill: currentcolor;
        }
      }
    }
  }
  .banner-box {
    position: sticky;
    top: 90px;
    overflow: hidden;
    border-radius: 20px;
    &.has-video {
      display: flex;
    }
    img {
      border-radius: 20px;
      transition: all 0.5s;
    }
    .heading-title {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 50px 40px;
      color: var(--color);
      .btn-more {
        margin: 30px 0 0;
        .button {
          background: var(--color);
          span {
            color: var(--color);
            filter: invert(1);
          }
        }
      }
    }
    .video-box {
      display: inline-flex;
      video {
        width: 100%;
        height: auto;
      }
    }
     &:hover {
      img {
        transform: scale(1.08);
      }
    }
  }
  .col-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    > div {
      flex: 0 0 auto;
    }
    .title {
      font-size: 26px;
      margin: 0;
    }
    .heading-nav {
      display: inline-flex;
      gap: 10px;
      .swiper-nav {
        padding: 0;
        width: 48px;
        height: 48px;
        border: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
        border-radius: 50%;
        background: transparent;
        color: $colorText;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        svg {
          fill: currentcolor;
          width: 16px;
          height: 16px;
          transition: all 0.3s;
        }
         &:hover {
          background: currentcolor;
          svg {
            filter: invert(1);
          }
        }
      }
    }
  }
  .slide-col {
     &:not(:last-child) {
      margin-bottom: 30px;
    }
  }
  .btn-more {
    margin-bottom: 60px;
  }
  @media(min-width: 992px) {
    .heading-title {
      margin-bottom: 40px;
    }
  }
  @media(max-width: 991px) {
    .banner-box {
      border-radius: 10px;
      img {
        border-radius: 10px;
      }
    }
    .collection-box {
      margin-top: 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0;
    .slide-policy {
      gap: 5px;
      margin: 0 0 25px;
      .policy-item {
        gap: 5px;
        padding: 6px 8px;
        font-size: 12px;
        .icon {
          width: 22px;
          height: 22px;
          svg {
            width: 15px;
            height: 15px;
          }
        }
      }
    }
    .btn-more {
      margin-bottom: 40px;
    }
    .banner-box .heading-title{
          padding: 40px 30px;
    }
    .col-heading {
      .title{
        font-size: 20px;
      }
      .heading-nav .swiper-nav{
        width: 40px;
        height: 40px;
      }
    }
  }
}