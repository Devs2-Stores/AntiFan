Loomline.IndexSlide2ColSlider = {
		init: function() {
			var that = this;
      that.Loomline_IndexSlide2ColSlider('slide2_1');
		},
  Loomline_IndexSlide2ColSlider: function(id){
    const loomlineSlider = new Swiper ('#' + id + ' .swiper', {
      slidesPerView: 2,  
      spaceBetween: 40,
			loop: $('#' + id +  ' .pro-item').length > 1 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      //centeredSlides: true,
      autoplay: false,
      /*autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },*/
			navigation: {
				nextEl: '#' + id + ' .swiper-next',
				prevEl: '#' + id + ' .swiper-prev',
			},
      /*pagination: {
				el: ".swiper-pagination",
				clickable: true,
			},*/
      /*pagination: {
        el: ".swiper-pagination",
        clickable: 'true',
        type: 'bullets',
        renderBullet: function (index, className) {
            return '<span class="' + className + '"></span>';
          },
      
      },*/
			breakpoints: {
        0: { 
          slidesPerView: 2,
          spaceBetween: 10
        },
        768: { 
          slidesPerView: 2,
          spaceBetween: 40 
        }
      }
    });
    const totalSlides = loomlineSlider.slides.length;
    if (totalSlides <= loomlineSlider.params.slidesPerView) {
      $('#' + id + ' .swiper-next, #' + id + ' .swiper-prev').hide();
    }
  }
};
(function() {
  Loomline.IndexSlide2ColSlider.init();
})();






