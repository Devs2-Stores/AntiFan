	render_price: function(result,dtCombo){
		var price_combo = 0, dt_vrt_list = [];
		if(!dtCombo.is_apply_by_variant){
      var dt_of_combo = []
			dt_of_combo.quantity = dtCombo.quantity;
			switch (dtCombo.type){
				case 1: 
					price_combo = result.price - dtCombo.promotion_value;
					break;
				case 2:
					price_combo = result.price - (result.price * (dtCombo.promotion_value / 100));
					break;
				default:
					price_combo = dtCombo.promotion_value;
			}
			dt_of_combo.price = price_combo;
      dt_of_combo.push(dt_of_combo)
      dt_of_combo.push({
        id: result.id,
        quantity: result.qty,
        price: price_combo
      });
      return dt_of_combo
		}
		else{
      var dt_of_combo = [];
            if(!dtCombo.none_promotion) {
              $.each(dtCombo.apply_productvariants,function(i,v){
        				if(v != null){
        					var vrt = result.variants.filter(item => item.id == v.id)
                  vrt.forEach(vrt => {
          					switch (v.type){
          						case 1: 
          							price_combo = vrt.price - v.promotion_value;
          							break;
          						case 2:
          							price_combo = vrt.price - (vrt.price * (v.promotion_value/100));
          							break;
          						default:
          							price_combo = v.promotion_value;
          					}
                    dt_of_combo.push({
                      id: vrt.id,
                      quantity: v.qty,
                      price: price_combo
                    });
        					});
        				}
        			});
            }
            else {
              $.each(dtCombo.apply_productvariants,function(i,v){
              var vrt = result.variants.filter(item => item.id == v.id)
                  vrt.forEach(vrt => {
          					switch (v.type){
          						case 1: 
          							price_combo = vrt.price;
          							break;
          						case 2:
          							price_combo = vrt.price ;
          							break;
          						default:
          							price_combo = vrt.price ;
          					}
                    dt_of_combo.push({
                      id: vrt.id,
                      quantity: v.qty,
                      price: price_combo
                    });
        					});
                });
            }
         
      
      return dt_of_combo;
		}
		
	},
