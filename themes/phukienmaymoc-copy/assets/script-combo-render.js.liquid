				temp.qty = 	parseInt($(this).attr('data-quantity')) * parseInt($('#quantity').val());
				aItems.push(temp);
			});
			HRVTheme.AppCombo.addCombo(0, aItems, function(){
				//window.location = '/cart';
				Loomline.Cart.Loomline_getCartModal();
        var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div></div>';
