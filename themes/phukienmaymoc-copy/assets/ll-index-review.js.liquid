Loomline.IndexReviewSlider = {
		init: function() {
			var that = this;
      that.Loomline_IndexReviewSlider();
		},
  Loomline_IndexReviewSlider: function(){
    const loomlineSlider = new Swiper ('.loomline-index-review .swiper', {
      slidesPerView: 3.5,  
      spaceBetween: 30,
			loop: $('.loomline-index-review .review-item').length > 1 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      //centeredSlides: true,
      autoplay: false,
      /*autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },*/
			navigation: {
				nextEl: ".loomline-index-review .swiper-next",
				prevEl: ".loomline-index-review .swiper-prev",
			},
      pagination: {
        el: ".swiper-pagination",
        clickable: 'true',
        type: 'bullets',
        renderBullet: function (index, className) {
            return '<span class="' + className + '"></span>';
          },
      
      },
			breakpoints: {
        0: { 
          slidesPerView: 1.5,
          spaceBetween: 10
        },
        768: { 
          slidesPerView: 2.5,
          spaceBetween: 10 
        },
        1199: { 
          slidesPerView: 3.5,
          spaceBetween: 30 
        }
      }
    });
    const totalSlides = loomlineSlider.slides.length;
    if (totalSlides <= loomlineSlider.params.slidesPerView) {
      $('.loomline-index-review .swiper-next, .loomline-index-review .swiper-prev').hide();
    }
  }
};
(function() {
  Loomline.IndexReviewSlider.init();
})();





