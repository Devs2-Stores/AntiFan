Loomline.IndexFaqsSlider = {
		init: function() {
			var that = this;
      that.Loomline_IndexFaqsSlider();
		},
  Loomline_IndexFaqsSlider:function(){
			$('.loomline-index-faqs .header-faqs').on('click', function(){
				if(!$(this).parents('.faq-item').hasClass('opened')){ 
					$('.loomline-index-faqs .faq-item').removeClass('opened').find('.content-faqs').stop().slideUp('medium');
					$(this).parents('.faq-item').toggleClass('opened').find('.content-faqs').stop().slideToggle('medium');
				}else{
					$(this).parents('.faq-item').toggleClass('opened').find('.content-faqs').stop().slideToggle('medium');
				}
			});
		},
};
(function() {
  Loomline.IndexFaqsSlider.init();
})();






