$bgPolicy: {{ settings.loomline_index_col_slide1_1_policy_bg_color }};
$colorPolicy: {{ settings.loomline_index_col_slide1_1_policy_color }};
.loomline-index-policy {
  padding: 20px 0 80px;
  .list-policy {
    justify-content: center;
    gap: 30px;
    .policy-item {
      flex: 0 0 auto;
      width: calc(100% / 5 - 24px);
      background: $bgPolicy;
      color: $colorPolicy;
      border: 1px solid;
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      .icon {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, {{ settings.loomline_index_col_slide1_1_policy_color }} 10%, transparent);
        border-radius: 50px;
        svg {
          fill: currentcolor;
        }
      }
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0 30px;
    .list-policy {
      margin: 0;
      gap: 10px;
      .policy-item {
        width: 100%;
        font-size: 14px;
        padding: 15px;
      }
    }
  }
}