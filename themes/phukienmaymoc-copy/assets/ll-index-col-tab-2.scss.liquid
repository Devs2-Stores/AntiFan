$colorText: {{ settings.shop_text_color }};

@keyframes col_up_2 {
  from {
    transform: translateY(30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.loomline-index-col-tab-2 {
  padding: 40px 0;
  .tab-title {
    display: flex;
    gap: 30px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    .list-title {
      display: flex;
      gap: 10px 50px;
      justify-content: start;
      .title {
        font-size: 28px;
        font-weight: 600;
        opacity: 0.6;
        cursor: pointer;
        &.active,
         &:hover {
          color: $colorText;
           opacity: 1;
        }
      }
    }
  }
  .tab-detail {
    .detail {
      display: none;
      &.show {
        display: block;
      }
    }
  }
  .list-pro {
    margin: 0;
    gap: 10px;
    .pro-item {
      flex: 0 0 auto;
      width: calc(100% / 4 - 7.5px);
      padding: 10px;
      border-radius: 10px;
      background: color-mix(in srgb, {{ settings.shop_text_color }} 3%, transparent);
      opacity: 0;
      &.has-view {
        animation: col_up_2 0.5s forwards var(--time) ease-out;
      }
      &.viewed {
        opacity: 1;
      }
    }
    .pro-loading {
      flex: 0 0 auto;
      width: calc(100% / 4 - 7.5px);
      padding: 10px;
      border-radius: 10px;
      background: color-mix(in srgb, {{ settings.shop_text_color }} 3%, transparent);
    }
  }
  .animated-background {
    animation-duration: 1.25s;
    animation-fill-mode: forwards;
    animation-iteration-count: infinite;
    animation-name: placeHolderShimmer;
    animation-timing-function: linear;
    background: #F6F6F6;
    background: linear-gradient(to right, #F6F6F6 8%, #F0F0F0 18%, #F6F6F6 33%);
    background-size: 800px 104px;
    position: relative;
  }
  .loading-mask {
    background: #fbfbfb;
    border-radius: 10px;
    overflow: hidden;
    &__image {
      position: relative;
      overflow: hidden;
      width: 100%;

      .mask-line {
      @extend .animated-background;
      padding-bottom: 65%;
    }
  }
  &__detail {
    padding: 16px;
  }
  &__detail .mask-line {
    height: 10px;
    width: 100%;
    border-radius: 8px;
    margin: 4px 0;
    @extend .animated-background;
     &:nth-child(2) {
      width: 80%
    }
     &:nth-child(3) {
      width: 65%
    }
  }
}
@media(max-width: 991px) {
  .tab-title .list-title {
    gap: 10px 30px;
    .title {
      font-size: 22px;
    }
  }
  .list-pro {
    .pro-item, .pro-loading {
      width: calc(50% - 5px);
    }
  }
}
@media(max-width: 767px) {
  padding: 20px 0;
  .tab-title {
    flex-flow: wrap;
    justify-content: center;
    gap: 15px;
    .list-title {
      gap: 10px 25px;
      flex-flow: wrap;
      justify-content: center;
      .title {
        font-size: 20px;
      }
    }
  }
  .list-pro {
    .pro-item,.pro-loading {
      width: calc(50% - 5px);
    }
  }
}
}
