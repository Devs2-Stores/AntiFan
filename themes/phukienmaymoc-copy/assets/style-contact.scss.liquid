:root {
  --bg-contact-btn: {{ settings.loomline_page_contact_bg_btn_color }};
  --color-contact-btn: {{ settings.loomline_page_contact_color_btn }};
}
$colorBanner: {{ settings.loomline_contact_info_color }};
$bgForm: {{ settings.loomline_contact_form_bg_color }};
$colorForm: {{ settings.loomline_contact_form_color }};
.loomline-layout-contact {
  /* 2.2 - Breadcrumb */
  .breadcrumb-shop {
    padding: 0;
    border-bottom: 1px solid #dfe2e6;
    border-top: 1px solid #dfe2e6;
    strong{
    font-weight: 400;
  }
  }
  .breadcrumb-paralax {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 0;
    margin-bottom: 40px;
    background-color: #fafafa;
  }
  .breadcrumb-list {
    & {
      overflow: hidden;
    }
    .breadcrumb-arrows {
      padding: 10px 0;
      background: transparent;
      border-radius: 0;
      margin: 0;
      list-style: none;
    }
    .breadcrumb-arrows > li {
      display: inline-block;
    }
    .breadcrumb-arrows > li + li:before {
      padding: 0 3px;
      margin-left: 5px;
      color: #ccc;
      font-family: 'FontAwesome';
      content: "/\00a0";
    }
    @media(max-width: 767px) {
      .breadcrumb-arrows {
        padding: 7px 0;
        font-size: 12px;
        display: block;
        white-space: nowrap;
        overflow: scroll;
      }
      .breadcrumb-arrows > li + li:before {
        padding: 0 2px;
      }
      .breadcrumb-arrows::-webkit-scrollbar {
        display: none;
      }
      .breadcrumb-arrows {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    }
  }

  .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    color: var(--color-contact-btn);
    background-color: var(--bg-contact-btn);
    border: none;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        opacity: 0.8;
      }

    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
  .sitebox-recaptcha {
    padding: 6px 0 0;
    text-align: left;
    font-size: 13px;
    clear: both;
  }
}
.loomline-contact-map {
  .map {
    display: flex;
    iframe {
      min-height: 590px;
    }
  }
  @media(max-width: 767px) {
    .map {
      iframe {
        min-height: 250px;
      }
    }
  }
}
.loomline-contact-info {
  padding: 80px 0;

  .row-bg {
    border-radius: 20px;
    overflow: hidden;
    background: $bgForm;
    color: $colorForm;

  }
  .form {
    a {
      color: $colorForm;
    }
    .contact-form .input-group {
      position: relative;
      margin-bottom: 30px;
      &.group-text {
        margin-bottom: 0;
      }
      .icon-form {
        position: absolute;
        top: 10px;
        left: 0;
        z-index: 1;
        svg {
          fill: currentcolor;
          opacity: 0.6;
        }
      }
      .line {
         &:before {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          width: 0;
          height: 1px;
          background: currentcolor;
          transition: all 0.3s;
        }
      }
      input,
      textarea {
        background: #fff;
        border: none;
        padding: 12px 20px;
        box-shadow: none;
        color: #333;
        &::-webkit-input-placeholder {
          color: #333 !important;
        }
        &::-moz-placeholder {
          color: #333 !important;
        }
         &:-moz-placeholder {
          color: #333 !important;
        }
      }
      input {
        height: 50px;
        border-radius: 30px;
      }
      textarea {
        height: 180px;
        border-radius: 15px;
      }
      input[type="checkbox"] {
        width: 18px;
        height: 24px;
        flex: 0 0 18px;
        appearance: checkbox;
        -webkit-appearance: checkbox;
        margin-right: 10px;
      }
      label {
        margin-bottom: 10px;
        flex: 0 0 calc(100% - 30px);
        
      }
       &:not(.error) {
        input,
        textarea {
           &:focus {
             + .line:before {
              width: 100%;
            }
          }
        }
         &:hover {
          .line:before {
            width: 100%;
          }
        }
      }

    }
    .cta-submitform {
      margin-top: 30px;
      .icon {
        margin-right: 10px;
        svg {
          fill: var(--color-contact-btn);
        }
      }

    }
  }
  @media(min-width: 1200px) {
    .form {
      padding: 0 50px;
      .heading-title {
        .title2 {
          font-size: 48px;
        }
      }
    }
  }
  @media(min-width: 768px) {
    .heading-title {
      .title2 {
        font-size: 28px;
      }
    }
  }
  @media(max-width: 991px){
    .row-bg{
      gap: 30px;
      padding-bottom: 40px;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .row-bg{
      margin: 0;
      border-radius: 10px;
    }
    .list-info {
      .info {
         &:not(:last-child) {
          margin-bottom: 20px;
        }
        li {
          font-size: 14px;
        }
        &.info-phone {
          a {
            font-size: 18px;
          }
        }
      }
    }
    .form {
      margin-top: 30px;
      .contact-form .input-group {
        margin-bottom: 15px;
        input,
        textarea {
          font-size: 14px;
        }
      }
      .btn-form {
        text-align: center;
      }
    }

  }
}
.loomline-contact-banner {
  padding: 0;
  position: relative;
  overflow: hidden;
  .banner-img {
    img {
      transition: all 0.5s;
    }
  }
  .info-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 50px 40px;
    color: $colorBanner;
    z-index: 2;
    .title {
      font-size: 40px;
      font-weight: 600;
      margin-bottom: 20px;
    }
    .address,
    .phone,
    .time {
      font-size: 20px;
      margin-bottom: 10px;
    }
    .btn-more {
      margin-top: 40px;
        .button {
          background: $colorBanner;
          span {
            color: $colorBanner;
            filter: invert(1);
          }
      }
    }
  }
   &:hover {
    .banner-img img {
      transform: scale(1.08);
    }
  }
  @media(max-width: 767px){
  .info-content {
    padding: 30px 20px;
    .title {
      font-size: 30px;
      margin-bottom: 10px;
    }
    .address,
    .phone,
    .time {
      font-size: 16px;
      margin-bottom: 5px;
    }
    .btn-more {
      margin-top: 20px;
    }
  }
  }
}