$colorText: {{ settings.shop_text_color }};
.loomline-index-tiktok {
  padding: 80px 0 40px;
  border-top: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
  .list-banner{
    gap: 15px;
    justify-content: center;
    >div{
      flex: 0 0 auto;
      width: calc(100%/5 - 12px);
    }
  }
  .banner-item {
    .banner-box {
      &.has-video {
        display: flex;
        .video-box {
          display: inline-flex;
          video {
            width: 100%;
            border-radius: 10px;
          }
        }
      }
      .img-box {
        border-radius: 10px;
        overflow: hidden;
        img {
          transition: all 0.5s;
        }
      }
    }
    .banner-content {
      position: absolute;
      bottom: 40px;
      left: 20px;
      width: calc(100% - 40px);
      .title {
        font-size: 24px;
      }
    }
     &:hover {
      .banner-box .img-box img {
        transform: scale(1.08);
      }
    }
  }
  .btn-heading {
    margin-bottom: 60px;
  }
  @media(min-width: 992px) {
    .list-banner {
      display: flex;
    }
    .heading-title {
      margin-bottom: 40px;
    }
    .swiper-nav{
      display: none;
    }
  }
  @media(max-width: 991px) {
    .slide-swiper{
      position: relative;
      &:not(.swiper-initialized){
        .list-banner{
          display: flex;
          flex-flow: nowrap;
          >div{
          flex: 0 0 80%;
            margin-right: 8px;
        }
        } 
      }
      .swiper-nav{
      position: absolute;top: calc(50% - 20px); z-index: 3;
		width: 40px; height: 40px; line-height: 38px;  font-size: 14px; border-radius: 50%;
		color: #858380;background: #fff;border: 1px solid var(--shop-color-border); outline: none;
		-webkit-box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
		-webkit-transition: all 0.4s;-ms-transition: all 0.4s; transition: all 0.4s;	
                display: flex;
        align-items: center;
        justify-content: center;
        &.swiper-next{
          right: 0;
        }
      }
    }
    .list-banner {
      gap: 0;
      justify-content: start;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-banner {
      margin: 0;
    }
    .btn-heading {
      margin-bottom: 40px;
    }
    .banner-item {
      .banner-content {
        bottom: 30px;
        .title {
          font-size: 20px;
        }
      }
      .btn-more {
        margin-top: 20px;
      }
    }
  }
}

.iframe-tiktok{
  flex: 0 0 auto;
  width: calc(100%/4);
  iframe{
    aspect-ratio: 9/16;
  }
}
