$bgMain: {{ settings.shop_color_bg | default: '#ffffff' }};
$colorText: {{ settings.shop_text_color }};
$bgFaqs: {{ settings.loomline_index_faqs_bg_color }};
$colorFaqs: {{ settings.loomline_index_faqs_color }};
.loomline-index-faqs {
  padding: 40px 0;
  background: $bgFaqs;
  color: $colorFaqs;
  .list-faqs {
    .faq-item {
      border: 1px solid color-mix(in srgb, {{ settings.loomline_index_faqs_color }} 10%, transparent);
      border-radius: 20px;
      transition: all 0.3s;
       &:not(:last-child) {
        margin-bottom: 15px;
      }
      .header-faqs {
        font-weight: 600;
        padding: 20px 40px 20px 20px;
        position: relative;
        cursor: pointer;
         &:before {
          content: '';
          position: absolute;
          top: calc(50% - 10px);
          right: 20px;
          width: 20px;
          height: 20px;
          background: $colorFaqs;
          -webkit-mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cpath id='primary' d='M5, 12H19M12, 5V19' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/path%3E%3C/svg%3E") center / contain;
          mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cpath id='primary' d='M5, 12H19M12, 5V19' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/path%3E%3C/svg%3E") center / contain;
          mask-repeat: no-repeat;
          transition: all 0.3s;
        }
      }
      .content-faqs {
        display: none;
        padding: 0 20px 20px;
        .desc {
          border-top: 1px solid color-mix(in srgb, {{ settings.loomline_index_faqs_color }} 10%, transparent);
          padding-top: 15px;
        }
      }
      &.opened {
        background: $bgMain;
        color: $colorText;
        .header-faqs:before {
          background: $colorText;
          -webkit-mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cline id='primary' x1='19' y1='12' x2='5' y2='12' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/line%3E%3C/svg%3E") center / contain;
          mask: url("data:image/svg+xml, %3Csvg width='20px' height='20px' viewBox='0 0 24 24' data-name='Line Color' xmlns='http://www.w3.org/2000/svg' class='icon line-color'%3E%3Cline id='primary' x1='19' y1='12' x2='5' y2='12' style='fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;'%3E%3C/line%3E%3C/svg%3E") center / contain;
        }
        .content-faqs {
          .desc {
            border-color: color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
          }
        }
      }
    }
  }
  .banner-box {
    &.has-video {
      display: flex;
      .video-box {
        display: inline-flex;
        video {
          width: 100%;
          border-radius: 20px;
        }
      }
    }
  }
  .btn-more {
    margin-top: 40px;
    .button {
      background: $colorFaqs;
      span {
        color: $colorFaqs;
        filter: invert(1);
      }
    }
  }
  @media(min-width: 992px) {
    .heading-title {
      margin-bottom: 0;
    }
  }
  @media(max-width: 991px) {
    .row {
      gap: 0;
    }
    .heading-title {
      text-align: center;
    }
    .list-faqs{
      margin-top: 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0;
    .btn-more {
      margin-top: 30px;
    }
    .list-faqs .faq-item {
       &:not(:last-child) {
        margin-bottom: 8px;
      }
      .header-faqs {
        padding: 15px 40px 15px 15px;
         &:before {
          top: calc(50% - 8px);
          right: 15px;
          width: 16px;
          height: 16px;
        }
      }
      .content-faqs {
        padding: 0 15px 15px;
        .desc {
          padding-top: 12px;
        }
      }
    }
  }
}