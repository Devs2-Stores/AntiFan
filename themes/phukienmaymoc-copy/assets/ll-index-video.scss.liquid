$colorBg: {{ settings.shop_color_bg | default: '#ffffff' }};
$colorText: {{ settings.shop_text_color }};
@keyframes video_up {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.loomline-index-video {
  padding: 80px 0;
  .nav-tabs{
    border: none;
    .nav-item{
      .nav-link{ 
        background: transparent;
        border: none;
        border-left: 3px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
        border-radius: 0;
        color: color-mix(in srgb, {{ settings.shop_text_color }} 60%, transparent);
        padding: 20px;
        .title{
          font-size: 22px;
          transition: all 0.3s;
          margin: 0;
        }
        .desc{
          display: none;
          margin-top: 10px;
        }
        &.active{
          color: $colorText;
          border-color: $colorText;
          .desc{
            display: block;
          }
        }
        &:hover{
          .title{
            color: $colorText;
          }
        }
      }
    }
  }
  .video-content{
    position: sticky;
    top: 90px;
        z-index: 1;
  }
  .video-list {
    .tab-pane {
      .row {
        gap: 30px 0;
      }
    }
    .ani-video{
      transform: translateY(50px);
      opacity: 0;
      &.has-view {
        animation: video_up 1s forwards var(--time) ease-out;
      }
    }
    .video-item {
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      //transform: translateY(50px);
      //opacity: 0;
      &.has-view {
        animation: video_up 1s forwards var(--time) ease-out;
      }
      .item-banner {
        overflow: hidden;
        &.has-video {
          display: flex;
        }
        .video-box {
          display: inline-flex;
          video {
            width: 100%;
          }
        }
        .img-box {
          img {
            transition: all 0.5s;
          }
        }
         &:hover {
          .img-box {
            img {
              transform: scale(1.08);
            }
          }
        }
      }
      .item-pro {
        position: absolute;
        bottom: 15px;
        left: 15px;
        width: calc(100% - 30px);
        z-index: 1;
        .pro-item-video {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          padding: 10px;
          border-radius: 10px;
          color: #000;
          background: #fff;
          > div {
            flex: 0 0 auto;
          }
          .pro-img {
            width: 65px;
            img {
              border-radius: 8px;
            }
          }
          .pro-btn {
            width: 48px;
            svg {
              width: 20px;
              height: 20px;
            }
            button {
              width: 48px;
              height: 48px;
              border: none;
              outline: none;
              background: rgba(0, 0, 0, 0.1);
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
            }
          }
          .pro-detail {
            width: calc(100% - 130px);
            .title {
              white-space: initial;
              overflow: hidden;
              -webkit-line-clamp: 1;
              -webkit-box-orient: vertical;
              display: -webkit-box;
              color: #000;
            }
            .pro-price{
              .price{
                color: #d63a2f;
              }
              .price-del{
                color: #666;
              }
            }
          }
        }
      }
    }

  }
  .heading-mb,.desc-mb{
    display: none;
  }
  .tab-mb{
      &.opened{
       .nav-tabs{
         opacity: 1;
         visibility: visible;
       } 
      }
    }
  @media(min-width: 992px) {
    .video-list {
      .video-item {
      height: calc(100% - 100px);
      .item-banner {
        .video-box {
              position: absolute;
    top: 0;
    left: 0;
        }
      }
    }
      .tab-pane {
        .row {
          > div {
             &:nth-child(2) {
              .video-item {
                margin-top: 100px;
              }
            }
             &:nth-child(3) {
              .video-item {
                margin-top: -100px;
              }
            }
          }
        }

      }
    }
  }
  @media(max-width: 991px){
    .heading-title{
      text-align: center;
    }
    .desc-mb{
    display: block;
      margin: 25px 0;
      text-align: center;
  }
    .video-list {
      .tab-pane .row{
      flex-flow: nowrap;
      overflow-x: scroll;
        overflow-y: hidden;
      gap: 0;
    }
      .ani-video{
        padding: 0 0 0 15px;
      }
      .video-item{
        border-radius: 10px;
        .item-banner {
          border-radius: 10px;
        }
        .item-pro {
          position: unset;
          padding: 15px 0;
          width: 100%;
          .pro-item-video {
            padding: 0;
          .pro-img{
              width: 45px;
          }
          .pro-detail{
            width: calc(100% - 100px);
          }
          .pro-btn{
            width: 38px;
            button{
              width: 38px;
              height: 38px;
            }
          }
          }
        }
      }
    }
    
    .nav-tabs{
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: $colorBg;
      border: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
      flex-flow: column;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s;
    .nav-item{
      .nav-link{ 
        border-left: none;
        color: $colorText;
        padding: 10px 20px;
        .title{
          font-size: 14px;
          font-weight: 400;
        }
        .desc{
          display: none;
        }
        &.active{
          color: $colorText;
          background: color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
          .desc{
            display: none;
          }
        }
      }
    }
  }
    
    .heading-mb{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 10px 20px;
      border: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
      border-radius: 50px;
      .title-mb{
        font-size: 16px;
        flex: 0 0 auto;
        width: calc(100% - 40px);
      }
      .icon{
        svg{
          fill: currentcolor;
          transition: all 0.3s;
        }
      }
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
  }
}