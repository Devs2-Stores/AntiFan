$colorText: {{ settings.shop_text_color }};
$bgAbout: {{ settings.loomline_index_about_bg_color }};
$colorAbout: {{ settings.loomline_index_about_color }};
.loomline-index-about {

  .about-group {
    background: $bgAbout;
    color: $colorAbout;
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    > div {
      padding: 0;
    }
  }
  .about-content {
    padding: 30px;
  }
  .about-banner {
    &.has-video{
      display: flex;
    }
    .img-box {
      overflow: hidden;
      img {
        transition: all 0.5s;
      }
       &:hover {
        img {
          transform: scale(1.08);
        }
      }
    }
    .video-box{
      display: inline-flex;
      video{
        width: 100%;
      }
    }
  }
  .btn-more {
    margin: 30px 0 0;
    .button {
      background: $colorAbout;
      span {
        color: $colorAbout;
        filter: invert(1);
      }
    }
  }
  @media(min-width: 1200px) {
    .heading-title {
      .title2 {
        font-size: 45px;
      }
    }
    .about-content {
      padding: 30px 80px;
    }
  }
  @media(max-width: 991px){
    .about-group{
      border-radius: 10px;
      flex-flow: column-reverse;
    }
  }
}