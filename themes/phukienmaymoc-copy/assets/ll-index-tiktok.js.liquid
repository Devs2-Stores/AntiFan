Loomline.TiktokSlide = {
		init: function() {
			var that = this;
      that.Loomline_TiktokSlide('loomline-index-tiktok');
		},
  Loomline_TiktokSlide: function(id){
    $('.' + id + ' .slide-swiper').addClass('swiper');
    $('.' + id + ' .list-banner').addClass('swiper-wrapper');
    setTimeout(function() {
			const tiktokSlider = new Swiper ('.' + id + ' .swiper', {
      slidesPerView: 1.5,  
      spaceBetween: 10,
			loop: $('.' + id +  ' .item-col').length > 1 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      //centeredSlides: true,
      autoplay: false,
      /*autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },*/
			navigation: {
				nextEl: '.' + id + ' .swiper-next',
				prevEl: '.' + id + ' .swiper-prev',
			}
    });
    const totalSlides = tiktokSlider.slides.length;
    if (totalSlides <= tiktokSlider.params.slidesPerView) {
      $('.' + id + ' .swiper-next, .' + id + ' .swiper-prev').hide();
    }
		}, 500);
    
  }
};
(function() {
  if($(window).width() < 992){
    Loomline.TiktokSlide.init();
  }
  $(window).resize(function() {
    if($(window).width() < 992){
      Loomline.TiktokSlide.init();
    }
  })
  
})();






