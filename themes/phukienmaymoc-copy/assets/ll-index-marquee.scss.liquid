:root {
  --ll-index-time: {{ settings.loomline_index_marquee_time }}s;
}
$colorText: {{ settings.shop_text_color }};
@keyframes index-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
.loomline-index-marquee {
  padding: 40px 0;
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    padding: 20px 0;
    border-top: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 30%, transparent);
    border-bottom: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 30%, transparent);
    &__inner {
      display: inline-flex;
      gap: 50px;
      animation: index-marquee var(--ll-index-time) linear infinite;
      &--item {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 50px;
        font-size: 28px;
        line-height: 1;
        .img {
          display: inline-block;
          overflow: hidden;
          border-radius: 60px;
          img {
            max-height: 80px;
            border-radius: 60px;
            transition: all 0.3s;
          }
           &:hover {
            img {
              transform: scale(1.08);
            }
          }
        }

        .title {
          flex: 0 0 auto;
        }
      }
    }
  }
  .marquee:hover .marquee__inner {
    animation-play-state: paused;
  }

  @media(max-width: 991px) {
    .marquee__inner--item {
      font-size: 22px;
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0;
    .marquee {
      padding: 12px 0;
      &__inner {
        gap: 30px;
        &--item {
          gap: 30px;
          font-size: 18px;
          .img {
            img {
              max-height: 50px;
            }
          }
        }
      }
    }
  }
}