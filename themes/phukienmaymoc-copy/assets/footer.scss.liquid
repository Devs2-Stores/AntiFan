$bgFt: {{ settings.loomline_footer_bg_color }};
$colorFt: {{ settings.loomline_footer_color }};

.loomline-mainFooter {
  background-color: $bgFt;
  color: $colorFt;
  padding-top: 80px;
  a {
    color: $colorFt;
  }
  h2 a {
    color: $colorFt;
  }
  .loomline-ft-logo {
    img {
      max-height: 60px;
      margin-bottom: 20px;
    }
  }
  .loomline-widget-footer {
    .loomline-title-footer,
    .loomline-fter-title {
      position: relative;
      margin-bottom: 28px;
      font-weight: 600;
      color: $colorFt;
      font-size: 20px;
      letter-spacing: 1px;
      @media(max-width: 991px) {
        border-bottom: 1px dashed color-mix(in srgb, {{ settings.loomline_footer_color }} 30%, transparent);
        margin: 0;
        padding: 15px 0;
         &:not(.loomline-fter-title):before {
          content: "\f107";
          font-family: "FontAwesome";
          position: absolute;
          top: 12px;
          right: 10px;
          text-align: center;
          font-size: 22px;
          transition: all 0.4s ease-in-out 0s;
          -moz-transition: all 0.4s ease-in-out 0s;
          -o-transition: all 0.4s ease-in-out 0s;
          -webkit-transition: all 0.4s ease-in-out 0s;
          -ms-transition: all 0.4s ease-in-out 0s;
        }
        &.opened {
          font-weight: 700;
        }
         &.opened:before {
          -moz-transform: rotate(-180deg);
          -webkit-transform: rotate(-180deg);
          -o-transform: rotate(-180deg);
          -ms-transform: rotate(-180deg);
          transform: rotate(-180deg);
        }
      }
      @media(max-width: 767px) {
        font-size: 15px;
      }
    }
    .desc {
      margin: 0;
    }
    .desc-newsletter {
      margin-bottom: 20px;
    }
  }
  .loomline-newsletter{
    .loomline-title-footer{
      font-size: 30px;
    }
  }
  .loomline-footer-newsletter {
    .loomline-newsletter-form {
      .loomline-newsletter-input {
        background: color-mix(in srgb, {{ settings.loomline_footer_color }} 10%, transparent);
        border: none;
        outline: none;
        border-radius: 0;
        color: $colorFt;
        &::-webkit-input-placeholder {
          color: $colorFt !important;
        }
        &::-moz-placeholder {
          color: $colorFt !important;
        }
         &:-moz-placeholder {
          color: $colorFt !important;
        }
      }
      .contact-form .input-group {
        flex-flow: nowrap;
        gap: 5px;
        input {
          font-size: 14px;
          padding: 12px 50px 12px 20px;
          height: 50px;
          background: color-mix(in srgb, {{ settings.loomline_footer_color }} 5%, transparent);
          border-radius: 30px;
        }
      }
      .btn-more .btn-icon {
        position: absolute;
        right: 0;
        background: none;
        border: none;
        outline: none;
        padding: 0 10px;
        width: 50px;
        height: 100%;
        display: flex;
        align-items: center;
         color: $colorFt;
        svg {
          fill: currentcolor;
        }
         &:hover {
          opacity: 0.8;
        }
      }
    }
  }
  .loomline-logo-footer {
    margin-top: 20px;
  }
  .loomline-footerNav-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    justify-content: end;
    gap: 8px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
  .loomline-payment{
    display: flex;
    flex-flow: wrap;
    align-items: center;
    justify-content: end;
    gap: 8px;
    margin-top: 20px;
    img{
      max-height: 24px;
    }
  }
  .loomline-address-footer {
    margin-bottom: 20px;
    li {
      margin-bottom: 10px;
      i {
        width: 20px;
      }
      &.address-phone {
        font-size: 22px;
        font-weight: 600;
      }
    }
  }
  .loomline-footer-link {
    li ~ li {
      margin-top: 15px;
    }
  }
  .loomline-footer-blog {
    .item {
       &:not(:last-child) {
        margin-bottom: 20px;
      }
    }
    .article-footer {
      display: flex;
      gap: 15px;
      .article-image {
        flex: 0 0 auto;
        width: 80px;
      }
      .post-title {
        font-size: 16px;
        margin-bottom: 5px;
      }
      .date {
        font-size: 14px;
        opacity: 0.8;
      }
    }
  }
  .loomline-footer-copyright {
    padding: 35px 0;
    p {
      margin: 0;
    }
  }
  @media(min-width: 992px) {
    .loomline-footer-newsletter {
      .loomline-newsletter-title h3 {
        margin: 0;
      }
      .loomline-newsletter-form {
        .contact-form .input-group {
          margin: 0;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &.has-toolbar {
      padding-bottom: 45px;
    }
    .loomline-widget-footer {
       &:last-child {
        .loomline-title-footer {
          border: none;
        }
        .loomline-content-footer {
          border-top: 1px dashed color-mix(in srgb, {{ settings.loomline_footer_color }} 30%, transparent);
        }
      }
      .loomline-block-collapse {
        display: none;
        padding: 15px 0;
      }
      .loomline-newsletter {
        margin-top: 0;
        .loomline-title-footer {
          border-top: 1px dashed rgba(42, 47, 65, 0.3);
        }
      }
    }
    .loomline-newsletter{
    .loomline-title-footer{
      font-size: 20px;
    }
  }
    .loomline-footer-newsletter {
      .loomline-newsletter-title h3 {
        font-size: 30px;
        margin-bottom: 20px;
      }
    }
    .loomline-footer-copyright {
      padding: 25px 0;
      text-align: center;
      > .row {
        gap: 15px;
      }
      .loomline-footer-link {
        justify-content: center;
      }
    }
    .loomline-footerNav-social,.loomline-payment{
      justify-content: center;
    }
  }
  @media(max-width: 767px) {
    padding-top: 40px;
    .loomline-footer-about .title {
      font-size: 26px;
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
    .loomline-newsletter{
    .loomline-title-footer{
      font-size: 15px;
    }
  }
  }
}