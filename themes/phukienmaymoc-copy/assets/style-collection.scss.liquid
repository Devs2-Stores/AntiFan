}

.col-banner {
	position: relative;
	&:before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgb(95, 93, 93) 100%);
	}
	.banner-detail {
		position: absolute;
		top: 0;
		text-align: center;
		width: 100%;
		height: 100%;
		display: flex;
		flex-flow: column;
		justify-content: center;
		align-items: center;
		.detail-title {
			font-size: 40px;
			color: #fff;
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}
	@media(max-width: 991px){
