.hidden{display: none !important;}

.collection-listproduct .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    color: var(--shop-color-button-text);
    background-color: var(--shop-color-button);
    border: 0;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
         opacity: 0.8;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
/* 2.2 - Breadcrumb */  
.breadcrumb-shop{
	padding: 0px;
	border-top: 1px solid #dfe2e6;
  border-bottom: 1px solid #dfe2e6;
}
.breadcrumb-paralax{
	position: relative;overflow: hidden;text-align: center;padding:0px 0;margin-bottom: 40px;
	background-color:#fafafa;
}
.breadcrumb-list{
	&{overflow: hidden;}
	.breadcrumb-arrows {padding:10px 0;background: transparent;border-radius: 0;margin: 0;list-style: none;}
	.breadcrumb-arrows>li{ display: inline-block;}
	.breadcrumb-arrows>li+li:before {	padding: 0 3px;margin-left:5px;color:#ccc;font-family: 'FontAwesome';content: "/\00a0";}
	@media(max-width:767px){
		.breadcrumb-arrows { padding:7px 0;font-size:12px;display: block;white-space: nowrap;overflow: scroll;}
		.breadcrumb-arrows>li+li:before {	padding: 0 2px;}
		.breadcrumb-arrows::-webkit-scrollbar {display: none;}
		.breadcrumb-arrows{-ms-overflow-style: none;scrollbar-width: none;}
	}
}
#btn-scroll{
	scroll-margin-block-start: 150px;
	@media(max-width: 767px){
		scroll-margin-block-start: 70px;
	}
}
.section-breadcrumb {
  position: relative;
  {% if settings.loomline_collection_bg_color != empty %}
  background: {{settings.loomline_collection_bg_color}};
  {% endif %}
  color: unquote("{{ settings.loomline_collection_color | default: '#000000' }}");
  a{
   color: unquote("{{ settings.loomline_collection_color | default: '#000000' }}"); 
  }
  h1 {
    font-size: 58px;
    margin-bottom: 25px;
  }
  .icon-down svg{fill: currentcolor;}
  .banner-content{
    padding: 90px 0;
    &.has-bg{
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
  @media(max-width: 767px) {
    h1 {
      font-size: 28px;
      margin-bottom: 15px;
    }
    .banner-content{
      padding: 60px 0;
    }
  }
}


/*===== COLLECTION ========================================*/
.layout-collections{
	padding-bottom: 30px;
}
.collection-alert-no{font-size:14px;padding:10px 0;}
.collection-alert-no p {margin:0;}
.collection-heading__banner {
	/*img:not(.lazyloaded) {min-height: 220px;}*/
	img{display: block;margin: auto;}
}
.collection-heading__content {
	h1 {margin:0;font-size:24px;}
	.heading-box {
		@media(max-width: 991px){
			width: 50%;
			.filter-box:not(.noBorder) {
				position: relative;
				height: 38px;
				line-height: 36px;
				width: 100%;
				font-size: 13px;
				font-weight: 600;
				padding: 0px 40px 0px 10px;
				cursor: pointer;
				border: 1px solid #eae4e8;
				border-right: 0;
				border-radius: 0;
			}
		}
		.title-filter {
			display: flex;
			-webkit-box-pack: center;
			justify-content: center;
			-webkit-box-align: center;
			align-items: center;
			cursor: pointer;
		}
		svg {
			width: 16px;
			height: 16px;
			stroke: var(--shop-color-text);
			margin-left: 5px;
		}
	}
	.heading-sortbyfilter {
		@media(max-width: 991px){
			width: 50%;
		}
	}
	.collection-filter-tags {
		margin: 0 0 20px;

		.layered_filter_tags .filter_tags {
			position: relative;
			border-radius: 12px;
			margin: 10px 10px 10px 0;
			color: #5d5d5d;
			background: #fff;
			border: 1px solid #dadada;
			font-size: 13px;
			display: none;
			padding: 2px 32px 2px 10px;
			/*&.opened ~ .filter_tags {
			margin-left: 10px;
		}*/
		}
		.layered_filter_tags .filter_tags.filter_tags_remove_all {
			cursor: pointer;
			border: 0;
			padding: 2px 10px;
		}
		.layered_filter_tags .filter_tags.filter_tags_remove_all span {
			color: var(--shop-color-main);
			border-bottom: 1px solid var(--shop-color-main);
		}
		.layered_filter_tags .filter_tags span.filter_tags_remove {
			position: absolute;
			right: 8px;
			top: 0;
			bottom: 0;
			margin: auto;
			width: 16px;
			height: 16px;
			cursor: pointer;
			display:flex;display:-ms-flex;
		}
		.layered_filter_tags .filter_tags.opened {
			display: inline-block;
		}
		.line-collection-content{
			display: none;
		}
		.heading-box-mb{
			&__count{
				.col-title {
					font-size: 22px;
					font-weight: 600;
					color: var(--shop-color-main);
				}
			}
		}
		@media(max-width: 991px){
			margin: 10px 0;
			.line-collection-content{
				display: block;
			}
			.heading-box-mb{
				width: 100%;
				display: flex;
				flex-flow: wrap;
				&__filter{
					order: 1;
					flex: 0 0 50%;
					position: relative;
					height: 38px;
					line-height: 36px;
					width: 100%;
					font-size: 13px;
					font-weight: 600;
					padding: 0px 40px 0px 10px;
					cursor: pointer;
					border: 1px solid #eae4e8;
					border-right: 0;
					border-radius: 0;
					background: #fff;
					.title-filter {
						margin: 0;
					}
				}
				&__sortby{
					order: 2;
					flex: 0 0 50%;
				}
				&__count{
					order: 3;
					flex: 0 0 100%;
					margin: 15px 0 10px;
				}
			}
		}
	}
	@media(min-width: 992px){
		.collection-filter-tags{
			display: flex;
			justify-content: space-between;
			flex-flow: row-reverse;
			gap: 15px;
		}
	}
}
