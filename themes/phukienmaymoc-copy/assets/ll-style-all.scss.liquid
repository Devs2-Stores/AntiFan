/* ==========================================================================
   GLOBAL RESPONSIVE & HORIZONTAL OVERFLOW GUARD (320px - 1440px)
   ========================================================================== */
html, body {
  max-width: 100vw !important;
  overflow-x: clip !important;
  position: relative !important;
}

.mainBody-theme-container,
.wrapperMain_content,
header.site-header {
  max-width: 100% !important;
  overflow-x: clip !important;
}

@media (max-width: 991px) {
  html, body {
    overflow-x: hidden !important;
  }
  .mainBody-theme-container,
  .wrapperMain_content,
  .site-header__bottom {
    max-width: 100% !important;
  }
  .site-header__bottom-content {
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .popup:not(.active),
  .popup-video:not(.active),
  .popup-login:not(.active),
  .popup-contact:not(.active) {
    display: none !important;
  }
  .popup-content__wrap {
    max-width: 100% !important;
    overflow: hidden !important;
  }
  .popup-content__wrap iframe {
    max-width: 100% !important;
  }
}
