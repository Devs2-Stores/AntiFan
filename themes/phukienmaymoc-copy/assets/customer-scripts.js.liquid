									text: "Phần thưởng đã được thêm vào mục Ưu đãi của bạn",
									button: false,
									timer: 1500,
								});
								$('#hrloyalty-panel-coupons .hrlyt-coupons-item:not(.clone)').remove();
								setTimeout(function() { 		HRLoyalty.getCouponsLoyalty(1); 		}, 300);
							},
							error: function(xhr) {
								var err = JSON.parse(xhr.responseText);
								var text_error = err.message_text;
								swal({
									icon: "error",
									className: "swal-loyalty-error",
									text:text_error,
									button: false,
									timer: 2500,
								});
							}
						});
					});
				});
			}, 450);
		});
		$(document).on('click','#mdlLoyalty-detail .mdlcards-block--body .cta-copy',function(e){
			e.preventDefault();
			$('#mdlLoyalty-detail .mdl-coupon--ctas .btn-modal-coupon').trigger('click');
		});
	},
	randomColorAvtLoyalty: function(){
		let currentColor = '#cccccc';
		const listColors = ['#bf360d', '#512da8', '#7b20a2', '#03897b', '#0088d2', '#679f38', '#455a64'];
		function getRandomColorExcept(previousColor) {
			const listColorsFiltered = listColors.filter(color => color !== previousColor)
			randomColor = listColorsFiltered[Math.floor(Math.random() * listColorsFiltered.length)]
			currentColor = randomColor
			return randomColor
		}
		if (document.getElementsByClassName("js-background").length > 0){
			const bodyElement = document.querySelector('.member-avartar .js-background');
			bodyElement.style.backgroundColor = getRandomColorExcept(currentColor);
		}
	}
};
$(document).ready(function() {  HRLoyalty.init(); });

