	getInfoProfile: function() {
		$.ajax({
			type: 'GET',
			url: '/apps/loyalty/me.json',
			async: false,
			success: function(result){
				if(result.message != 'success'){
					$(".sidebox-account--member,.sidebox-account .link-member").removeClass('js-visible');
				}
				else{
					shopOrgId = result.data.organization_id;
					userId = result.data.customer_profile_id;
					var current_rank = result.data.current_membership_level;
					var showRank = current_rank.toLowerCase();
					$('.membership-card').attr('data-rank', showRank);

					if(result.data.customer_fullname == undefined || result.data.customer_fullname == '' || result.data.customer_fullname == null){
						$(".membership-card .card-name").html('Membership Card');
					}else{
