	getCouponsLoyalty: function(page){
		var target = '#hrloyalty-panel-coupons';
		$.get('/apps/loyalty/coupons.json?customer_profile_id='+userId +'&org_id='+shopOrgId+'&page='+page+'&limit=6').done(function(result){
			if(result.message == 'success'){
				if(result.data.data.length > 0){
					/* Tính xem có phân trang không */
					if(result.data.total > result.data.limit){
						hrl_totalpage = Math.ceil(result.data.total / result.data.limit);
					}
					hrl_currentpage = ++page;

					$.each(result.data.data,function(ind,coupon){
						var item_coupon = $(target).find('.hrlyt-coupons-list .hrlyt-coupons-item.clone').clone();
						item_coupon.attr('data-couponid',coupon.id);
						if (coupon.image_url == null || coupon.image_url == '' ) {
							item_coupon.find('.coupons__img').html(hrlytCouponImg);	
						}
						else{
							item_coupon.find('.coupons__img').html('<img src="'+coupon.image_url+'" alt="'+ coupon.title+'">');	
						}
						item_coupon.find('.coupons__info .cpi-title').html(coupon.title);
						item_coupon.find('.coupons__info .cpi-name').html(coupon.discount.name);
						item_coupon.find('.coupons__info .cpi-code').html('Mã ưu đãi: <strong>' +coupon.code+'</strong>');
						item_coupon.find('.coupons__info .cpi-getcode').attr('data-couponcode',coupon.code);
						if(coupon.ended_at != null){
							let checkExpire = new Date(coupon.ended_at).getTime();
							let now = new Date().getTime();
							let end_day = coupon.ended_at.split(' ')[0].split('-');
							item_coupon.find('.cpi-time').html('HSD: '+end_day[2]+'/'+end_day[1]+'/'+end_day[0]);
							if(now > checkExpire) item_coupon.addClass('expired');
						}
						else{
							item_coupon.find('.cpi-time').html('Không thời hạn');
						}
						if(coupon.is_used != 0){
							item_coupon.addClass('is_used'); 
							item_coupon.find('.coupons__info .cpi-getcode').html('Đã sử dụng').addClass('disabled');
						}

						$(target).find('.hrlyt-coupons-list').append(item_coupon.removeClass('clone'));
						if(hrl_totalpage >= hrl_currentpage) $(target).find('.hrlyt-coupons-more').removeClass('d-none');
						else $(target).find('.hrlyt-coupons-more').addClass('d-none');
					});
				}
				else{
					$(target).find('.hrlyt-coupons-list').html("<div class='col-12 text-center hrlyt-coupons-item hrloyaltyt-empty '>Hiện tại bạn không có mã ưu đãi nào để sử dụng</div>");
				}
			}
			else{
				$(target).find('.hrlyt-coupons-list').html("<div class='col-12 text-center hrlyt-coupons-item hrloyaltyt-empty'>Hiện tại bạn không có mã ưu đãi nào để sử dụng</div>");
			}
		});
	},
