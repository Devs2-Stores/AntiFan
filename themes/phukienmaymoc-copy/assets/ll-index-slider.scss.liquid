$colorText: {{ settings.shop_text_color }};
$colorSlide: {{ settings.loomline_index_slider_color }};
@keyframes countingBar {
  0% {
    width: 0;
  }
  100% {
    width: 100%;
  }
}
@keyframes zoom_img {
  from {
    transform: scale(1.3);
  }
  to {
    transform: scale(1);
  }
}
@keyframes slide_content {
  from {
    transform: translateY(110%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes slide_btn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.loomline-index-slider {
  img {
    max-width: 100%;
    vertical-align: middle;
    border-style: none;
  }
  .slider-item {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    color: $colorSlide;
  }
  .slide--image {
    text-align: center;
    img{
      border-radius: 20px;
    }
  }
  .slide--content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    .content-box {
      width: 50%;
      padding: 30px;
      text-align: center;
    }
    .title1,
    .title2 {
      position: relative;
      overflow: hidden;
      .text-ani {
        display: inline-block;
        transform: translateY(110%);
        line-height: 1.2;
      }
    }
    .title1 {
      margin-bottom: 15px;
    }
    .title2 {
      font-size: 45px;
    }
    .btn-more {
      margin-top: 40px;
      .button {
        opacity: 0;
        background: $colorSlide;
        span {
          color: $colorSlide;
          filter: invert(1);
        }
      }
    }
    &.content-left {
      justify-content: start;
    }
    &.content-center {
      justify-content: center;
    }
    &.content-right {
      justify-content: end;
    }
  }
  .swiper {
    opacity: 0;
    transition: all 0.5s;
     &:not(.swiper-initialized) {
      .swiper-wrapper {
        display: flex;
        flex-flow: nowrap;
        justify-content: center;
        .slider-item {
          flex: 0 0 60%;
        }
      }
    }
    &.swiper-initialized {
      opacity: 1;
    }
    .swiper-slide {
      .slide--image {
        img {
          transition: all 1s;
          // opacity: 0;
          transform: scale(1);
        }
      }
      &.swiper-slide-active {
        .slide--image {
          img {
            // opacity: 1;
            // transform: scale(1);
            animation: zoom_img 1.2s forwards 0.1s ease-out;
          }
        }
        .slide--content {
          .title1,
          .title2 {
            .text-ani {
              animation: slide_content 0.5s forwards 0.8s ease-out;
            }
          }
          .btn-more {
            .button {
              animation: slide_btn 0.5s forwards 1s ease-out;
            }
          }
        }

      }
    }
    .swiper-nav {
      position: absolute;
      top: calc(50% - 23px);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      outline: none;
      color: $colorSlide;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      svg {
        width: 20px;
        height: 20px;
        fill: currentcolor;
        polyline,
        line {
          stroke: currentcolor;
        }
      }
      &.swiper-next {
        right: 15px;
      }
      &.swiper-prev {
        left: 15px;
      }
       &:hover {
        background: color-mix(in srgb, {{ settings.loomline_index_slider_color }} 20%, transparent);
      }
    }
    .swiper-pagination {
      position: unset;
      margin-top: 20px;
      .swiper-pagination-bullet {
        position: relative;
        overflow: hidden;
        width: 10px;
        height: 10px;
        text-align: left;
        border-radius: 10px;
        opacity: 1;
        background-color: color-mix(in srgb, {{ settings.shop_text_color }} 30%, transparent);
        margin: 0 5px;
        transition: all 0.3s;
         &:before {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: 2;
          width: 0;
          height: 100%;
          border-radius: 10px;
          background: $colorText;
        }
        &.swiper-pagination-bullet-active {
          width: 50px;
           &:before {
            animation-name: countingBar;
            animation-duration: 5s;
            // autopaly
            animation-timing-function: ease-in;
            animation-iteration-count: 1;
            animation-direction: alternate;
            animation-fill-mode: forwards;
          }
        }
      }
    }


  }
  @media(min-width: 768px){
    .index-slider{
      &.banner-full{
        padding: 0 20px;
      }
    }
  }
  @media(max-width: 1199px) {
    .slide--content {
      .content-box {
        padding: 20px;
      }
      .title2 {
        font-size: 32px;
      }
    }
  }
  @media(max-width: 767px) {
    .slider-item {
      border-radius: 10px;
      padding: 0 15px;
    }
    .slide--image {
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      img{
        border-radius: 10px;
      }
    }
    .slide--content {
      position: unset;
      .title2{
        font-size: 28px;
      }
      .content-box {
        width: 100%;
        padding: 20px 20px 0;
      }
      .btn-more {
        margin-top: 20px;
      }
    }
    .swiper {
      .swiper-nav {
        top: calc(50% - 20px);
        width: 40px;
        height: 40px;
        background: color-mix(in srgb, {{ settings.loomline_index_slider_color }} 20%, transparent);
        &.swiper-next {
          right: 5px;
        }
        &.swiper-prev {
          left: 5px;
        }
      }
    }
    .swiper-pagination {
      .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
      }
    }
  }
}

.hrv-pus-promotion:empty,
.section-home-pus-promotion:empty,
.hrv-pmo-discount:empty,
.hrv-pmo-coupon:empty,
.section-home-hrvpmo:empty {
  padding: 0;
}