document.addEventListener('DOMContentLoaded', function() {
  // ---------------------------------------------------------------------------
  // Slider engine (vanilla). One initializer serves #main-slide, #slide-1 and
  // #partner-slide. A slider whose items already fill the viewport (the hero)
  // is stretched to the viewport width and steps one slide at a time; a slider
  // whose items are narrower keeps its CSS geometry and steps one item at a
  // time, never scrolling past its last full view.
  // ---------------------------------------------------------------------------
  function initSlider(wrap) {
    if (!wrap) return;
    var sContent = wrap.querySelector('.s-content');
    if (!sContent) return;
    var items = sContent.querySelectorAll('.item');
    if (items.length <= 1) return;

    var total = items.length;
    var currentIndex = 0;
    // null until the first measurement; resolved before any inline width is written.
    var stretch = null;
    var autoplayDelay = wrap.getAttribute('data-autoplay') === '1' ? 5000 : 0;
    var maxIndex = total - 1;

    var dotsContainer = wrap.querySelector('.dots');
    if (!dotsContainer && wrap.getAttribute('data-dot') === '1') {
      dotsContainer = document.createElement('div');
      dotsContainer.className = 'dots';
      for (var dIdx = 0; dIdx < total; dIdx++) {
        var dEl = document.createElement('div');
        dEl.className = 'dot dot-' + dIdx + (dIdx === 0 ? ' active' : '');
        dotsContainer.appendChild(dEl);
      }
      wrap.appendChild(dotsContainer);
    }
    var dots = wrap.querySelectorAll('.dots .dot, .dots span, .slider-dots span');

    function measure() {
      var slideWidth = wrap.getBoundingClientRect().width || wrap.clientWidth;
      if (!slideWidth) return 0;
      if (stretch === null) {
        // A slider whose items already fill the viewport is a full-width slider
        // and is re-stretched on resize; one whose items are narrower keeps its
        // CSS geometry and slides one item at a time.
        var firstWidth = items[0].getBoundingClientRect().width;
        stretch = firstWidth > 0 && firstWidth >= slideWidth * 0.9;
      }
      var step = slideWidth;
      if (stretch) {
        sContent.style.width = (total * slideWidth) + 'px';
        items.forEach(function(item) {
          item.style.width = slideWidth + 'px';
          item.style.maxWidth = slideWidth + 'px';
          item.style.flex = '0 0 ' + slideWidth + 'px';
        });
      } else {
        var measured = items[1].getBoundingClientRect().left - items[0].getBoundingClientRect().left;
        if (measured > 0) step = measured;
      }
      var perView = Math.max(1, Math.round(slideWidth / step));
      maxIndex = Math.max(0, total - perView);
      return step;
    }

    function updateSlider(idx) {
      var step = measure();
      if (!step) return;
      if (idx < 0) idx = maxIndex;
      if (idx > maxIndex) idx = 0;
      currentIndex = idx;
      sContent.style.transform = 'translateX(-' + (currentIndex * step) + 'px)';
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === currentIndex);
      });
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function(e) {
        e.stopPropagation();
        updateSlider(i);
      });
    });

    items.forEach(function(item) {
      item.addEventListener('click', function() {
        var href = item.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });

    var navScope = wrap.parentNode || wrap;
    var prevArrow = navScope.querySelector('.nav-prev');
    var nextArrow = navScope.querySelector('.nav-next');
    if (prevArrow) {
      prevArrow.addEventListener('click', function() {
        updateSlider(currentIndex - 1);
      });
    }
    if (nextArrow) {
      nextArrow.addEventListener('click', function() {
        updateSlider(currentIndex + 1);
      });
    }

    window.addEventListener('resize', function() {
      updateSlider(currentIndex);
    });
    updateSlider(0);

    if (!autoplayDelay) return;

    var autoplayTimer = window.setInterval(function() {
      if (window.__antifanFreeze || window.__antifanPaused) return;
      updateSlider(currentIndex + 1);
    }, autoplayDelay);

    wrap.addEventListener('mouseenter', function() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    });
    wrap.addEventListener('mouseleave', function() {
      autoplayTimer = window.setInterval(function() {
        if (window.__antifanFreeze || window.__antifanPaused) return;
        updateSlider(currentIndex + 1);
      }, autoplayDelay);
    });
  }

  initSlider(document.querySelector('#main-slide'));
  initSlider(document.querySelector('#slide-1'));
  initSlider(document.querySelector('#partner-slide'));

  // Category navigation dropdown hover wiring
  var catNav = document.querySelector('section.slide .category-navigation');
  if (catNav) {
    var navList = catNav.querySelector('.category-navigation__list');
    var subContainer = catNav.querySelector('#category-navigation__sub');
    if (navList && subContainer) {
      var navLis = navList.querySelectorAll('ul > li');
      var subMenus = subContainer.querySelectorAll('.sub-menu');
      navLis.forEach(function(li, idx) {
        li.addEventListener('mouseenter', function() {
          subContainer.classList.add('active');
          subMenus.forEach(function(sm, sIdx) {
            sm.style.display = sIdx === idx ? 'block' : 'none';
          });
        });
      });
      catNav.addEventListener('mouseleave', function() {
        subContainer.classList.remove('active');
        subMenus.forEach(function(sm) {
          sm.style.display = 'none';
        });
      });
    }
  }

  // Accessory tab switching: [data-accessory-tab] on the tab item,
  // [data-accessory-panel] on the matching content block (string index values).
  (function initAccessoryTabs() {
    var tabs = document.querySelectorAll('[data-accessory-tab]');
    if (!tabs.length) return;
    var section = tabs[0].closest('section') || document;
    var panels = section.querySelectorAll('[data-accessory-panel]');

    function activate(index) {
      tabs.forEach(function(tab) {
        tab.classList.toggle('active', tab.getAttribute('data-accessory-tab') === index);
      });
      panels.forEach(function(panel) {
        panel.classList.toggle('active', panel.getAttribute('data-accessory-panel') === index);
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        activate(tab.getAttribute('data-accessory-tab'));
      });
    });

    var initialTab = section.querySelector('[data-accessory-tab].active') || tabs[0];
    if (initialTab) activate(initialTab.getAttribute('data-accessory-tab'));
  })();

  // Hero video popup: opens on [data-video-open], closes on [data-video-close],
  // on backdrop click and on Escape. The iframe source is set from data-src
  // only while the popup is open, so no video plays in the background.
  (function initVideoPopup() {
    var popup = document.querySelector('#popup-video[data-video-popup]');
    var triggers = document.querySelectorAll('[data-video-open]');
    if (!popup || !triggers.length) return;
    var frame = popup.querySelector('#popup-video-iframe') || popup.querySelector('iframe');
    var closers = popup.querySelectorAll('[data-video-close]');

    function openPopup() {
      if (frame) {
        var src = frame.getAttribute('data-src');
        if (src && !frame.getAttribute('src')) frame.setAttribute('src', src);
      }
      popup.classList.add('active');
    }

    function closePopup() {
      popup.classList.remove('active');
      if (frame && frame.getAttribute('data-src')) frame.removeAttribute('src');
    }

    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        openPopup();
      });
    });
    closers.forEach(function(closer) {
      closer.addEventListener('click', function(e) {
        e.preventDefault();
        closePopup();
      });
    });
    popup.addEventListener('click', function(e) {
      if (e.target === popup) closePopup();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && popup.classList.contains('active')) closePopup();
    });
  })();

  // Quote form product rows: rows cloned from #hl-home-quote-row into
  // [data-quote-rows] and serialized into [data-quote-body] on submit.
  (function initQuoteForm() {
    var root = document.querySelector('section.home-form [data-quote-rows]');
    if (!root) return;
    var form = root.closest('form');
    var template = document.getElementById('hl-home-quote-row');
    var addButton = root.querySelector('[data-quote-add]');
    if (!form || !template || !addButton) return;
    var bodyField = form.querySelector('[data-quote-body]');
    var submitButton = form.querySelector('button[type="submit"]');
    if (!bodyField || !submitButton) return;

    var MAX_ROWS = 10;

    function directRows() {
      var rows = [];
      for (var i = 0; i < root.children.length; i++) {
        var el = root.children[i];
        if (el.classList && el.classList.contains('flex')) rows.push(el);
      }
      return rows;
    }

    function syncAddButton() {
      addButton.style.display = directRows().length >= MAX_ROWS ? 'none' : '';
    }

    function addRow() {
      var rows = directRows();
      if (rows.length >= MAX_ROWS) return;
      var row = template.content.firstElementChild.cloneNode(true);
      root.insertBefore(row, addButton);
      syncAddButton();
      var firstInput = row.querySelector('input[name="product_name"]');
      if (firstInput) firstInput.focus();
    }

    function removeRow(trigger) {
      var row = trigger.closest('.flex');
      if (!row) return;
      row.parentNode.removeChild(row);
      syncAddButton();
    }

    function serializeRows() {
      var lines = [];
      directRows().forEach(function(row, index) {
        var name = row.querySelector('input[name="product_name"]');
        var quantity = row.querySelector('input[name="product_quantity"]');
        if (!name || !quantity) return;
        lines.push((index + 1) + '. ' + name.value.trim() + ' - SL: ' + quantity.value.trim());
      });
      return lines.join('\n');
    }

    addButton.addEventListener('click', addRow);
    addButton.addEventListener('keydown', function(event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        addRow();
      }
    });

    root.addEventListener('click', function(event) {
      var trigger = event.target.closest ? event.target.closest('.remove-row') : null;
      if (trigger) removeRow(trigger);
    });

    form.addEventListener('submit', function() {
      bodyField.value = serializeRows();
      submitButton.disabled = true;
    });

    window.addEventListener('pageshow', function() {
      submitButton.disabled = false;
    });

    syncAddButton();
  })();

  // ---------------------------------------------------------------------------
  // Global overlays rendered by layout/theme.liquid: the add-to-cart notice,
  // the alert toast and the loading box. The notice/toast are opt-in APIs for
  // other scripts; the loading box follows non-GET fetch/XHR traffic.
  // ---------------------------------------------------------------------------
  (function initOverlays() {
    var loadingBox = document.querySelector('.loading-box');
    var loadingCount = 0;
    var loadingSafety = null;

    function showLoading() {
      if (!loadingBox) return;
      loadingCount++;
      loadingBox.style.display = '';
      if (loadingSafety) window.clearTimeout(loadingSafety);
      loadingSafety = window.setTimeout(function() {
        loadingCount = 0;
        loadingBox.style.display = 'none';
      }, 20000);
    }

    function hideLoading() {
      if (!loadingBox) return;
      loadingCount = loadingCount > 0 ? loadingCount - 1 : 0;
      if (!loadingCount) {
        if (loadingSafety) window.clearTimeout(loadingSafety);
        loadingBox.style.display = 'none';
      }
    }

    window.HopLongLoading = { show: showLoading, hide: hideLoading };

    if (typeof window.fetch === 'function' && !window.__hopLongFetchHooked) {
      window.__hopLongFetchHooked = true;
      var nativeFetch = window.fetch;
      window.fetch = function(input, init) {
        var method = (init && init.method) || (input && input.method) || 'GET';
        var tracked = String(method).toUpperCase() !== 'GET';
        if (tracked) showLoading();
        var request = nativeFetch.apply(this, arguments);
        if (!tracked || !request || typeof request.then !== 'function') return request;
        return request.then(function(response) {
          hideLoading();
          return response;
        }, function(error) {
          hideLoading();
          throw error;
        });
      };
    }

    if (window.XMLHttpRequest && window.XMLHttpRequest.prototype && !window.__hopLongXhrHooked) {
      window.__hopLongXhrHooked = true;
      var xhrProto = window.XMLHttpRequest.prototype;
      var nativeOpen = xhrProto.open;
      var nativeSend = xhrProto.send;
      xhrProto.open = function(method) {
        this.__hopLongTracked = String(method).toUpperCase() !== 'GET';
        return nativeOpen.apply(this, arguments);
      };
      xhrProto.send = function() {
        var self = this;
        if (self.__hopLongTracked) {
          showLoading();
          self.addEventListener('loadend', function onLoadEnd() {
            self.removeEventListener('loadend', onLoadEnd);
            hideLoading();
          });
        }
        return nativeSend.apply(this, arguments);
      };
    }

    var noticeCart = document.querySelector('.notice-cart');
    var noticeName = noticeCart ? noticeCart.querySelector('.notice-cart__message .name') : null;
    var noticeTimer = null;

    function hideNotice() {
      if (!noticeCart) return;
      noticeCart.classList.remove('active');
      if (noticeTimer) window.clearTimeout(noticeTimer);
      noticeTimer = null;
    }

    if (noticeCart) {
      var noticeClose = noticeCart.querySelector('.notice-cart__message .close');
      if (noticeClose) noticeClose.addEventListener('click', hideNotice);
      var noticeLink = noticeCart.querySelector('.notice-cart__message a.button');
      if (noticeLink && noticeLink.getAttribute('href') === '/cart') {
        noticeLink.addEventListener('click', hideNotice);
      }
    }

    window.HopLongNotice = {
      show: function(message, options) {
        if (!noticeCart) return;
        var opts = options || {};
        if (noticeName && typeof message === 'string') noticeName.textContent = message;
        noticeCart.classList.add('active');
        if (noticeTimer) window.clearTimeout(noticeTimer);
        noticeTimer = window.setTimeout(hideNotice, opts.duration || 5000);
      },
      hide: hideNotice
    };

    var toastContainer = document.querySelector('#toast-container');
    var toastBox = toastContainer ? toastContainer.querySelector('.toast') : null;
    var toastMessage = toastContainer ? toastContainer.querySelector('.toast-message_content') : null;
    var toastTimer = null;

    function hideToast() {
      if (!toastContainer) return;
      toastContainer.classList.remove('active');
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = null;
    }

    if (toastContainer) {
      toastContainer.addEventListener('click', hideToast);
    }

    window.HopLongToast = {
      show: function(message, type) {
        if (!toastContainer || !toastBox) return;
        if (toastMessage) toastMessage.textContent = typeof message === 'string' ? message : '';
        toastBox.classList.remove('toast-success', 'toast-error');
        toastBox.classList.add(type === 'error' ? 'toast-error' : 'toast-success');
        toastContainer.classList.add('active');
        if (toastTimer) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(hideToast, 4000);
      },
      hide: hideToast
    };
  })();
});
