    $input.on('input', debounce(function() {
       var key = $(this).val(),
					$parent = $(this).parents('.loomline-wpo-wrapper-search'),
					$results = $(this).parents('.loomline-wpo-wrapper-search').find('.loomline-smart-search-wrapper');

			if(key.indexOf('script') > -1 || key.indexOf('>') > -1){
				alert('Từ khóa của bạn có chứa mã độc hại! Vui lòng nhập lại từ khóa khác');
				$(this).val('');
				$('.loomline-ultimate-search input[type="text"]').val('');
			}
			else{
				if(key.length > 0 ){
					$(this).attr('data-history', key);
					$('.loomline-ultimate-search input[type="text"]').val($(this).val());
					var q_follow = 'product',
							str = '';
					str = '/search?type=product&q=' + key + '&view=header-ultimate-product';
					$.ajax({
						url: str,
						type: 'GET',
						async: true,
						success: function(data){
							$results.find('.loomline-resultsContent').html(data);
						}
					})
					if(!$('.loomline-header-action_search').hasClass('loomline-js-action-show')){
						$('body').removeClass("locked-scroll");
						$('.loomline-header-action-item').removeClass('loomline-js-action-show');
					}
					$(".loomline-ultimate-search").addClass("expanded");
					$results.fadeIn();
				}
				else{
					$('.loomline-ultimate-search input[type="text"]').val($(this).val());
					$(".loomline-ultimate-search").removeClass("expanded");
					$results.fadeOut();
				}
			}
    }, 500));
		$('body').click(function(evt) {
			var target = evt.target;
			if (target.id !== 'loomline-ajaxSearchResults' && target.id !== 'loomline-inputSearchAuto') {
				$("#loomline-ajaxSearchResults").hide();
			}
			if (target.id !== 'loomline-ajaxSearchResults-mb' && target.id !== 'loomline-inputSearchAuto-mb') {
				$("#loomline-ajaxSearchResults-mb").hide();
			}
			if (target.id !== 'loomline-ajaxSearchResults-3' && target.id !== 'loomline-inputSearchAuto-3') {
				$("#loomline-ajaxSearchResults-3").hide();
			}
		});
		$('body').on('click', '.loomline-ultimate-search input[type="text"]', function() {
			if ($(this).is(":focus")) {
				if ($(this).val() != '') {
					$(".loomline-ajaxSearchResults").show();
				}
			} else {
			}
		})
		$('body').on('click', '.loomline-ultimate-search .search-close', function(e){
			e.preventDefault();
			$(".loomline-ajaxSearchResults").hide();
			$(".loomline-ultimate-search").removeClass("expanded");
			$(".loomline-ultimate-search").find('input[name=q]').val('');
		})
	},
};

(function() {
  Loomline.Search.init();
})();

