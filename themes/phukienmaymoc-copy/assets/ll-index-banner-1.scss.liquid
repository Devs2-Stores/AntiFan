$colorText: {{ settings.shop_text_color }};
.loomline-index-banner-1 {
  padding: 80px 0 40px;
  border-top: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
.swiper-slide {
      height: auto;
    }
  .banner-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-flow: wrap;
    margin-bottom: 40px;
    > div {
      flex: 0 0 auto;
    }
    .heading-title {
      margin-bottom: 0;
      width: calc(100% - 120px);
    }
    .heading-nav {
      display: inline-flex;
      gap: 10px;
      .swiper-nav {
        padding: 0;
        width: 48px;
        height: 48px;
        border: 1px solid color-mix(in srgb, {{ settings.shop_text_color }} 10%, transparent);
        border-radius: 50%;
        background: transparent;
        color: $colorText;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        svg {
          fill: currentcolor;
          width: 16px;
          height: 16px;
          transition: all 0.3s;
        }
         &:hover {
          background: currentcolor;
          svg {
            filter: invert(1);
          }
        }
      }
    }
  }
  .banner-item {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    height: 100%;
    a {
      color: var(--color);
    }
    .img-box {
      display: flex;
      img {
        transition: all 0.5s;
        border-radius: 20px;
      }
       &:not(.has-video) {
        width: 50%;
        margin-right: 50px;
        margin-left: auto;
      }
    }
    .video-box {
      display: inline-flex;
      video {


        /*
   aspect-ratio: 9 / 3.24;
   object-fit: cover;
   object-position: center center;
*/
        width: 100%;
        border-radius: 20px;
      }
    }
    .content-box {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      z-index: 1;
      .box-detail {
        padding: 30px 50px;
        width: 45%;
      }
      .title1 {
        margin-bottom: 20px;
      }
      .title2 {
        font-size: 36px;
        margin-bottom: 20px;
      }
      .btn-more {
        margin-top: 40px;
        .button {
          background: var(--color);
          span {
            color: var(--color);
            filter: invert(1);
          }
        }
      }
    }
     &:hover {
      .img-box img {
        transform: scale(1.08);
      }
    }
  }
  @media(min-width: 576px) {
    .banner-list {
      padding-left: calc((100% - 540px) / 2 + 15px);
    }
  }
  @media(min-width: 768px) {
    .banner-list {
      padding-left: calc((100% - 720px) / 2 + 15px);
    }
  }
  @media(min-width: 1200px) {
    .banner-list {
      padding-left: calc((100% - 1170px) / 2 + 20px);
    }
  }
  @media(min-width: 1366px) {
    .banner-list {
      padding-left: calc((100% - 1290px) / 2 + 20px);
    }
  }
  @media(min-width: 1600px) {
    .banner-list {
      padding-left: calc((100% - 1410px) / 2 + 20px);
    }
  }
  @media(min-width: 992px) {
    
    .banner-item {
      .video-box {
        position: absolute;
        top: 0;
        left: 0;
        video {
          object-fit: cover;
          object-position: center center;
        }
      }
    }
  }
  @media(max-width: 991px) {
    .banner-item {
      border-radius: 10px;
      height: 100%;
      a {
        height: 100%;
        display: flex;
        flex-flow: column;
        justify-content: space-between;
      }
      .img-box {
        img {
          border-radius: 10px;
        }
         &:not(.has-video) {
          width: 90%;
          margin: 0 auto;
        }
      }
      .video-box {
        video {
          aspect-ratio: auto;
          object-fit: contain;
          width: 100%;
          border-radius: 10px;
        }
      }
      .content-box {
        position: unset;
        height: auto;
        .box-detail {
          width: 100%;
          text-align: center;
        }
      }
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0;
    .banner-heading {
      margin-bottom: 20px;
      .heading-nav .swiper-nav {
        width: 40px;
        height: 40px;
      }
    }
    .banner-item {
      .content-box {
        .title1 {
          margin-bottom: 15px;
        }
        .title2 {
          font-size: 24px;
        }
        .btn-more {
          margin-top: 20px;
        }
        .box-detail {
          padding: 30px 30px 15px;
        }
      }
    }
  }
  @media(max-width: 575px) {
    .banner-list {
      padding: 0 15px;
    }
  }
}