    var qv_slider = $('#quickview-sliderproduct');
		var qv_thumbSlider = $('#quickview-thumbproduct');
		var qv_duration = 500;	
		qv_slider.owlCarousel({
			items:1,
			nav: true,
			dots: false,
			loop: false,	
			smartSpeed:1000,
      margin: 10,
      onInitialized: updateFraction,
    onChanged: updateFraction,
		})
    function updateFraction(event) {
      let current = event.item.index - event.relatedTarget._clones.length / 2 + 1;
      let total = event.item.count;
  
      if(current > total) current = 1;
      if(current <= 0) current = total;
  
      $('.quickview-fraction').text(current + ' / ' + total);
  }
		qv_thumbSlider.on('initialized.owl.carousel', function() {
			qv_thumbSlider.find(".owl-item").eq(0).addClass("current");
		})
		qv_slider.on('changed.owl.carousel', function (e) {
			qv_thumbSlider.trigger('to.owl.carousel', [e.item.index, qv_duration, true]);
			qv_thumbSlider.find(".owl-item").removeClass("current");
			qv_thumbSlider.find('.owl-item:nth-child('+ (e.item.index + 1) +')').addClass('current');
		});		
		qv_thumbSlider.owlCarousel({
			loop:false,	
			nav:false,dots:false,
			margin:10,
			center:false,
			responsive: {
				0: {
					items: 10,	
					margin:7,
				},
				768: {
					items: 6,
				},
				992: {
					items:6,
				},
				1200: {
					items: 6,
				}
			}
		})
		qv_thumbSlider.on('changed.owl.carousel', function (e) {
			qv_slider.trigger('to.owl.carousel', [e.item.index, qv_duration, true]);
			qv_slider.find(".owl-item").removeClass("current");
			qv_slider.find('.owl-item:nth-child('+ (e.item.index + 1) +')').addClass('current');
		});
		qv_thumbSlider.on("click", ".owl-item", function(e) {
			e.preventDefault();
			qv_thumbSlider.find(".owl-item").removeClass("current");
			$(this).addClass("current");
			var number = $(this).index();
			qv_slider.data('owl.carousel').to(number, qv_duration, true);
		});

  },
  Loomline_renderQuickview: function(url,id,title,preorder){
		jQuery.ajax({ 
			type: 'GET',
			url: url+(url.indexOf('?') > -1?'&':'?')+"view=ll-quickview",
			async: false,
			success:function(data){
				htmlQv = data;	
				if(preorder != undefined && preorder == true){
					$('#loomline-quick-view-modal').addClass('has-preorder');
				}else{
					$('#loomline-quick-view-modal').removeClass('has-preorder');
				}
				$('#loomline-quick-view-modal .loomline-wrapper-quickview').html(htmlQv);	
				//$('#loomline-quick-view-modal').modal("show");
        $('body').addClass('loomline-locked-scroll');
  			$('.loomline-header-action-item').removeClass('loomline-js-action-show');
  			$('.loomline-sidebar-main').addClass('loomline-is-show-right');
  			$('.loomline-sidebar-main .loomline-sitenav-quickview').addClass('loomline-show');
        
				setTimeout(function(){	
					Loomline.ProductLoop.Loomline_slideProdQuickview();	
					//Loomline.ProductLoop.Loomline_submitPreorderQv(url);
					if(htmlQvApp != '' && htmlQvApp != undefined){
						if(promotionApp_name != 'app_combo'){
							if($('#loomline-quick-view-modal .q-selector-buyxgety').hasClass('d-none') && htmlQvApp != '' && $('#loomline-quick-view-modal .q-selector-buyxgety .buyxgety_lists').html() == ''){
								$('#loomline-quick-view-modal .q-selector-buyxgety .buyxgety_lists').append(htmlQvApp);
								$('#loomline-quick-view-modal .q-selector-buyxgety').removeClass('d-none');
							}
						}
					}
				},800);	
				if(htmlQvApp != '' && htmlQvApp != undefined){
					if(promotionApp_name == 'app_combo'){
						if($('#loomline-quick-view-modal .combo-info').hasClass('d-none') && htmlQvApp != ''){
							$('#loomline-quick-view-modal .combo-info').append(htmlQvApp).removeClass('d-none');
						}
					}
				}	
			}
		});
	},
