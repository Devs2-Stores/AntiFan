  Loomline_addCartProdItem: function(id){
		var prolink = $('.loomline-product-loop[data-id="'+id+'"] .loomline-proloop-image .loomline-product-link').attr('href');	
		var proId = $('.loomline-product-loop[data-id="'+id+'"] .loomline-product-inner').attr('data-proid');
		var proTitle = $('.loomline-product-loop[data-id="'+id+'"] .loomline-proloop-detail h3 a').html();
		if (template.indexOf('page.landing-page-01') > -1) {
			prolink = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .loomline-proloop-image .loomline-product-link').attr('href');	
			proId = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .loomline-proloop-image').attr('data-proid');
			proTitle = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .loomline-proloop-detail h3 a').html();
		}
		if(promotionApp){
			if(!$('.loomline-product-loop[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none') && !$('.product-loop-ldpage .product-block[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none')){
				//	window.location.href = $('.loomline-product-loop[data-id="'+id+'"]').find('a').attr('href') || $('.prodloop-block[data-id="'+id+'"]').find('a').attr('href');
				Loomline.ProductLoop.Loomline_renderQuickview(prolink,proId,proTitle);	
				setTimeout(function() {$('.modal-product-quickview .product-promotion').show();},150);
			}
			else{
				var min_qty = 1;
				var variant_id = $(this).attr('data-variantid');
				var params = {
					type: 'POST',
					url: '/cart/add.js',
					async: true,
					data:'quantity=' + min_qty + '&id=' + id,
					dataType: 'json',
					success: function(line_item) {
						if (template.indexOf('cart') > -1) {
							window.location.reload();
						} else {
							var image = '';
							if(line_item['image'] == null){ 
								image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
							}
							else{
								image = Haravan.resizeImage(line_item['image'], 'small');
							}
							var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
							HRVTheme.General.notifyProduct($info);
							$('.loomline-product-actions[data-vrid="'+id+'"] .loomline-product-value').val(line_item.quantity);
							Loomline.Cart.Loomline_getCartModal(false);
						}
						$('.loomline-product-actions[data-vrid='+id+']').addClass('loomline-action-count');
					},
					error: function(XMLHttpRequest, textStatus) {
						Haravan.onError(XMLHttpRequest, textStatus);
					}
				};
				if($('.loomline-product-loop[data-id="'+id+'"] .loomline-add-to-cart').hasClass('loomline-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
					Loomline.ProductLoop.Loomline_renderQuickview(prolink,proId,proTitle)	
				}
				else{
					jQuery.ajax(params);
				}
			}
		} 
		else{
			var min_qty = 1;
			var variant_id = $(this).attr('data-variantid');
			$('.loomline-product-actions[data-vrid='+id+'] .loomline-btn-proloop-cart').addClass('loomline-btnload');
			var params = {
				type: 'POST',
				url: '/cart/add.js',
				async: true,
				data:'quantity=' + min_qty + '&id=' + id,
				dataType: 'json',
				success: function(line_item) {
					if (template.indexOf('cart') > -1) {
						window.location.reload();
					} else {
						var image = '';
						if(line_item['image'] == null){ 
							image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
						}
						else{
							image = Haravan.resizeImage(line_item['image'], 'small');
						}
						var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
						HRVTheme.General.notifyProduct($info);
						$('.loomline-product-actions[data-vrid="'+id+'"] .loomline-product-value').val(line_item.quantity);
						Loomline.Cart.Loomline_getCartModal(false);
					}

					setTimeout(function(){
						$('.loomline-product-actions[data-vrid='+id+']').addClass('action-count');
						$('.loomline-product-actions[data-vrid='+id+'] .btn-proloop-cart').removeClass('btnload');
					},400);
				},
				error: function(XMLHttpRequest, textStatus) {
					Haravan.onError(XMLHttpRequest, textStatus);
				}
			};
			if($('.loomline-product-loop[data-id="'+id+'"] .loomline-add-to-cart').hasClass('loomline-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
				Loomline.ProductLoop.Loomline_renderQuickview(prolink,proId,proTitle)	
			}
			else{
				jQuery.ajax(params);
			}
		}
	},
