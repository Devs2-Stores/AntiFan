$colorBanner: {{ settings.loomline_index_banner_2_color }};
.loomline-index-banner-2 {
  padding: 40px 0;
  .banner-item {
    position: relative;
    color: $colorBanner;
    .banner-box {
      &.has-video {
        display: flex;
        .video-box {
          display: inline-flex;
          video {
            width: 100%;
            border-radius: 20px;
          }
        }
      }
      .img-box {
        border-radius: 20px;
        overflow: hidden;
        img {
          transition: all 0.5s;
        }
      }
    }
    .banner-content {
      position: absolute;
      bottom: 40px;
      left: 20px;
      width: calc(100% - 40px);
      .title {
        font-size: 24px;
      }
    }
    .btn-more {
      margin-top: 30px;
      .button {
        background: $colorBanner;
        span {
          color: $colorBanner;
          filter: invert(1);
        }
      }
    }
     &:hover {
      .banner-box .img-box img {
        transform: scale(1.08);
      }
    }
  }
  .btn-heading {
    margin-bottom: 60px;
  }
  @media(min-width: 992px) {
    .heading-title {
      margin-bottom: 40px;
    }
    .banner-item {
    height: 100%;
    .banner-box {
      &.has-video {
        .video-box {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          video {
            object-fit: cover;
            object-position: center center;
          }
        }
      }
    }
  }
  }
  @media(max-width: 991px) {
    .list-banner {
      gap: 15px;
    }
  }
  @media(max-width: 767px) {
    padding: 20px 0;
    .btn-heading {
      margin-bottom: 40px;
    }
    .banner-item {
      .banner-content {
        bottom: 30px;
        .title {
          font-size: 20px;
        }
      }
      .btn-more {
        margin-top: 20px;
      }
    }
  }
}