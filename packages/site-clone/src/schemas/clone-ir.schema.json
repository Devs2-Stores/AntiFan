{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antifan.dev/schemas/v1/clone-ir.schema.json",
  "title": "AntiFan ComponentContractIR",
  "description": "Platform-agnostic intermediate representation contract for e-commerce storefront theme reconstruction",
  "type": "object",
  "required": [
    "version",
    "metadata",
    "layout",
    "themeSettings",
    "sections",
    "storefrontRuntime"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "metadata": {
      "type": "object",
      "required": ["sourceUrl", "extractedAt"],
      "properties": {
        "sourceUrl": { "type": "string" },
        "extractedAt": { "type": "string" },
        "engineVersion": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["containerMaxWidth", "containerPaddingPx", "gridGapPx", "breakpoints"],
      "properties": {
        "containerMaxWidth": { "type": "number", "minimum": 320 },
        "containerPaddingPx": { "type": "number", "minimum": 0 },
        "gridGapPx": { "type": "number", "minimum": 0 },
        "breakpoints": {
          "type": "object",
          "required": ["mobileMax", "tabletMin", "tabletMax", "desktopMin"],
          "properties": {
            "mobileMax": { "type": "number" },
            "tabletMin": { "type": "number" },
            "tabletMax": { "type": "number" },
            "desktopMin": { "type": "number" }
          }
        }
      }
    },
    "responsive": {
      "$ref": "#/definitions/ResponsiveBreakpointConfig"
    },
    "assets": {
      "$ref": "#/definitions/HarvestedAssetManifest"
    },
    "themeSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["color", "image_picker", "text", "textarea", "range", "font_picker", "link_list"] },
          "label": { "type": "string" },
          "default": {}
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "archetype", "layoutType", "blocks"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "archetype": {
            "type": "string",
            "enum": ["header", "hero_slider", "product_grid", "collection_list", "banner_grid", "rich_text", "footer", "custom_section"]
          },
          "layoutType": {
            "type": "string",
            "enum": ["grid", "flex", "scroll_snap_carousel", "column", "flow"]
          },
          "cssRules": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "settings": { "type": "object" },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "settings"],
              "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" },
                "limit": { "type": "number" },
                "settings": { "type": "object" },
                "dataBindings": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "storefrontRuntime": {
      "type": "object",
      "required": ["controllers"],
      "properties": {
        "controllers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "targetSelector", "triggerSelector", "behavior"],
            "properties": {
              "id": { "type": "string" },
              "sectionId": { "type": "string" },
              "roleId": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["carousel", "dropdown", "modal", "drawer", "tabs", "form_validation"]
              },
              "targetSelector": { "type": "string" },
              "triggerSelector": { "type": "string" },
              "behavior": {
                "type": "string",
                "enum": ["css_scroll_snap", "class_toggle", "dialog_native", "hover_intent"]
              }
            }
          }
        }
      }
    },
    "normalizedData": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": { "$ref": "#/definitions/NormalizedProduct" }
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/definitions/NormalizedCategory" }
        },
        "siteSettings": { "type": "object" }
      }
    }
  },
  "definitions": {
    "HarvestedAssetItem": {
      "type": "object",
      "required": ["type", "sourceUrl", "filename", "localPath"],
      "properties": {
        "type": { "type": "string", "enum": ["css", "js", "image", "font"] },
        "sourceUrl": { "type": "string" },
        "filename": { "type": "string" },
        "localPath": { "type": "string" },
        "byteCount": { "type": "number", "minimum": 0 }
      }
    },
    "HarvestedAssetManifest": {
      "type": "object",
      "required": ["stylesheets", "javascripts", "images", "fonts", "totalBytes"],
      "properties": {
        "stylesheets": {
          "type": "array",
          "items": { "$ref": "#/definitions/HarvestedAssetItem" }
        },
        "javascripts": {
          "type": "array",
          "items": { "$ref": "#/definitions/HarvestedAssetItem" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/definitions/HarvestedAssetItem" }
        },
        "fonts": {
          "type": "array",
          "items": { "$ref": "#/definitions/HarvestedAssetItem" }
        },
        "totalBytes": { "type": "number", "minimum": 0 }
      }
    },
    "ViewportDefinition": {
      "type": "object",
      "required": ["name", "width", "height", "deviceScaleFactor", "isMobile", "hasTouch", "mediaQuery"],
      "properties": {
        "name": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "deviceScaleFactor": { "type": "number" },
        "isMobile": { "type": "boolean" },
        "hasTouch": { "type": "boolean" },
        "mediaQuery": { "type": "string" }
      }
    },
    "ResponsiveBreakpointConfig": {
      "type": "object",
      "required": ["desktop", "tablet", "mobile"],
      "properties": {
        "desktop": { "$ref": "#/definitions/ViewportDefinition" },
        "tablet": { "$ref": "#/definitions/ViewportDefinition" },
        "mobile": { "$ref": "#/definitions/ViewportDefinition" }
      }
    },
    "NormalizedProduct": {
      "type": "object",
      "required": ["id", "title", "price"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "handle": { "type": "string" },
        "vendor": { "type": "string" },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "featuredImage": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "NormalizedCategory": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "handle": { "type": "string" },
        "icon": { "type": "string" },
        "url": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/NormalizedCategory" }
        }
      }
    }
  }
}
