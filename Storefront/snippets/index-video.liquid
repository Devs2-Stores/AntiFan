<section class="index-video section-distance">
	<div class="index-video-container {% unless settings.iv_fullwidth %} container{% endunless %}">
		<div class="iv-body">
			<a href="{{ settings.iv_link }}" title="{{ settings.iv_alt | escape }}">
				<video class="w-100" autoplay muted playinside loop poster="{{ 'iv_poster.png' | asset_url  }}" style="aspect-ratio: 1920/1080;">
					<source src="{{ settings.iv_media }}" type="video/mp4"/>
				</video>
			</a>
		</div>
	</div>
</section>