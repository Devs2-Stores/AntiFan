$gap-Unit: 1rem;
$white-text: #f2f2f2;
$black-text: #333;
$ipad-reponsive: 1000px;
$iphone-reponsive: 600px;
@mixin m1200($string: max) {
	@if $string == min{
		@media(min-width: 1201px){ @content; }
	}@else {
		@media(max-width: 1200px){ @content; }
	}
}
@mixin m1024($string: max) {
	@if $string == min{
		@media(min-width: 1025px){ @content; }
	}@else {
		@media(max-width: 1024px){ @content; }
	}
}
@mixin m0991($string: max) {
	@if $string == min{
		@media(min-width: 992px){ @content; }
	}@else {
		@media(max-width: 991px){ @content; }
	}
}
@mixin m0767($string: max) {
	@if $string == min{
		@media(min-width: 769px){ @content; }
	}@else {
		@media(max-width: 768px){ @content; }
	}
}
@mixin m0480($string: max) {
	@if $string == min{
		@media(min-width: 481px){ @content; }
	}@else {
		@media(max-width: 480px){ @content; }
	}
}
@mixin m0360($string: max) {
	@if $string == min{
		@media(min-width: 361px){ @content; }
	}@else {
		@media(max-width: 360px){ @content; }
	}
}
@mixin sectionPadding {
	padding: 25px 0;
	@include m0767{ padding: 12.5px 0; }
}
@mixin dFlex($flex: flex, $wrap: wrap, $justify: center, $align: center){
	display: $flex;
	flex-wrap: $wrap;
	justify-content: $justify;
	align-items: $align;
}
@mixin wrapText($numberLine){
	overflow: hidden;
	-webkit-line-clamp: $numberLine;
	-webkit-box-orient: vertical;
	display: -webkit-box;
}
@mixin fixMargin {
	@include m0767 { margin-left: -5px; margin-right: -5px; }
	@include m0767(min) { margin-left: -10px; margin-right: -10px; }
}
@mixin fixPadding {
	@include m0767{ padding-left: 5px; padding-right: 5px; }
	@include m0767(min) { padding-left: 10px; padding-right: 10px; }
}
@mixin resetButton{
	background: transparent;
	border: none;
	outline: none;
	padding: 0;
	box-shadow: none; 
}
.font-newstyle{ font-family: "Dancing Script", serif !important; }
.box-title{
	margin-bottom: 3rem;
	text-align: center;
	a{ 
		font-family: "Anton", sans-serif;
		text-transform: uppercase;
		font-size: 6rem;
		letter-spacing: 5px;
		transition: all 400ms; 
		display: inline-block; 
		color: var(--color2); 
		-webkit-text-stroke-color: var(--color1);
		text-shadow: -4.5px 4.5px 0px var(--color1);
		-webkit-text-stroke-width: 3px;
		@media(max-width: 1200px){ font-size: 4rem; }
		&:hover{ 
			color: var(--color_main); 
		}
	}
}

.titleStyle1 .title{ @extend .font-newstyle; }
.section-distance{
	margin-bottom: 6rem;
	@media(max-width: 640px){ margin-bottom: 3rem; }
}
.section-distance-top{
	margin-top: 3rem;
	@media(max-width: 640px){ margin-top: 1.5rem; }
}
.width_limitation{
	max-width:1920px;
	margin:auto;
}
.primary-horizontal-line{
	position: relative;
	height: 0.5px;
	width: 20%;
	min-width:160px;
	background-color: var(--color_main); 
	&:after{
		content: "";
		position: absolute;
		width: 20px;
		height: 20px;
		background-color: var(--color_main);
		left: 50%;
		top: 50%;
		transform: translate(-50%,-50%) rotate(45deg);
	}
} 
.secondary-horizontal-line{
	margin: 8px;
	height: 0.5px;
	width: 10%;
	min-width:160px;
	background-color: var(--color_main);
}
.primary-btn{
	background-color: var(--color_main);
	border: 2px solid transparent;
	padding: 3px 10px;
	font-size: 20px; 
	border-radius: var(--border_radius);
	@media(max-width:1000px){font-size: 15px;}
	color: #f2f2f2;
	transition: all 400ms;
	text-transform: uppercase;
	@extend .font-newstyle;
	p{
		margin: 0;
	}
	&:hover{
		letter-spacing: 1px;
		background-color: transparent;
		border-color: var(--color_main);
		color: var(--color_main);
	}
}
.secondary-btn{
	padding: 3px 10px;
	border: #f2f2f2 2px solid;
	font-size: 20px;
	border-radius: var(--border_radius);
	@media(max-width:1000px){font-size: 15px;}
	color: #f2f2f2;
	text-shadow: 0 3px 3px rgba(0,0,0,0.5);
	box-shadow: 0 3px 3px rgba(0,0,0,0.5);
	transition: all 400ms;
	text-transform: uppercase;
	@extend .font-newstyle;
	p{
		margin: 0;
	}
	&:hover{
		letter-spacing: 1px;
		color: var(--color_main);
		border-color:var(--color_main);
		text-shadow: none;
		box-shadow: none;
	}

}
.m-reset{margin:0};
.heading-style1{ @extend .box-title; }
.heading-style1-middle{
	@extend .box-title; 
	clip-path: polygon(20% 0, 80% 0%, 100% 100%, 0% 100%)
}

.activeSidebar{
	padding: 1rem 0 0;
	.activeSidebar-wrap{
		display: grid; grid-template-columns: 275px 1fr; align-items: stretch; gap: 1rem;
		> *{ min-width: 0; }
		.activeSidebar-left{
			ul{
				height: 100%;
				background: #F5F5F5;
				padding: 1rem;
				border-radius: var(--border_radius);
				> li{
					> a{
						display: flex; justify-content: space-between; align-items: center;
						padding: .75rem 0;
						font-size: 1.15rem;
					}
					> ul{ display: none; }
				}
			}
		}
	}
}
main{ max-width: 1920px; margin: 0 auto; }
.home-slider{
	background: #FFF;
	.slick-track{ padding: 0 !important; }
	.home-slider-items{
		.home-slider-item{
			position: relative;
			border-radius: var(--border_radius);
			overflow: hidden;
			img{ width: 100%; }
			.home-slider-item-content{
				position: absolute;
				top: 50%;
				left: 15px;
				transform: translateY(-50%);
				gap: 15px;
				@media (min-width: 1000px){ left: calc((100vw - 960px) / 2 + 15px); }
				@media (min-width: 1200px){ left: calc((100vw - 1140px) / 2 + 15px); }
				@media (min-width: 1300px){ left: calc((100vw - 1370px) / 2 + 15px); }
				@media (min-width: 1500px){ left: calc((100vw - 1440px) / 2 + 15px); }
				@media (min-width: 1700px){ left: calc((100vw - 1650px) / 2 + 15px); }
				@media (max-width:$ipad-reponsive){ display: none;  }
				max-width: 600px;
				height: fit-content;
				z-index: 2;
				width: 100%;
				padding: 0 15px;
				h2{ text-transform: uppercase; color: #FFF; font-size: 3rem; margin-bottom: 1rem; }
				p{ color: #FFF; margin-bottom: 1rem; }
				.home-slider-item-tags{
					gap: 10px 15px;
					@media (max-width:$ipad-reponsive){
						justify-content: center;
						align-items: center;
					}
				}
			}
		}
	}
}

@keyframes color-change {
	0% { color: var(--color_main); }
	50% { color: var(--color_main2); }
	100% { color: var(--color_main); }
}
.index-quote{
	.box-title{
		a{
			animation: color-change 2s infinite;
			@media(max-width: 640px){ font-size: 4rem; }
		}
	}
}

.home-vendor{
	.home-vendor-items{
		.slick-arrow, .slick-dots{ display: none !important; }
		.home-vendor-item{
			padding: 2rem;
			img{ max-width: 150px; max-height: 150px; }
		}
	}
}

.index_four_banner{
	.index_four_banner-items{
		display: grid; grid-template-columns: repeat(4, 1fr); > *{ min-width: 0; }
		border-radius: var(--border_radius); overflow: hidden;
		@include m0991{ grid-template-columns: repeat(2, 1fr); }
		.index_four_banner-item{
			position: relative;
			&:nth-child(1){
				grid-column: span 2; grid-row: span 2;  
				.index_four_banner-item-content{ 
					justify-content: flex-end; align-items: flex-start; align-content: flex-start;
					a{ margin-left: inherit !important; }
				}
			}
			&:nth-child(4){ 
				grid-column: span 2; 
				.index_four_banner-item-image{
					&:before{ transform: translateX(100%); left: inherit; right: 0; clip-path: polygon(40% 0%, 100% 0%, 100% 100%, 0% 100%); }
				}
				.index_four_banner-item-content{ 
					justify-content: flex-end; align-items: flex-end; align-content: flex-start;
					a{ margin-right: inherit !important; }
				}
			}
			&:hover{
				.index_four_banner-item-image{ 
					&:before{ opacity: 1; visibility: visible; transform: none; }
				}	
			}
			.index_four_banner-item-image{ 
				position: relative;
				overflow: hidden;
				&:before{ content: ""; clip-path: polygon(0 0, 60% 0, 100% 100%, 0% 100%); width: 50%; position: absolute; top: 0; left: 0; bottom: 0; background: rgba(0, 0, 0, .5); transform: translateX(-100%); opacity: 0; visibility: hidden; transition: all .5s; }
				&:after{ content: ""; position: absolute; inset: 0; background: rgba(0, 0, 0, .25); }
				img{ width: 100%; }
			}
			.index_four_banner-item-content{
				position: absolute;
				inset: 0;
				padding: 2rem;
				display: flex; flex-direction: column;
				justify-content: center; align-items: center;
				@media (max-width:$ipad-reponsive){ padding: .25rem 1rem .5rem; }
				h2{ 
					color: #FFF; font-size: 3rem; 
					@media (max-width:$ipad-reponsive){ font-size: 2rem; }
				}
				p{
					color: #FFF; font-size: 1.5rem; 
					@media (max-width:$ipad-reponsive){ font-size: 1rem; }
				}
				a{ width: auto !important; }
			}
		}
	}
}

.home-fsale{
	@include sectionPadding;
	.home-fsale-wrap{
		.home-fsale-cta{ 
			margin-left: auto;
			padding: 5px;
			width: 150px;
			display: block;
			max-width: 100%;
			color:  var(--color_main2);
			border: 1px solid var(--color_main);
			font-size: 13px;
			position: relative;
			text-align: center;
			line-height: 1.5;
			z-index: 1;
			&:after{
				content: "";
				display: block;
				width: 0;
				height: 100%;
				background-color:  var(--color_main);
				position: absolute;
				left: 50%;
				bottom: 0;
				transform: translateX(-50%);
				transition: 0.5s ease;
				z-index: -1;
			}
			&:hover{
				color:#ffffff;
				&:after{
					width: 100%;
				}
			}
			@include m0991{ width: 100%; text-align: center; margin-top: 20px; }
		}
		.home-fsale-head{
			background: var(--color_main2);
			text-align: center;
			padding: 25px 20px;
			position: relative;
			border-bottom: 1px solid #DbDbDb;
			.home-fsale-head-item{
				position: absolute;
				bottom: 15px;
				left: 52.5%;
				display: none;
				&.active{ display: block; }
				@include m0991 {
					position: relative;
					left: 0;
					bottom: 0;
				}
				label {
					font-weight: 400;
					color: #fff;
					font-size: 1rem;
					margin: 0;
					margin-right: 10px;
					text-transform: uppercase;
					text-align: left;
					width: 100%;
					margin-bottom: 5px;
					@include m1024 { text-align: center; }
				}
				.home-fsale-head-item-countdown{
					@include dFlex(flex, nowrap, end, end);
					@include m0991{ justify-content: center; }
					span {
						display: inline-flex;
						flex-direction: column;
						justify-content: center;
						align-content: center;
						text-align: center;
						align-items: center;
						color: #999;
						background: white;
						border-radius: 12px;
						width: 60px;
						height: 66px;
						text-align: center;
						font-size: 0.85rem;
						line-height: .8;
						box-shadow: 0 0 4px rgba(0, 0, 0, .4);
						&:not(:last-child){ margin-right: 15px; }
						@include m0360{
							width: 50px;
							height: 55px;
						}
						b{
							font-size: 1.75rem;
							font-weight: bold;
							display: block;
							margin-bottom: 5px;
							color: var(--color1);
						}
					}
				}
			}
		}
		.home-fsale-banner{
			.home-fsale-banner-item{
				position: relative;
				display: none;
				&.active{ display: block; }
			}
		}
		.home-fsale-tab{
			@include dFlex(flex, wrap, center, center);
			background: var(--color_main2);
			padding: 0 20px;
			@include m0991{ flex-wrap: nowrap; overflow: auto hidden; justify-content: flex-start; }
			.home-fsale-tab-item{
				flex: 1;
				background: var(--color_main2);
				color: #c3c3c3;
				padding: 20px 0 5px;
				text-align: center;
				cursor: pointer;
				white-space: nowrap;
				min-width: 200px;
				transition: all .5s linear;
				@include m1200{ min-width: 185px; }
				@include m1024{ min-width: 170px; }
				@include m0991{ min-width: 155px; }
				@include m0767{ min-width: 140px; }
				@include m0480{ min-width: 125px; }
				@include m0360{ min-width: 110px; }
				&.active{
					color: var(--color2);
				}
				strong{
					font-size: 1.75rem;
					display: block;
					line-height: 1;
					margin-bottom: 2.5px;
				}
				span{ 
					font-size: 1rem;
					line-height: 1;
				}
			}
		}
		.home-fsale-body{
			background: linear-gradient(to bottom, var(--color_main2), transparent);
			padding: 20px;
			.home-fsale-body-item{
				display: none;
				&.active{ display: block; }
				.home-fsale-body-item-data{
					&:not(.slick-slider){
						display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
						@media(max-width: 991px){ display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
						> *{ min-width: 0; }
						> .product-item:first-child{
							grid-column: span 2;
							grid-row: span 2;
						}
					}
					&.slick-slider{
						padding-bottom: 25px; margin: 0 -10px;
						.product-item{ padding: 0 10px; }
						.slick-dots{ bottom: 15px; }
					}
					.product-item{
						.product-item-wrap{ 
							background: #FFF; 
							.product-item-detail{ padding: 10px !important; }
						}
					}
				}
			}
		}
	}
}

.home-collections{
	.home-collections-flex{
		.home-collections-top{
			.home-collections-top-header{
				@extend .box-title;
			}
		}
		.home-collections-bottom{
			display: grid; grid-template-columns: repeat(8, 1fr);
			gap: 1rem;
			@include m1024{ grid-template-columns: repeat(6, 1fr); }
			@include m0767{ grid-template-columns: repeat(4, 1fr); }
			@include m0480{ grid-template-columns: repeat(2, 1fr); }
			> *{ min-width: 0; }
			.home-collections-item{
				&:first-child{
					background-color: var(--color_main);
					grid-column: span 2; grid-row: span 2; 
					img{ width: 300px; }
					.home-collections-item-display-text{ font-weight: bold; color: #FFF; text-transform: uppercase; text-shadow: 1px 1px 2px #F30; font-size: 1.5rem; } 
					&:hover{
						background-color: var(--color_main2);
					}
				}
				padding: 1rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				background-color: #f5f5f5;
				border-radius: var(--border_radius);
				transition: background-color 600ms;
				&:hover{
					background-color: var(--color_main);
					.home-collections-item-display-text{ color: #FFF; }
				}
				img{
					width: 100px;
					aspect-ratio: 1;
					margin-bottom: 15px;
					clip-path: polygon(50% 0%, 90% 20%, 100% 60%, 75% 100%, 25% 100%, 0% 60%, 10% 20%);
					box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.3);
					background: #FFF;
				}
				.home-collections-item-display-text{
					text-align: center;
					font-weight: bold;
					color: #222;
					white-space: nowrap;
					font-size: 1em;
				}
			}
		}
	}   
}

.home-banner-slider{
	.home-banner-slider-header{
		margin: 0;
		text-align: center;
		color: var(--color_main);
		font-style: italic;
		margin-bottom: 1rem;
		@extend .font-newstyle;
	}
	.home-banner-slider-extra-header{
		font-size: 40px;
		font-weight: bold;
		text-align: center;
		margin-bottom: 2rem;
		a{transition: color 400ms; color: $black-text;}
		&:hover{a{color: var(--color_main);}};
	}
	.forth_home .forth_home_content {
		padding: 100px 0;
		background-image: url("https://file.hstatic.net/1000405263/file/bg_forth_home.jpg");
		background-repeat: no-repeat;
		background-size: contain;
		background-position: center;
	}
	.forth_home .slick-track {
		display: flex;
		align-items: center;
	}
	.forth_home .forth_home_item {
		padding: 20px;
		position: relative;
	}
	.forth_home .forth_home_item:focus-visible {
		outline: unset;
	}
	.forth_home .forth_home_item .bg_images {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		max-width: 90%;
		aspect-ratio: 1/1;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0px 10px 20px 0px rgba(0, 0, 0, 0.1);
		display: flex;
		justify-content: center;
		align-items: center;
		overflow: hidden;
		opacity: 1;
		visibility: initial;
		transition: all 0.4s linear;
	}
	.forth_home .forth_home_item .bg_images img {
		width: -moz-fit-content;
		width: fit-content;
		max-width: 70%;
		height: auto;
		border-radius: 50%;
	}
	.forth_home .forth_home_item .detail_images {
		height: 100%;
		opacity: 0;
		visibility: hidden;
		transform: scale(0);
		transition: all 0.4s linear;
		border-radius: 40px;
		box-shadow: 0px 0px 4.084px 0px rgba(0, 0, 0, 0.25) inset;
		overflow: hidden;
		border: 10px solid #fff;
	}
	.forth_home .forth_home_item .detail_images img {
		width: 100%;
		height: 100%;
	}
	.forth_home .forth_home_item .detail_images:focus-visible {
		outline: unset;
	}
	.forth_home .forth_home_item.slick-active.slick-center .bg_images {
		opacity: 0;
		visibility: hidden;
	}
	.forth_home .forth_home_item.slick-active.slick-center .detail_images {
		transform: scale(1);
		visibility: inherit;
		opacity: 1;
	}

	.forth_home  .slick-slider .slick-dots {
		position: absolute;
		bottom: -15px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		z-index: 9; }
	.forth_home  .slick-slider .slick-dots li {
		position: relative;
		display: inline-block;
		width: 20px;
		height: 20px;
		margin: 0 5px;
		padding: 0;
		cursor: pointer;
		width: 64px;
		height: 4px;
		background: #e3ecf4;
		border-radius: 130px;
		transition: all 0.3s linear;
	}
	.forth_home  .slick-slider .slick-dots li.slick-active button {
	}
	.forth_home  .slick-slider .slick-dots li button {
		font-size: 0;
		line-height: 0;
		color: transparent;
		border: 0;
		outline: none;
		background: transparent;
		width: 100%;
		height: 100%;
		padding: 0;
	}
	.forth_home  .slick-slider .slick-dots li.slick-active {
		width: 4px;
		height: 4px;
		background: #8ea9f6;
		border-radius: 50%;
	}
}

.home-banner-full{
	&.home-banner-full-two{
		.home-banner-full-item{
			.home-banner-full-item-info{
				left: inherit; 
				right: 5%;
				@media(max-width:1000px){
					left: 50%; right: inherit;
				}
			}
		}
	}
	.home-banner-full-item{
		border-radius: var(--border_radius);
		overflow: hidden;
		position: relative;
		.home-banner-full-item-image{
			overflow: hidden;
			&:hover{
				img{ transform: scale(1.05); }
			}
			img{
				transition: ease-in-out .5s;
			}
			&:after{
				content: "";
				position: absolute;
				top: 50%;
				left: 50%;
				width: 100%;
				height: 100%;
				transform: translate(-50%,-50%);
				background-color: rgba(0, 0, 0, .05);
				z-index: 2;
				pointer-events: none;
				transition: background-color 600ms;
			}
		}
	}
